A\" style=\"width: 350px; height: 438px;\" width=\"350\" \/><\/div>\n<\/td>\n<\/tr>\n<tr>\n<td colspan=\"2\" style=\"text-align: center;\"><br \/>\nRemember,&nbsp;<strong>the players see each others&#39; cards<\/strong>.<br \/>\n&nbsp;<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">To what extent do you think Alex and AP-5 are responsible for their team losing the game? Please indicate the degree of their responsibility by selecting the appropriate choice below:<\/div>\n\n<div>&nbsp;<\/div>\n\n","DataExportTag":"CF-A0-F-BB-HPxTR-758","QuestionID":"QID76","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","QuestionDescription":"Evaluation Task \u00a0 Your task is to evaluate whether Alex and AP-5 have low, medium, or high respon...","Choices":{"1":{"Display":"Alex"},"2":{"Display":"AP-5"}},"ChoiceOrder":["1","2"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"Answers":{"1":{"Display":"Low Responsibility"},"2":{"Display":"Medium Responsibility"},"3":{"Display":"High Responsibility"}},"AnswerOrder":["1","2","3"],"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"NextChoiceId":3,"NextAnswerId":4,"ChoiceDataExportTags":false}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID760","SecondaryAttribute":"Evaluation Task Your task is to evaluate whether Alex and AP-5 have low, medium, or high responsi...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center; width: 875px;\"><u><strong>Evaluation Task<\/strong><\/u><\/div>\n\n<div style=\"text-align: justify; width: 875px;\"><br>\nYour task is to evaluate whether Alex and AP-5 have <strong><em>low<\/em><\/strong>, <em><s