M_nevKFfFnFG7mU81\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n<\/tr>\n<tr>\n<td colspan=\"3\">\n<div style=\"text-align: center;\"><br \/>\nRemember, while we can see all the cards,&nbsp;<strong>the players do not see each others&#39; cards<\/strong>.<\/div>\n\n<div style=\"text-align: center;\">&nbsp;<\/div>\n<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n\n<div style=\"text-align: left;\"><br \/>\n&nbsp;<\/div>\n<\/div>\n<\/div>\n\n<div style=\"text-align: justify; width: 960px;\">To what extent do you think Alex and AP-5 are responsible for their team losing the game? Please indicate the degree of their responsibility by selecting the appropriate choice below:<\/div>\n\n<div>&nbsp;<\/div>\n\n","DataExportTag":"2CF-PAR-B0-TRxCH-742","QuestionID":"QID624","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","QuestionDescription":"Evaluation Task \u00a0 Your task is to evaluate whether Alex and AP-5 have low, medium, or high respon...","Choices":{"1":{"Display":"Alex"},"2":{"Display":"AP-5"}},"ChoiceOrder":["1","2"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"Answers":{"1":{"Display":"Low Responsibility"},"2":{"Display":"Medium Responsibility"},"3":{"Display":"High Responsibility"}},"AnswerOrder":["1","2","3"],"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"NextChoiceId":3,"NextAnswerId":4,"ChoiceDataExportTags":false}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID625","SecondaryAttribute":"How confident are you in your response?","TertiaryAttribute":null,"Payload":{"QuestionText":"How confident are you in your response?\n","QuestionID":"QID625","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","QuestionDescription":"How confi