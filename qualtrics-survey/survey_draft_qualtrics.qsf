play":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID1"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID10","SecondaryAttribute":"Evaluation Task \u00a0 Your task is to evaluate whether Alex and AP-5 have low, medium, or high respon..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center; width: 875px;\"><u><strong>Evaluation Task<\/strong><\/u><\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">Your task is to evaluate whether Alex and AP-5 have <em><strong>low<\/strong><\/em>, <em><strong>medium<\/strong><\/em>, or <em><strong>high<\/strong><\/em> responsibility for their team losing the game.<\/div>\n\n<div>&nbsp;\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n<tbody>\n<tr>\n<td colspan=\"2\">\n<div style=\"text-align: justify;\">Consider the game in the left figure where Team A lost, and the counterfactual game in the right figure which shows what would have happened had Alex played <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">2<\/span><\/span><\/strong> in <strong>round #2<\/strong>. Once you understand what happened in the two games, <strong>please answer the question below<\/strong>.<\/div>\n<\/td>\n<\/tr>\n<tr>\n<td>\n<div style=\"text-align: center;\">Original game<\/div>\n\n<div style=\"text-align: center;\"><img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_WNjLc4lKdRALBlJ\" style=\"width: 350px; height: 438px;\" width=\"350\" \/>&nbsp;<\/div>\n<\/td>\n<td>\n<div style=\"text-align: center;\">Counterfactual game<\/div>\n\n<div style=\"text-align: center;\">&nbsp;&nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_RhOrdLh5yNWVw4z\" style=\"width: 350px; height: 438px;\" width=\"350\" \/><\/div>\n<\/td>\n<\/tr>\n<tr>\n<td colspan=\"2\" style=\"text-align: center;\"><br \/>\nRemember,&nbsp;<strong>the players see each others&#39; cards<\/strong>.<br \/>\n&nbsp;<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">To what extent do you think Alex and AP-5 are responsible for their team losing the game? Please indicate the degree of their responsibility by selecting the appropriate choice below:<\/div>\n\n<div>&nbsp;<\/div>\n\n","DataExportTag":"CF-A0-F-B0-HPxCH-742","QuestionID":"QID10","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","QuestionDescription":"Evaluation Task \u00a0 Your task is to evaluate whether Alex and AP-5 have low, medium, or high respon...","Choices":{"1":{"Display":"Alex"},"2":{"Display":"AP-5"}},"ChoiceOrder":["1","2"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"Answers":{"1":{"Display":"Low Responsibility"},"2":{"Display":"Medium Responsibility"},"3":{"Display":"High Responsibility"}},"AnswerOrder":["1","2","3"],"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"NextChoiceId":3,"NextAnswerId":4,"ChoiceDataExportTags":false}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID100","SecondaryAttribute":"Evaluation Task \u00a0 Your task is to evaluate whether Alex and AP-5 have low, medium, or high respon..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center; width: 875px;\"><u><strong>Evaluation Task<\/strong><\/u><\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">Your task is to evaluate whether Alex and AP-5 have <em><strong>low<\/strong><\/em>, <em><strong>medium<\/strong><\/em>, or <em><strong>high<\/strong><\/em> responsibility for their team losing the game.<\/div>\n\n<div>&nbsp;\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n<tbody>\n<tr>\n<td colspan=\"2\">\n<div style=\"text-align: justify;\">Consider the game in the left figure where Team A lost, and the counterfactual game in the right figure which shows what would have happened had Alex played <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">5<\/span><\/span><\/strong> in <strong>round #3<\/strong>. Once you understand what happened in the two games, <strong>please answer the question below<\/strong>.<\/div>\n<\/td>\n<\/tr>\n<tr>\n<td>\n<div style=\"text-align: center;\">Original game<\/div>\n\n<div style=\"text-align: center;\"><img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_Bo6MPT1vgKJIU9W\" style=\"width: 350px; height: 438px;\" width=\"350\" \/>&nbsp;<\/div>\n<\/td>\n<td>\n<div style=\"text-align: center;\">Counterfactual game<\/div>\n\n<div style=\"text-align: center;\">&nbsp;&nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_vwK0tRpdFc9ZIxD\" style=\"width: 350px; height: 438px;\" width=\"350\" \/><\/div>\n<\/td>\n<\/tr>\n<tr>\n<td colspan=\"2\" style=\"text-align: center;\"><br \/>\nRemember,&nbsp;<strong>the players see each others&#39; cards<\/strong>.<br \/>\n&nbsp;<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">To what extent do you think Alex and AP-5 are responsible for their team losing the game? Please indicate the degree of their responsibility by selecting the appropriate choice below:<\/div>\n\n<div>&nbsp;<\/div>\n\n","DataExportTag":"CF-A0-F-BN-HPxCH-326","QuestionID":"QID100","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","QuestionDescription":"Evaluation Task \u00a0 Your task is to evalu