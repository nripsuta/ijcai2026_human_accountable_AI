sponsibility"},"2":{"Display":"Medium Responsibility"},"3":{"Display":"High Responsibility"}},"AnswerOrder":["1","2","3"],"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"NextChoiceId":3,"NextAnswerId":4,"ChoiceDataExportTags":false}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID647","SecondaryAttribute":"Evaluation Task \u00a0\u00a0 Your task is to evaluate whether Alex and AP-5 have low, medium, or high respo.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center; width: 960px;\">\n<div style=\"text-align: center; width: 960px;\"><u><strong>Evaluation Task<\/strong><\/u><\/div>\n\n<div>&nbsp;&nbsp;<\/div>\n\n<div>\n<div style=\"text-align: justify; width: 960px;\">Your task is to evaluate whether Alex and AP-5 have <strong><em>low<\/em><\/strong>, <strong>medium<\/strong>, or <em><strong>high<\/strong><\/em> responsibility for their team losing the game.<\/div>\n\n<div style=\"text-align: left;\">&nbsp;<\/div>\n\n<div style=\"text-align: left;\">\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:960px;\">\n<tbody>\n<tr>\n<td colspan=\"3\" style=\"text-align: left;\">\n<div>Consider the game in the <strong>middle<\/strong> figure where Team A lost, and two different counterfactual games in the figures next to it:<\/div>\n\n<ol>\n<li style=\"text-align: justify;\">the <strong>first <\/strong>counterfactual game shows what would have happened had Alex played <span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\"><strong>7<\/strong><\/span><\/span> in <strong>round #1<\/strong> and had Alex&nbsp;played <span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\"><strong>5<\/strong><\/span><\/span> in <strong>round #2<\/strong>.<\/li>\n<li style=\"text-align: justify;\">the <strong>second <\/strong>counterfactual game sho