,"7":{"Display":"6"},"8":{"Display":"7"}},"ChoiceOrder":["4","5","6","7","8"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390330\/SelectableChoice\/8","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In the counterfactual game&nbsp;in Example 2, what card did AP-5 play in round #4?<\/span> <span class=\"LeftOpDesc\">7<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390330\/SelectableChoice\/8","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390330","QuestionIDFromLocator":"QID1719390330","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Incorrect answer. Please try again.","libraryID":"UR_eFIbmxnJAeQdsIl","messageID":"MS_kvtZWO1hPdQWPvd","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":3,"SubSelector":"TX","QuestionText_Unsafe":"In the <strong>counterfactual game<\/strong>&nbsp;in Example 2, what card did <strong>AP-5<\/strong> play in <strong>round #4<\/strong>?","DataExportTag":"tut-1cf-ag0-partl-Q8","QuestionID":"QID1719390330"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390331","SecondaryAttribute":"Which team won in the counterfactual game in Example 2?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which team won in the <strong>counterfactual game<\/strong> in Example 2?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Which team won in the counterfactual game in Example 2?","Choices":{"4":{"Display":"Team A"},"5":{"Display":"Team B"}},"ChoiceOrder":["4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390331\/SelectableChoice\/5","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Which team won in the counterfactual game in Example 2?<\/span> <span class=\"LeftOpDesc\">Team B<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390331\/SelectableChoice\/5","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390331","QuestionIDFromLocator":"QID1719390331","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Incorrect answer. Please try again.","libraryID":"UR_eFIbmxnJAeQdsIl","messageID":"MS_kvtZWO1hPdQWPvd","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionText_Unsafe":"Which team won in the <strong>counterfactual game<\/strong> in Example 2?","DataExportTag":"tut-1cf-ag0-partl-Q9","QuestionID":"QID1719390331"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390332","SecondaryAttribute":"Tutorial - Counterfactuals \u00a0 Counterfactual games can be based on more complex scenarios. We cont..","TertiaryAttribute":null,"Payload":{"QuestionText":"<p dir=\"ltr\" style=\"text-align: center; width:960px;\"><u><strong>Tutorial - Counterfactuals<\/strong><\/u><\/p>\n\n<p dir=\"ltr\">&nbsp;<\/p>\n\n<p align=\"justify\" dir=\"ltr\" style=\"width:960px;\">Counterfactual games can be based on more complex scenarios. We continue with the previous example to demonstrate this.<\/p>\n\n<div style=\"text-align: center; width:960px;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<\/div>\n\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:960px;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td colspan=\"3\">\n\t\t\t<p align=\"justify\" dir=\"ltr\"><strong>Example 2 (continued)<\/strong>:&nbsp;We have seen that in this example&nbsp;Team A would not have won had AP-5 played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong> in <strong>round 1&nbsp;<\/strong>(<em>the middle figure below<\/em>). However, we can also ask:<br \/>\n\t\t\t&nbsp;<\/p>\n\n\t\t\t<p dir=\"ltr\" style=\"text-align: center;\"><em>What would have happened had AP-5&nbsp;played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong><em> in <\/em><em><strong>round #1<\/strong>&nbsp;and had Alex&nbsp;played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong><em> <\/em><em>in <strong>r<\/strong><\/em><strong>ound #2<\/strong><em>?<\/em><\/p>\n\n\t\t\t<p align=\"justify\" dir=\"ltr\"><br \/>\n\t\t\tThis yields a <strong>new counterfactual <\/strong>game depicted in the <strong>right figure<\/strong> below. The differences compared to the <em>previous&nbsp;counterfactual game<\/em> in the middle&nbsp;figure are:<\/p>\n\n\t\t\t<ul dir=\"ltr\">\n\t\t\t\t<li style=\"text-align: justify;\">In <em>round #2<\/em>, we imagine that Alex had played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong> instead of card <strong><span style=\"color:#000000;\"><span style=\"background-color:#ffb38a;\">5<\/span><\/span><\/strong>.<\/li>\n\t\t\t\t<li style=\"text-align: justify;\">In <em>round #3<\/em>, we imagine that all the players had responded to the two changes (<strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span> <\/strong>and <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong>) and had played cards in <span style=\"color:#000000;\"><span style=\"background-color:#ff6700;\">dark orange<\/span><\/span><span style=\"color:#ff6700;\"> <\/span>boxes.&nbsp;<\/li>\n\t\t\t\t<li style=\"text-align: justify;\">Team A wins, which is depicted by the <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#009e73;\">green scoreboard<\/span><\/strong><\/span><span style=\"color:#000000;\">.<\/span><\/li>\n\t\t\t<\/ul>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center; width:32%;\">The original game in Example 2<br \/>\n\t\t\t<br \/>\n\t\t\t<br \/>\n\t\t\t<img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_4E76y7AKw82EDb4\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n\t\t\t<td style=\"text-align: center; width:32%;\">Previous counterfactual game<br \/>\n\t\t\t(had AP-5&nbsp;played<strong>&nbsp;<span style=\"color:#000000;\"><span style=\"background-color:#a8e68d\">4<\/span><\/span><\/strong>&nbsp;in round #1)&nbsp;<br \/>\n\t\t\t<br \/>\n\t\t\t<img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_OAVahJzEB5tNrAV\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n\t\t\t<td style=\"text-align: center; width:36%;\"><strong>New counterfactual game <\/strong><br \/>\n\t\t\t(had AP-5 played&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong>&nbsp;in round #1&nbsp;and<br \/>\n\t\t\thad Alex&nbsp;played&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong>&nbsp;in round #2) <img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_ugA9tw07DzpATlX\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Tutorial - Counterfactuals \u00a0 Counterfactual games can be based on more complex scenarios. We cont...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionText_Unsafe":"<p dir=\"ltr\" style=\"text-align: center; width:960px;\"><u><strong>Tutorial - Counterfactuals<\/strong><\/u><\/p>\n\n<p dir=\"ltr\">&nbsp;<\/p>\n\n<p align=\"justify\" dir=\"ltr\" style=\"width:960px;\">Counterfactual games can be based on more complex scenarios. We continue with the previous example to demonstrate this.<\/p>\n\n<div style=\"text-align: center; width:960px;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<\/div>\n\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:960px;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td colspan=\"3\">\n\t\t\t<p align=\"justify\" dir=\"ltr\"><strong>Example 2 (continued)<\/strong>:&nbsp;We have seen that in this example&nbsp;Team A would not have won had AP-5 played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong> in <strong>round 1&nbsp;<\/strong>(<em>the middle figure below<\/em>). However, we can also ask:<br \/>\n\t\t\t&nbsp;<\/p>\n\n\t\t\t<p dir=\"ltr\" style=\"text-align: center;\"><em>What would have happened had AP-5&nbsp;played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong><em> in <\/em><em><strong>round #1<\/strong>&nbsp;and had Alex&nbsp;played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong><em> <\/em><em>in <strong>r<\/strong><\/em><strong>ound #2<\/strong><em>?<\/em><\/p>\n\n\t\t\t<p align=\"justify\" dir=\"ltr\"><br \/>\n\t\t\tThis yields a <strong>new counterfactual <\/strong>game depicted in the <strong>right figure<\/strong> below. The differences compared to the <em>previous&nbsp;counterfactual game<\/em> in the middle&nbsp;figure are:<\/p>\n\n\t\t\t<ul dir=\"ltr\">\n\t\t\t\t<li style=\"text-align: justify;\">In <em>round #2<\/em>, we imagine that Alex had played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong> instead of card <strong><span style=\"color:#000000;\"><span style=\"background-color:#ffb38a;\">5<\/span><\/span><\/strong>.<\/li>\n\t\t\t\t<li style=\"text-align: justify;\">In <em>round #3<\/em>, we imagine that all the players had responded to the two changes (<strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span> <\/strong>and <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong>) and had played cards in <span style=\"color:#000000;\"><span style=\"background-color:#ff6700;\">dark orange<\/span><\/span><span style=\"color:#ff6700;\"> <\/span>boxes.&nbsp;<\/li>\n\t\t\t\t<li style=\"text-align: justify;\">Team A wins, which is depicted by the <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#009e73;\">green scoreboard<\/span><\/strong><\/span><span style=\"color:#000000;\">.<\/span><\/li>\n\t\t\t<\/ul>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center; width:32%;\">The original game in Example 2<br \/>\n\t\t\t<br \/>\n\t\t\t<br \/>\n\t\t\t<img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_4E76y7AKw82EDb4\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n\t\t\t<td style=\"text-align: center; width:32%;\">Previous counterfactual game<br \/>\n\t\t\t(had AP-5&nbsp;played<strong>&nbsp;<span style=\"color:#000000;\"><span style=\"background-color:#a8e68d\">4<\/span><\/span><\/strong>&nbsp;in round #1)&nbsp;<br \/>\n\t\t\t<br \/>\n\t\t\t<img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_OAVahJzEB5tNrAV\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n\t\t\t<td style=\"text-align: center; width:36%;\"><strong>New counterfactual game <\/strong><br \/>\n\t\t\t(had AP-5 played&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong>&nbsp;in round #1&nbsp;and<br \/>\n\t\t\thad Alex&nbsp;played&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong>&nbsp;in round #2) <img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_ugA9tw07DzpATlX\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>","DataExportTag":"tut-1cf-ag0-partl-10","QuestionID":"QID1719390332"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390333","SecondaryAttribute":"In the new counterfactual game in Example 2, what card did AP-5 play in round #1?","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: justify; width:960px;\">In the <strong>new counterfactual game<\/strong> in Example 2, what card did <strong>AP-5<\/strong> play in <strong>round #1<\/strong>?<\/div>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In the new counterfactual game in Example 2, what card did AP-5 play in round #1?","Choices":{"10":{"Display":"3"},"11":{"Display":"4"},"12":{"Display":"5"},"13":{"Display":"6"},"14":{"Display":"7"}},"ChoiceOrder":["10","11","12","13","14"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390333\/SelectableChoice\/11","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In the new counterfactual game in Example 2, what card did AP-5 play in round #1?<\/span> <span class=\"LeftOpDesc\">4<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390333\/SelectableChoice\/11","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390333","QuestionIDFromLocator":"QID1719390333","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"SubSelector":"TX","QuestionText_Unsafe":"<div style=\"text-align: justify; width:960px;\">In the <strong>new counterfactual game<\/strong> in Example 2, what card did <strong>AP-5<\/strong> play in <strong>round #1<\/strong>?<\/div>","DataExportTag":"tut-1cf-ag0-partl-11","QuestionID":"QID1719390333"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390334","SecondaryAttribute":"In\u00a0Example 2, did Alex play the same card in\u00a0round #2\u00a0of\u00a0the new counterfactual game and as in\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: justify; width:960px;\">In&nbsp;Example 2, did <strong>Alex<\/strong> play the same card in&nbsp;<strong>round #2<\/strong>&nbsp;of&nbsp;<strong>the new counterfactual game<\/strong> and as in&nbsp;<strong>round #2<\/strong>&nbsp;of&nbsp;<strong>the original game<\/strong>?<\/div>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In\u00a0Example 2, did Alex play the same card in\u00a0round #2\u00a0of\u00a0the new counterfactual game and as in\u00a0ro...","Choices":{"7":{"Display":"Yes"},"8":{"Display":"No"}},"ChoiceOrder":["7","8"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390334\/SelectableChoice\/8","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In&nbsp;Example 2, did Alex play the same card in&nbsp;round #2&nbsp;of&nbsp;the new counterfactual game and as in&nbsp;ro...<\/span> <span class=\"LeftOpDesc\">No<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390334\/SelectableChoice\/8","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390334","QuestionIDFromLocator":"QID1719390334","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: justify; width:960px;\">In&nbsp;Example 2, did <strong>Alex<\/strong> play the same card in&nbsp;<strong>round #2<\/strong>&nbsp;of&nbsp;<strong>the new counterfactual game<\/strong> and as in&nbsp;<strong>round #2<\/strong>&nbsp;of&nbsp;<strong>the original game<\/strong>?<\/div>","DataExportTag":"tut-1cf-ag0-partl-1 ","QuestionID":"QID1719390334"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390335","SecondaryAttribute":"Tutorial - Evaluation Task \u00a0 Great job! You have successfully understood the rules of Goofspiel a..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center; width: 875px;\"><u><strong>Tutorial - Evaluation Task<\/strong><\/u><\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">Great job! You have successfully understood the rules of Goofspiel and counterfactuals. In the remainder of the study, we will ask you to evaluate whether Alex and AP-5 have <em><strong>low<\/strong><\/em>, <em><strong>medium<\/strong><\/em>, or <em><strong>high<\/strong><\/em> responsibility for their team losing the game. We will also ask you how confident you are in your response. Below you can see an example of such questions.<\/div>\n\n<div>&nbsp;\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td colspan=\"2\">\n\t\t\t<div style=\"text-align: justify;\">Consider the game in the left figure where Team A lost, and the counterfactual game in the right figure which shows what would have happened had Alex played <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">2<\/span><\/span><\/strong> in <strong>round #3<\/strong>&nbsp;and had AP-5 played <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">9<\/span><\/span><\/strong> in <strong>round #4<\/strong>. Once you understand what happened in the two games, <strong>please answer the question below<\/strong>.<\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>\n\t\t\t<div style=\"text-align: center;\">Original game<\/div>\n\n\t\t\t<div style=\"text-align: center;\"><img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_Wik43pdVtcefyDB\" style=\"width: 350px; height: 438px;\" width=\"350\">&nbsp;<\/div>\n\t\t\t<\/td>\n\t\t\t<td>\n\t\t\t<div style=\"text-align: center;\">Counterfactual game<\/div>\n\n\t\t\t<div style=\"text-align: center;\">&nbsp;&nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_XImDAZ9HI0rK81X\" style=\"width: 350px; height: 438px;\" width=\"350\"><\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td colspan=\"2\" style=\"text-align: center;\"><br>\n\t\t\tRemember, while we can see all the cards, <strong>the players can't see each others' cards<\/strong>.<br>\n\t\t\t&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">To what extent do you think Alex and AP-5 are responsible for their team losing the game? Please indicate the degree of their responsibility by selecting the appropriate choice below:<\/div>\n\n<div>&nbsp;<\/div>","DefaultChoices":false,"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"ChoiceColumnWidthPixels":61,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Tutorial - Evaluation Task \u00a0 Great job! You have successfully understood the rules of Goofspiel a...","Choices":{"2":{"Display":"Alex"},"3":{"Display":"AP-5"}},"ChoiceOrder":["2","3"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":4,"Answers":{"1":{"Display":"Low Responsibility"},"2":{"Display":"Medium Responsibility"},"3":{"Display":"High Responsibility"}},"AnswerOrder":[1,"2","3"],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div style=\"text-align: center; width: 875px;\"><u><strong>Tutorial - Evaluation Task<\/strong><\/u><\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">Great job! You have successfully understood the rules of Goofspiel and counterfactuals. In the remainder of the study, we will ask you to evaluate whether Alex and AP-5 have <em><strong>low<\/strong><\/em>, <em><strong>medium<\/strong><\/em>, or <em><strong>high<\/strong><\/em> responsibility for their team losing the game. We will also ask you how confident you are in your response. Below you can see an example of such questions.<\/div>\n\n<div>&nbsp;\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td colspan=\"2\">\n\t\t\t<div style=\"text-align: justify;\">Consider the game in the left figure where Team A lost, and the counterfactual game in the right figure which shows what would have happened had Alex played <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">2<\/span><\/span><\/strong> in <strong>round #3<\/strong>&nbsp;and had AP-5 played <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">9<\/span><\/span><\/strong> in <strong>round #4<\/strong>. Once you understand what happened in the two games, <strong>please answer the question below<\/strong>.<\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>\n\t\t\t<div style=\"text-align: center;\">Original game<\/div>\n\n\t\t\t<div style=\"text-align: center;\"><img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_Wik43pdVtcefyDB\" style=\"width: 350px; height: 438px;\" width=\"350\">&nbsp;<\/div>\n\t\t\t<\/td>\n\t\t\t<td>\n\t\t\t<div style=\"text-align: center;\">Counterfactual game<\/div>\n\n\t\t\t<div style=\"text-align: center;\">&nbsp;&nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_XImDAZ9HI0rK81X\" style=\"width: 350px; height: 438px;\" width=\"350\"><\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td colspan=\"2\" style=\"text-align: center;\"><br>\n\t\t\tRemember, while we can see all the cards, <strong>the players can't see each others' cards<\/strong>.<br>\n\t\t\t&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">To what extent do you think Alex and AP-5 are responsible for their team losing the game? Please indicate the degree of their responsibility by selecting the appropriate choice below:<\/div>\n\n<div>&nbsp;<\/div>","DataExportTag":"tut-1cf-ag0-partl-1 ","QuestionID":"QID1719390335"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390336","SecondaryAttribute":"How confident are you in your response?","TertiaryAttribute":null,"Payload":{"QuestionText":"How confident are you in your response?","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How confident are you in your response?","Choices":{"1":{"Display":"Low confidence"},"2":{"Display":"Medium confidence"},"3":{"Display":"High confidence"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"How confident are you in your response?","DataExportTag":"Q14","QuestionID":"QID1719390336"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390337","SecondaryAttribute":"Now that you have completed the tutorial, we ask you to evaluate 5 different games and report you...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: left;\">Now that you have completed the tutorial, we ask you to evaluate 5 different games and report your opinion about the players' degrees of responsibility.&nbsp;We will also ask you how confident you are in your response.&nbsp;<\/div>\n\n<div>\n<table>\n<\/table>\n<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Now that you have completed the tutorial, we ask you to evaluate 5 different games and report you...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: left;\">Now that you have completed the tutorial, we ask you to evaluate 5 different games and report your opinion about the players' degrees of responsibility.&nbsp;We will also ask you how confident you are in your response.&nbsp;<\/div>\n\n<div>\n<table>\n<\/table>\n<\/div>","DataVisibility":{"Private":false,"Hidden":false},"DataExportTag":"tut-1cf-ag0-partl-15","QuestionID":"QID1719390337"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390338","SecondaryAttribute":"\u200b\u200b\u200b\u200b\u200bTask Description \u00a0 In this study, you will be asked a series of questions about a te","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">\u200b\u200b\u200b\u200b\u200b<u><strong>Task Description<\/strong><\/u><\/div>\n&nbsp;\n\n<div style=\"text-align: justify;\">In this study, you will be asked a series of questions about a team-based card game. Specifically, you will be asked to evaluate the <em><strong>degree of responsibility<\/strong><\/em> exhibited by each player in a team that <strong><em>lost<\/em> <\/strong>in a card game.&nbsp;<br \/>\n<br \/>\nFor this purpose, we will consider a team-based variant of the Goofspiel card game, where two teams, Team A and Team B, compete against each other. Each team consists of a human player and an AI bot.<strong><em> Alex<\/em> <em>(human)<\/em><\/strong><em> <\/em>and <strong><em>AP-5 (AI)<\/em><\/strong><em><strong> <\/strong><\/em>play in <strong><em>Team A<\/em><\/strong>, while <strong><em>Billie<\/em><\/strong> <em><strong>(human) <\/strong><\/em>and <strong><em>BB-8<\/em><\/strong> <em><strong>(AI)<\/strong><\/em> play in <strong><em>Team B<\/em><\/strong>.<br \/>\n<br \/>\nWe will first ask you to complete a <em><strong>tutorial<\/strong><\/em>. This tutorial will have three parts:<\/div>\n\n<ol>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Goofspiel<\/em>: this part explains the rules of the Goofspiel card game.<\/li>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Counterfactuals<\/em>: this part explains counterfactual reasoning in Goofspiel.&nbsp;<\/li>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Evaluation Task<\/em>: this part provides an example of evaluation tasks that you will be asked to solve.<\/li>\n<\/ol>\n\n<div style=\"text-align: justify;\"><br \/>\nAfter completing the tutorial, you will be asked to evaluate 5 games. We will show you 5 Goofspiel games <em><strong>where Team A lost<\/strong><\/em>, and your task is to evaluate to what extent Alex and AP-5 are responsible for this outcome, that is, assess whether they have <strong><em>low<\/em><\/strong>, <strong><em>medium<\/em><\/strong>, or <strong><em>high<\/em><\/strong><strong> <\/strong>responsibility for Team A losing the game.&nbsp;We will also ask you how confident you are in your response.&nbsp;<br \/>\n<br \/>\n<em>Please note that all the games that you will see are illustrative examples, and they were not played by actual human-AI teams.<\/em><\/div>\n\n<div style=\"margin-left: 40px;\"><br type=\"_moz\" \/>\n&nbsp;<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u200b\u200b\u200b\u200b\u200bTask Description \u00a0 In this study, you will be asked a series of questions about a team-based...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\">\u200b\u200b\u200b\u200b\u200b<u><strong>Task Description<\/strong><\/u><\/div>\n&nbsp;\n\n<div style=\"text-align: justify;\">In this study, you will be asked a series of questions about a team-based card game. Specifically, you will be asked to evaluate the <em><strong>degree of responsibility<\/strong><\/em> exhibited by each player in a team that <strong><em>lost<\/em> <\/strong>in a card game.&nbsp;<br \/>\n<br \/>\nFor this purpose, we will consider a team-based variant of the Goofspiel card game, where two teams, Team A and Team B, compete against each other. Each team consists of a human player and an AI bot.<strong><em> Alex<\/em> <em>(human)<\/em><\/strong><em> <\/em>and <strong><em>AP-5 (AI)<\/em><\/strong><em><strong> <\/strong><\/em>play in <strong><em>Team A<\/em><\/strong>, while <strong><em>Billie<\/em><\/strong> <em><strong>(human) <\/strong><\/em>and <strong><em>BB-8<\/em><\/strong> <em><strong>(AI)<\/strong><\/em> play in <strong><em>Team B<\/em><\/strong>.<br \/>\n<br \/>\nWe will first ask you to complete a <em><strong>tutorial<\/strong><\/em>. This tutorial will have three parts:<\/div>\n\n<ol>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Goofspiel<\/em>: this part explains the rules of the Goofspiel card game.<\/li>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Counterfactuals<\/em>: this part explains counterfactual reasoning in Goofspiel.&nbsp;<\/li>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Evaluation Task<\/em>: this part provides an example of evaluation tasks that you will be asked to solve.<\/li>\n<\/ol>\n\n<div style=\"text-align: justify;\"><br \/>\nAfter completing the tutorial, you will be asked to evaluate 5 games. We will show you 5 Goofspiel games <em><strong>where Team A lost<\/strong><\/em>, and your task is to evaluate to what extent Alex and AP-5 are responsible for this outcome, that is, assess whether they have <strong><em>low<\/em><\/strong>, <strong><em>medium<\/em><\/strong>, or <strong><em>high<\/em><\/strong><strong> <\/strong>responsibility for Team A losing the game.&nbsp;We will also ask you how confident you are in your response.&nbsp;<br \/>\n<br \/>\n<em>Please note that all the games that you will see are illustrative examples, and they were not played by actual human-AI teams.<\/em><\/div>\n\n<div style=\"margin-left: 40px;\"><br type=\"_moz\" \/>\n&nbsp;<\/div>","DataExportTag":"tut-1cf-ag1-full-Q1","QuestionID":"QID1719390338"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390339","SecondaryAttribute":"\u200b\u200b\u200b\u200b\u200bTutorial - Goofspiel \u00a0 To solve your tasks, you need to familiarize yourself with th","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">\u200b\u200b\u200b\u200b\u200b<u><strong>Tutorial - Goofspiel<\/strong><\/u><\/div>\n&nbsp;\n\n<div style=\"text-align: justify;\">To solve your tasks, you need to familiarize yourself with the rules of the team-based version of Goofspiel. The rules are as follows:<\/div>\n\n<ul>\n <li style=\"text-align: justify;\">At the beginning of the game, each player receives 5 cards from the standard 52 card deck - <strong>players see each others&#39; cards<\/strong>. Additionally, a separate deck of cards is shuffled, called <em>prize deck<\/em>.&nbsp;<\/li>\n <li style=\"text-align: justify;\">The game proceeds in <em>rounds<\/em>. In each round, one prize card is drawn from the prize deck, and upon observing&nbsp;the prize&nbsp;card,&nbsp;the&nbsp;players simultaneously select one card from their hand. The team that plays cards with a higher sum&nbsp;wins the prize card, and the&nbsp;prize is added to the team&#39;s score. If&nbsp;the teams have equal sums, the prize card is discarded and the scores remain the same.<\/li>\n <li style=\"text-align: justify;\">The game finishes after round #5, and the team with&nbsp;the highest score wins. If the teams have equal score, then it&#39;s a draw.&nbsp;&nbsp;<\/li>\n<\/ul>\n\n<div>\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" height=\"630\" width=\"723\">\n <tbody>\n  <tr>\n   <td>\n   <div style=\"text-align: justify;\"><strong>Example 1<\/strong>: We explain how games are represented using the game below.&nbsp;The&nbsp;<em>rounds <\/em>are<em> <\/em>represented as circles: the first round (round #1) is&nbsp;on the outermost circle, while the last round (round #5)&nbsp;is on the innermost circle. The cards that players played in the game are shown in the <span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">grey boxes<\/span><\/span>. The prize cards are shown in the <span style=\"color:#000000;\"><span style=\"background-color:#e6d70b;\">yellow boxes<\/span><\/span>.<\/div>\n\n   <div>&nbsp;<\/div>\n\n   <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_2Bo95zy0fCWG473\" style=\"height: 438px; width: 350px;\" width=\"350\" \/><\/div>\n\n   <div>&nbsp;<\/div>\n\n   <div style=\"text-align: justify;\">In this example, all players initially received&nbsp;cards 3, 4, 5, 6, and 7 (round #1). Note that in general players do not have to receive the same cards. In the first round (round #1), <span style=\"text-size-adjust: 100%;\">prize card&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#e6d70b;\">3<\/span><\/span><\/strong>&nbsp;was drawn from the prize deck,&nbsp;<\/span>both Alex and AP-5 played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">3<\/span><\/span><\/strong>, Billie played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">4<\/span><\/span><\/strong>, and BB-8 <span style=\"text-size-adjust: 100%;\">played card <\/span><strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">5<\/span><\/span><\/strong><span style=\"text-size-adjust: 100%;\">.&nbsp;<\/span>Team B won the prize card&nbsp;<strong><span style=\"color:#000000;\"><span style=\"text-size-adjust: 100%;\"><span style=\"background-color:#e6d70b;\">3<\/span><\/span><\/span><\/strong>: Team A played cards whose sum is 6, and Team B played cards whose sum is 9.<br \/>\n   <br \/>\n   Team A won the prize cards in round #2 and round #4, achieving the score of <strong><span style=\"color:#ffffff;\"><span style=\"background-color:#420516;\">11<\/span><\/span><\/strong>. Team B won all the other prizes, achieving the score of <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#420516;\">14<\/span><\/strong><\/span>. Hence, Team B won the game, which is depicted by the <span style=\"color:#420516;\"><strong>red scoreboard<\/strong><\/span>.<\/div>\n   <\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n<\/div>\n\n<p align=\"justify\" dir=\"ltr\"><br \/>\nNow that you are familiar with the rules of Goofspiel and the game representation, we ask you to answer the questions below.&nbsp;&nbsp;<br \/>\n&nbsp;<\/p>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u200b\u200b\u200b\u200b\u200bTutorial - Goofspiel \u00a0 To solve your tasks, you need to familiarize yourself with the rules...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\">\u200b\u200b\u200b\u200b\u200b<u><strong>Tutorial - Goofspiel<\/strong><\/u><\/div>\n&nbsp;\n\n<div style=\"text-align: justify;\">To solve your tasks, you need to familiarize yourself with the rules of the team-based version of Goofspiel. The rules are as follows:<\/div>\n\n<ul>\n <li style=\"text-align: justify;\">At the beginning of the game, each player receives 5 cards from the standard 52 card deck - <strong>players see each others&#39; cards<\/strong>. Additionally, a separate deck of cards is shuffled, called <em>prize deck<\/em>.&nbsp;<\/li>\n <li style=\"text-align: justify;\">The game proceeds in <em>rounds<\/em>. In each round, one prize card is drawn from the prize deck, and upon observing&nbsp;the prize&nbsp;card,&nbsp;the&nbsp;players simultaneously select one card from their hand. The team that plays cards with a higher sum&nbsp;wins the prize card, and the&nbsp;prize is added to the team&#39;s score. If&nbsp;the teams have equal sums, the prize card is discarded and the scores remain the same.<\/li>\n <li style=\"text-align: justify;\">The game finishes after round #5, and the team with&nbsp;the highest score wins. If the teams have equal score, then it&#39;s a draw.&nbsp;&nbsp;<\/li>\n<\/ul>\n\n<div>\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" height=\"630\" width=\"723\">\n <tbody>\n  <tr>\n   <td>\n   <div style=\"text-align: justify;\"><strong>Example 1<\/strong>: We explain how games are represented using the game below.&nbsp;The&nbsp;<em>rounds <\/em>are<em> <\/em>represented as circles: the first round (round #1) is&nbsp;on the outermost circle, while the last round (round #5)&nbsp;is on the innermost circle. The cards that players played in the game are shown in the <span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">grey boxes<\/span><\/span>. The prize cards are shown in the <span style=\"color:#000000;\"><span style=\"background-color:#e6d70b;\">yellow boxes<\/span><\/span>.<\/div>\n\n   <div>&nbsp;<\/div>\n\n   <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_2Bo95zy0fCWG473\" style=\"height: 438px; width: 350px;\" width=\"350\" \/><\/div>\n\n   <div>&nbsp;<\/div>\n\n   <div style=\"text-align: justify;\">In this example, all players initially received&nbsp;cards 3, 4, 5, 6, and 7 (round #1). Note that in general players do not have to receive the same cards. In the first round (round #1), <span style=\"text-size-adjust: 100%;\">prize card&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#e6d70b;\">3<\/span><\/span><\/strong>&nbsp;was drawn from the prize deck,&nbsp;<\/span>both Alex and AP-5 played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">3<\/span><\/span><\/strong>, Billie played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">4<\/span><\/span><\/strong>, and BB-8 <span style=\"text-size-adjust: 100%;\">played card <\/span><strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">5<\/span><\/span><\/strong><span style=\"text-size-adjust: 100%;\">.&nbsp;<\/span>Team B won the prize card&nbsp;<strong><span style=\"color:#000000;\"><span style=\"text-size-adjust: 100%;\"><span style=\"background-color:#e6d70b;\">3<\/span><\/span><\/span><\/strong>: Team A played cards whose sum is 6, and Team B played cards whose sum is 9.<br \/>\n   <br \/>\n   Team A won the prize cards in round #2 and round #4, achieving the score of <strong><span style=\"color:#ffffff;\"><span style=\"background-color:#420516;\">11<\/span><\/span><\/strong>. Team B won all the other prizes, achieving the score of <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#420516;\">14<\/span><\/strong><\/span>. Hence, Team B won the game, which is depicted by the <span style=\"color:#420516;\"><strong>red scoreboard<\/strong><\/span>.<\/div>\n   <\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n<\/div>\n\n<p align=\"justify\" dir=\"ltr\"><br \/>\nNow that you are familiar with the rules of Goofspiel and the game representation, we ask you to answer the questions below.&nbsp;&nbsp;<br \/>\n&nbsp;<\/p>","DataExportTag":"tut-1cf-ag1-full-Q2","QuestionID":"QID1719390339"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390340","SecondaryAttribute":"In Example 1, what card did AP-5 play in round #2?\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"In Example 1, what card did <strong>AP-5<\/strong> play in <strong>round #2<\/strong>?&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In Example 1, what card did AP-5 play in round #2?\u00a0","Choices":{"4":{"Display":"3"},"5":{"Display":"4"},"6":{"Display":"5"},"7":{"Display":"6"},"10":{"Display":"7"}},"ChoiceOrder":["4","5","6","7","10"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390340\/SelectableChoice\/10","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In Example 1, what card did AP-5 play in round #2?&nbsp;<\/span> <span class=\"LeftOpDesc\">7<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390340\/SelectableChoice\/10","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390340","QuestionIDFromLocator":"QID1719390340","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":13,"NextAnswerId":1,"QuestionText_Unsafe":"In Example 1, what card did <strong>AP-5<\/strong> play in <strong>round #2<\/strong>?&nbsp;","DataExportTag":"tut-1cf-ag1-full-Q3","QuestionID":"QID1719390340"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390341","SecondaryAttribute":"In Example 1, what was the prize in round #3?","TertiaryAttribute":null,"Payload":{"QuestionText":"In Example 1, what was the prize in <strong>round #3<\/strong>?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In Example 1, what was the prize in round #3?","Choices":{"4":{"Display":"3"},"5":{"Display":"4"},"6":{"Display":"5"},"7":{"Display":"6"},"8":{"Display":"7"}},"ChoiceOrder":["4","5","6","7","8"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390341\/SelectableChoice\/8","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In Example 1, what was the prize in round #3?<\/span> <span class=\"LeftOpDesc\">7<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390341\/SelectableChoice\/8","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390341","QuestionIDFromLocator":"QID1719390341","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":1,"SubSelector":"TX","QuestionText_Unsafe":"In Example 1, what was the prize in <strong>round #3<\/strong>?","DataExportTag":"tut-1cf-ag1-full-Q4","QuestionID":"QID1719390341"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390342","SecondaryAttribute":"In Example 1, which team won the prize in round #4?","TertiaryAttribute":null,"Payload":{"QuestionText":"In Example 1, which team won the prize in <strong>round #4<\/strong>?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In Example 1, which team won the prize in round #4?","Choices":{"4":{"Display":"Team A"},"5":{"Display":"Team B"}},"ChoiceOrder":["4","5"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390342\/SelectableChoice\/4","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In Example 1, which team won the prize in round #4?<\/span> <span class=\"LeftOpDesc\">Team A<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390342\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390342","QuestionIDFromLocator":"QID1719390342","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":5,"QuestionText_Unsafe":"In Example 1, which team won the prize in <strong>round #4<\/strong>?","DataExportTag":"tut-1cf-ag1-full-Q5","QuestionID":"QID1719390342"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390343","SecondaryAttribute":"Tutorial - Counterfactuals \u00a0\u00a0 To solve your tasks, you also need to familiarize yourself with cou.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div dir=\"ltr\" style=\"display: block;>\n\n<p style=\">\n<div style=\"text-align: center; width: 875px;\"><u><strong>Tutorial - Counterfactuals<\/strong><\/u><\/div>\n\n<p>&nbsp;&nbsp;<\/p>\n\n<div style=\"text-align: justify; width: 875px;\">To solve your tasks, you also need to familiarize yourself with <em>counterfactuals<\/em>.&nbsp;In this task, <em><strong>counterfactual games<\/strong><\/em> show what would have happened had the players played their cards differently. We continue with the previous example to explain counterfactual games.<\/div>\n\n<p dir=\"ltr\">&nbsp;<\/p>\n\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n <tbody>\n  <tr>\n   <td colspan=\"2\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 1 (continued)<\/strong>: We have seen that in this example Team A lost (<em>the left figure below<\/em>). However, consider the following question:&nbsp;<span style=\"text-align: center;\"> <\/span><br>\n   &nbsp;<\/p>\n\n   <p dir=\"ltr\" style=\"text-align: center;\"><em>What would have happened had AP-5 played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong><em> in<\/em><em><strong> round #2<\/strong>?<\/em><br>\n   &nbsp;<\/p>\n\n   <p align=\"justify\" dir=\"ltr\">Clearly, nothing would have changed in <em>round #1<\/em>. However, the <strong>cards<\/strong> the players would have played in <strong>round&nbsp;#3<\/strong>, <strong>round #4<\/strong>, and <strong>round #5<\/strong>, can be <strong>different from<\/strong> those that are originally played. The <strong>right figure<\/strong> below shows a <strong>counterfactual game<\/strong>. The differences compared to the original game in the left figure are:<\/p>\n\n   <ul dir=\"ltr\">\n    <li style=\"text-align: justify;\">In <em>round #2<\/em>, we imagine that AP-5 had played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong> instead of card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">7<\/span><\/span><\/strong>.<\/li>\n    <li style=\"text-align: justify;\">In <em>round&nbsp;#3<\/em>, <em>round #4<\/em>, and <em>round&nbsp;#5<\/em>, we imagine that all the players had responded to this change and had played cards in<strong> <\/strong><span style=\"color:#000000;\"><span style=\"background-color:#ffb38a;\">light orange<\/span><\/span><strong><span style=\"color:#d55e00;\"> <\/span><\/strong>boxes<span style=\"color:#000000;\">.<\/span><strong> <\/strong><\/li>\n    <li style=\"text-align: justify;\">Team A wins the counterfactual game, which is depicted by the <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#009e73;\">green scoreboard<\/span><\/strong><\/span><span style=\"color:#000000;\">.<\/span><\/li>\n   <\/ul>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center;\">The original game in Example 1&nbsp; &nbsp;<br>\n   <br>\n   &nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_2Bo95zy0fCWG473\" style=\"height: 438px; width: 350px;\" width=\"350\"><\/td>\n   <td style=\"text-align: center;\">Counterfactual game<br>\n   (had AP-5 played <span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span> in round #2)<br>\n   &nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_dV6DprmriLkQHjO\" style=\"height: 438px; width: 350px;\" width=\"350\"><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n\n<div style=\"width: 100%; text-align: justify; width: 875px;\"><br>\nNow that you are familiar with counterfactual games, we ask you to take a look at <em>another example<\/em>, and answer the questions below.&nbsp;<br>\n&nbsp;\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n <tbody>\n  <tr>\n   <td colspan=\"2\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 2<\/strong>: Please take a look at another game below, and one of its counterfactual games. Once you understand what happened in the counterfactual game, <strong>please answer the questions below<\/strong>.<\/p>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center;\">The original game in Example 2<br>\n   <br>\n   &nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_4E76y7AKw82EDb4\" style=\"height: 438px; width: 350px;\" width=\"350\"><\/td>\n   <td style=\"text-align: center;\"><span style=\"text-align: center;\">Counterfactual game<br>\n   (had&nbsp;AP-5&nbsp;played <\/span><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><span style=\"text-align: center;\"> in round #1)<\/span><br>\n   &nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_OAVahJzEB5tNrAV\" style=\"height: 438px; width: 350px;\" width=\"350\"><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n<\/div>\n<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Tutorial - Counterfactuals \u00a0\u00a0 To solve your tasks, you also need to familiarize yourself with cou...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div dir=\"ltr\" style=\"display: block;>\n\n<p style=\">\n<div style=\"text-align: center; width: 875px;\"><u><strong>Tutorial - Counterfactuals<\/strong><\/u><\/div>\n\n<p>&nbsp;&nbsp;<\/p>\n\n<div style=\"text-align: justify; width: 875px;\">To solve your tasks, you also need to familiarize yourself with <em>counterfactuals<\/em>.&nbsp;In this task, <em><strong>counterfactual games<\/strong><\/em> show what would have happened had the players played their cards differently. We continue with the previous example to explain counterfactual games.<\/div>\n\n<p dir=\"ltr\">&nbsp;<\/p>\n\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n <tbody>\n  <tr>\n   <td colspan=\"2\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 1 (continued)<\/strong>: We have seen that in this example Team A lost (<em>the left figure below<\/em>). However, consider the following question:&nbsp;<span style=\"text-align: center;\"> <\/span><br>\n   &nbsp;<\/p>\n\n   <p dir=\"ltr\" style=\"text-align: center;\"><em>What would have happened had AP-5 played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong><em> in<\/em><em><strong> round #2<\/strong>?<\/em><br>\n   &nbsp;<\/p>\n\n   <p align=\"justify\" dir=\"ltr\">Clearly, nothing would have changed in <em>round #1<\/em>. However, the <strong>cards<\/strong> the players would have played in <strong>round&nbsp;#3<\/strong>, <strong>round #4<\/strong>, and <strong>round #5<\/strong>, can be <strong>different from<\/strong> those that are originally played. The <strong>right figure<\/strong> below shows a <strong>counterfactual game<\/strong>. The differences compared to the original game in the left figure are:<\/p>\n\n   <ul dir=\"ltr\">\n    <li style=\"text-align: justify;\">In <em>round #2<\/em>, we imagine that AP-5 had played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong> instead of card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">7<\/span><\/span><\/strong>.<\/li>\n    <li style=\"text-align: justify;\">In <em>round&nbsp;#3<\/em>, <em>round #4<\/em>, and <em>round&nbsp;#5<\/em>, we imagine that all the players had responded to this change and had played cards in<strong> <\/strong><span style=\"color:#000000;\"><span style=\"background-color:#ffb38a;\">light orange<\/span><\/span><strong><span style=\"color:#d55e00;\"> <\/span><\/strong>boxes<span style=\"color:#000000;\">.<\/span><strong> <\/strong><\/li>\n    <li style=\"text-align: justify;\">Team A wins the counterfactual game, which is depicted by the <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#009e73;\">green scoreboard<\/span><\/strong><\/span><span style=\"color:#000000;\">.<\/span><\/li>\n   <\/ul>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center;\">The original game in Example 1&nbsp; &nbsp;<br>\n   <br>\n   &nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_2Bo95zy0fCWG473\" style=\"height: 438px; width: 350px;\" width=\"350\"><\/td>\n   <td style=\"text-align: center;\">Counterfactual game<br>\n   (had AP-5 played <span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span> in round #2)<br>\n   &nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_dV6DprmriLkQHjO\" style=\"height: 438px; width: 350px;\" width=\"350\"><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n\n<div style=\"width: 100%; text-align: justify; width: 875px;\"><br>\nNow that you are familiar with counterfactual games, we ask you to take a look at <em>another example<\/em>, and answer the questions below.&nbsp;<br>\n&nbsp;\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n <tbody>\n  <tr>\n   <td colspan=\"2\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 2<\/strong>: Please take a look at another game below, and one of its counterfactual games. Once you understand what happened in the counterfactual game, <strong>please answer the questions below<\/strong>.<\/p>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center;\">The original game in Example 2<br>\n   <br>\n   &nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_4E76y7AKw82EDb4\" style=\"height: 438px; width: 350px;\" width=\"350\"><\/td>\n   <td style=\"text-align: center;\"><span style=\"text-align: center;\">Counterfactual game<br>\n   (had&nbsp;AP-5&nbsp;played <\/span><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><span style=\"text-align: center;\"> in round #1)<\/span><br>\n   &nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_OAVahJzEB5tNrAV\" style=\"height: 438px; width: 350px;\" width=\"350\"><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n<\/div>\n<\/div>","DataExportTag":"tut-1cf-ag1-full-Q6","QuestionID":"QID1719390343"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390344","SecondaryAttribute":"In the counterfactual game\u00a0in Example 2, what card did AP-5\u00a0play in round #1?","TertiaryAttribute":null,"Payload":{"QuestionText":"In the <strong>counterfactual game<\/strong>&nbsp;in Example 2, what card did <strong>AP-5<\/strong>&nbsp;play in <strong>round #1<\/strong>?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In the counterfactual game\u00a0in Example 2, what card did AP-5\u00a0play in round #1?","Choices":{"4":{"Display":"3"},"5":{"Display":"4"},"6":{"Display":"5"},"7":{"Display":"6"},"8":{"Display":"7"}},"ChoiceOrder":["4","5","6","7","8"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390344\/SelectableChoice\/5","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In the counterfactual game&nbsp;in Example 2, what card did AP-5&nbsp;play in round #1?<\/span> <span class=\"LeftOpDesc\">4<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390344\/SelectableChoice\/5","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390344","QuestionIDFromLocator":"QID1719390344","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":3,"SubSelector":"TX","QuestionText_Unsafe":"In the <strong>counterfactual game<\/strong>&nbsp;in Example 2, what card did <strong>AP-5<\/strong>&nbsp;play in <strong>round #1<\/strong>?","DataExportTag":"tut-1cf-ag1-full-Q7","QuestionID":"QID1719390344"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390345","SecondaryAttribute":"In the counterfactual game\u00a0in Example 2, what card did AP-5 play in round #4?","TertiaryAttribute":null,"Payload":{"QuestionText":"In the <strong>counterfactual game<\/strong>&nbsp;in Example 2, what card did <strong>AP-5<\/strong> play in <strong>round #4<\/strong>?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In the counterfactual game\u00a0in Example 2, what card did AP-5 play in round #4?","Choices":{"4":{"Display":"3"},"5":{"Display":"4"},"6":{"Display":"5"},"7":{"Display":"6"},"8":{"Display":"7"}},"ChoiceOrder":["4","5","6","7","8"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390345\/SelectableChoice\/8","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In the counterfactual game&nbsp;in Example 2, what card did AP-5 play in round #4?<\/span> <span class=\"LeftOpDesc\">7<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390345\/SelectableChoice\/8","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390345","QuestionIDFromLocator":"QID1719390345","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":3,"SubSelector":"TX","QuestionText_Unsafe":"In the <strong>counterfactual game<\/strong>&nbsp;in Example 2, what card did <strong>AP-5<\/strong> play in <strong>round #4<\/strong>?","DataExportTag":"tut-1cf-ag1-full-Q8","QuestionID":"QID1719390345"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390346","SecondaryAttribute":"Which team won in the counterfactual game in Example 2?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which team won in the <strong>counterfactual game<\/strong> in Example 2?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Which team won in the counterfactual game in Example 2?","Choices":{"4":{"Display":"Team A"},"5":{"Display":"Team B"}},"ChoiceOrder":["4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390346\/SelectableChoice\/5","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Which team won in the counterfactual game in Example 2?<\/span> <span class=\"LeftOpDesc\">Team B<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390346\/SelectableChoice\/5","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390346","QuestionIDFromLocator":"QID1719390346","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionText_Unsafe":"Which team won in the <strong>counterfactual game<\/strong> in Example 2?","DataExportTag":"tut-1cf-ag1-full-Q9","QuestionID":"QID1719390346"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390347","SecondaryAttribute":"Tutorial - Counterfactuals \u00a0 Counterfactual games can be based on more complex scenarios. We cont..","TertiaryAttribute":null,"Payload":{"QuestionText":"<p dir=\"ltr\" style=\"text-align: center; width:960px;\"><u><strong>Tutorial - Counterfactuals<\/strong><\/u><\/p>\n\n<p dir=\"ltr\">&nbsp;<\/p>\n\n<p align=\"justify\" dir=\"ltr\" style=\"width:960px;\">Counterfactual games can be based on more complex scenarios. We continue with the previous example to demonstrate this.<\/p>\n\n<div style=\"text-align: center; width:960px;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<\/div>\n\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:960px;\">\n <tbody>\n  <tr>\n   <td colspan=\"3\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 2 (continued)<\/strong>:&nbsp;We have seen that in this example&nbsp;Team A would not have won had AP-5 played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong> in <strong>round 1&nbsp;<\/strong>(<em>the middle figure below<\/em>). However, we can also ask:<br \/>\n   &nbsp;<\/p>\n\n   <p dir=\"ltr\" style=\"text-align: center;\"><em>What would have happened had AP-5&nbsp;played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong><em> in <\/em><em><strong>round #1<\/strong>&nbsp;and had Alex&nbsp;played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong><em> <\/em><em>in <strong>r<\/strong><\/em><strong>ound #2<\/strong><em>?<\/em><\/p>\n\n   <p align=\"justify\" dir=\"ltr\"><br \/>\n   This yields a <strong>new counterfactual <\/strong>game depicted in the <strong>right figure<\/strong> below. The differences compared to the <em>previous&nbsp;counterfactual game<\/em> in the middle&nbsp;figure are:<\/p>\n\n   <ul dir=\"ltr\">\n    <li style=\"text-align: justify;\">In <em>round #2<\/em>, we imagine that Alex had played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong> instead of card <strong><span style=\"color:#000000;\"><span style=\"background-color:#ffb38a;\">5<\/span><\/span><\/strong>.<\/li>\n    <li style=\"text-align: justify;\">In <em>round #3<\/em>, we imagine that all the players had responded to the two changes (<strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span> <\/strong>and <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong>) and had played cards in <span style=\"color:#000000;\"><span style=\"background-color:#ff6700;\">dark orange<\/span><\/span><span style=\"color:#ff6700;\"> <\/span>boxes.&nbsp;<\/li>\n    <li style=\"text-align: justify;\">Team A wins, which is depicted by the <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#009e73;\">green scoreboard<\/span><\/strong><\/span><span style=\"color:#000000;\">.<\/span><\/li>\n   <\/ul>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center; width:32%;\">The original game in Example 2<br \/>\n   <br \/>\n   <br \/>\n   <img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_4E76y7AKw82EDb4\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n   <td style=\"text-align: center; width:32%;\">Previous counterfactual game<br \/>\n   (had AP-5&nbsp;played<strong>&nbsp;<span style=\"color:#000000;\"><span style=\"background-color:#a8e68d\">4<\/span><\/span><\/strong>&nbsp;in round #1)&nbsp;<br \/>\n   <br \/>\n   <img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_OAVahJzEB5tNrAV\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n   <td style=\"text-align: center; width:36%;\"><strong>New counterfactual game <\/strong><br \/>\n   (had AP-5 played&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong>&nbsp;in round #1&nbsp;and<br \/>\n   had Alex&nbsp;played&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong>&nbsp;in round #2) <img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_ugA9tw07DzpATlX\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Tutorial - Counterfactuals \u00a0 Counterfactual games can be based on more complex scenarios. We cont...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionText_Unsafe":"<p dir=\"ltr\" style=\"text-align: center; width:960px;\"><u><strong>Tutorial - Counterfactuals<\/strong><\/u><\/p>\n\n<p dir=\"ltr\">&nbsp;<\/p>\n\n<p align=\"justify\" dir=\"ltr\" style=\"width:960px;\">Counterfactual games can be based on more complex scenarios. We continue with the previous example to demonstrate this.<\/p>\n\n<div style=\"text-align: center; width:960px;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<\/div>\n\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:960px;\">\n <tbody>\n  <tr>\n   <td colspan=\"3\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 2 (continued)<\/strong>:&nbsp;We have seen that in this example&nbsp;Team A would not have won had AP-5 played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong> in <strong>round 1&nbsp;<\/strong>(<em>the middle figure below<\/em>). However, we can also ask:<br \/>\n   &nbsp;<\/p>\n\n   <p dir=\"ltr\" style=\"text-align: center;\"><em>What would have happened had AP-5&nbsp;played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong><em> in <\/em><em><strong>round #1<\/strong>&nbsp;and had Alex&nbsp;played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong><em> <\/em><em>in <strong>r<\/strong><\/em><strong>ound #2<\/strong><em>?<\/em><\/p>\n\n   <p align=\"justify\" dir=\"ltr\"><br \/>\n   This yields a <strong>new counterfactual <\/strong>game depicted in the <strong>right figure<\/strong> below. The differences compared to the <em>previous&nbsp;counterfactual game<\/em> in the middle&nbsp;figure are:<\/p>\n\n   <ul dir=\"ltr\">\n    <li style=\"text-align: justify;\">In <em>round #2<\/em>, we imagine that Alex had played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong> instead of card <strong><span style=\"color:#000000;\"><span style=\"background-color:#ffb38a;\">5<\/span><\/span><\/strong>.<\/li>\n    <li style=\"text-align: justify;\">In <em>round #3<\/em>, we imagine that all the players had responded to the two changes (<strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span> <\/strong>and <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong>) and had played cards in <span style=\"color:#000000;\"><span style=\"background-color:#ff6700;\">dark orange<\/span><\/span><span style=\"color:#ff6700;\"> <\/span>boxes.&nbsp;<\/li>\n    <li style=\"text-align: justify;\">Team A wins, which is depicted by the <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#009e73;\">green scoreboard<\/span><\/strong><\/span><span style=\"color:#000000;\">.<\/span><\/li>\n   <\/ul>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center; width:32%;\">The original game in Example 2<br \/>\n   <br \/>\n   <br \/>\n   <img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_4E76y7AKw82EDb4\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n   <td style=\"text-align: center; width:32%;\">Previous counterfactual game<br \/>\n   (had AP-5&nbsp;played<strong>&nbsp;<span style=\"color:#000000;\"><span style=\"background-color:#a8e68d\">4<\/span><\/span><\/strong>&nbsp;in round #1)&nbsp;<br \/>\n   <br \/>\n   <img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_OAVahJzEB5tNrAV\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n   <td style=\"text-align: center; width:36%;\"><strong>New counterfactual game <\/strong><br \/>\n   (had AP-5 played&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong>&nbsp;in round #1&nbsp;and<br \/>\n   had Alex&nbsp;played&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong>&nbsp;in round #2) <img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_ugA9tw07DzpATlX\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>","DataExportTag":"tut-1cf-ag1-full-Q10","QuestionID":"QID1719390347"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390348","SecondaryAttribute":"In the new counterfactual game in Example 2, what card did AP-5 play in round #1?","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: justify; width:960px;\">In the <strong>new counterfactual game<\/strong> in Example 2, what card did <strong>AP-5<\/strong> play in <strong>round #1<\/strong>?<\/div>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In the new counterfactual game in Example 2, what card did AP-5 play in round #1?","Choices":{"10":{"Display":"3"},"11":{"Display":"4"},"12":{"Display":"5"},"13":{"Display":"6"},"14":{"Display":"7"}},"ChoiceOrder":["10","11","12","13","14"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390348\/SelectableChoice\/11","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In the new counterfactual game in Example 2, what card did AP-5 play in round #1?<\/span> <span class=\"LeftOpDesc\">4<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390348\/SelectableChoice\/11","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390348","QuestionIDFromLocator":"QID1719390348","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"SubSelector":"TX","QuestionText_Unsafe":"<div style=\"text-align: justify; width:960px;\">In the <strong>new counterfactual game<\/strong> in Example 2, what card did <strong>AP-5<\/strong> play in <strong>round #1<\/strong>?<\/div>","DataExportTag":"tut-1cf-ag1-full-Q11","QuestionID":"QID1719390348"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390349","SecondaryAttribute":"In\u00a0Example 2, did Alex play the same card in\u00a0round #2\u00a0of\u00a0the new counterfactual game and as in\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: justify; width:960px;\">In&nbsp;Example 2, did <strong>Alex<\/strong> play the same card in&nbsp;<strong>round #2<\/strong>&nbsp;of&nbsp;<strong>the new counterfactual game<\/strong> and as in&nbsp;<strong>round #2<\/strong>&nbsp;of&nbsp;<strong>the original game<\/strong>?<\/div>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In\u00a0Example 2, did Alex play the same card in\u00a0round #2\u00a0of\u00a0the new counterfactual game and as in\u00a0ro...","Choices":{"7":{"Display":"Yes"},"8":{"Display":"No"}},"ChoiceOrder":["7","8"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390349\/SelectableChoice\/8","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In&nbsp;Example 2, did Alex play the same card in&nbsp;round #2&nbsp;of&nbsp;the new counterfactual game and as in&nbsp;ro...<\/span> <span class=\"LeftOpDesc\">No<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390349\/SelectableChoice\/8","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390349","QuestionIDFromLocator":"QID1719390349","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: justify; width:960px;\">In&nbsp;Example 2, did <strong>Alex<\/strong> play the same card in&nbsp;<strong>round #2<\/strong>&nbsp;of&nbsp;<strong>the new counterfactual game<\/strong> and as in&nbsp;<strong>round #2<\/strong>&nbsp;of&nbsp;<strong>the original game<\/strong>?<\/div>","DataExportTag":"tut-1cf-ag1-full-Q12","QuestionID":"QID1719390349"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390350","SecondaryAttribute":"Tutorial - Evaluation Task \u00a0 Great job! You have successfully understood the rules of Goofspiel a..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center; width: 875px;\"><u><strong>Tutorial - Evaluation Task<\/strong><\/u><\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">Great job! You have successfully understood the rules of Goofspiel and counterfactuals. In the remainder of the study we will ask you to&nbsp;evaluate whether Alex and AP-5 have <em><strong>low<\/strong><\/em>, <em><strong>medium<\/strong><\/em>, or <em><strong>high<\/strong><\/em> responsibility for their team losing the game.&nbsp;We will also ask you how confident you are in your response. Below you can see an example of such questions.<\/div>\n\n<div>&nbsp;\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td colspan=\"2\">\n\t\t\t<div style=\"text-align: justify;\">Consider the game in the left figure where Team A lost, and the counterfactual game in the right figure which shows what would have happened had Alex played <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">2<\/span><\/span><\/strong> in <strong>round #3<\/strong>&nbsp;and had AP-5 played <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">9<\/span><\/span><\/strong> in <strong>round #4<\/strong>. Once you understand what happened in the two games, <strong>please answer the question below<\/strong>.<\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>\n\t\t\t<div style=\"text-align: center;\">Original game<\/div>\n\n\t\t\t<div style=\"text-align: center;\"><img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_Wik43pdVtcefyDB\" style=\"width: 350px; height: 438px;\" width=\"350\">&nbsp;<\/div>\n\t\t\t<\/td>\n\t\t\t<td>\n\t\t\t<div style=\"text-align: center;\">Counterfactual game<\/div>\n\n\t\t\t<div style=\"text-align: center;\">&nbsp;&nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_XImDAZ9HI0rK81X\" style=\"width: 350px; height: 438px;\" width=\"350\"><\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td colspan=\"2\" style=\"text-align: center;\"><br>\n\t\t\tRemember,&nbsp;<strong>the players see each others' cards<\/strong>.<br>\n\t\t\t&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">To what extent do you think Alex and AP-5 are responsible for their team losing the game? Please indicate the degree of their responsibility by selecting the appropriate choice below:<\/div>\n\n<div>&nbsp;<\/div>","DefaultChoices":false,"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"ChoiceColumnWidthPixels":61,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Tutorial - Evaluation Task \u00a0 Great job! You have successfully understood the rules of Goofspiel a...","Choices":{"2":{"Display":"Alex"},"3":{"Display":"AP-5"}},"ChoiceOrder":["2","3"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":4,"Answers":{"1":{"Display":"Low Responsibility"},"2":{"Display":"Medium Responsibility"},"3":{"Display":"High Responsibility"}},"AnswerOrder":[1,"2","3"],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div style=\"text-align: center; width: 875px;\"><u><strong>Tutorial - Evaluation Task<\/strong><\/u><\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">Great job! You have successfully understood the rules of Goofspiel and counterfactuals. In the remainder of the study we will ask you to&nbsp;evaluate whether Alex and AP-5 have <em><strong>low<\/strong><\/em>, <em><strong>medium<\/strong><\/em>, or <em><strong>high<\/strong><\/em> responsibility for their team losing the game.&nbsp;We will also ask you how confident you are in your response. Below you can see an example of such questions.<\/div>\n\n<div>&nbsp;\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td colspan=\"2\">\n\t\t\t<div style=\"text-align: justify;\">Consider the game in the left figure where Team A lost, and the counterfactual game in the right figure which shows what would have happened had Alex played <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">2<\/span><\/span><\/strong> in <strong>round #3<\/strong>&nbsp;and had AP-5 played <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">9<\/span><\/span><\/strong> in <strong>round #4<\/strong>. Once you understand what happened in the two games, <strong>please answer the question below<\/strong>.<\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>\n\t\t\t<div style=\"text-align: center;\">Original game<\/div>\n\n\t\t\t<div style=\"text-align: center;\"><img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_Wik43pdVtcefyDB\" style=\"width: 350px; height: 438px;\" width=\"350\">&nbsp;<\/div>\n\t\t\t<\/td>\n\t\t\t<td>\n\t\t\t<div style=\"text-align: center;\">Counterfactual game<\/div>\n\n\t\t\t<div style=\"text-align: center;\">&nbsp;&nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_XImDAZ9HI0rK81X\" style=\"width: 350px; height: 438px;\" width=\"350\"><\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td colspan=\"2\" style=\"text-align: center;\"><br>\n\t\t\tRemember,&nbsp;<strong>the players see each others' cards<\/strong>.<br>\n\t\t\t&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">To what extent do you think Alex and AP-5 are responsible for their team losing the game? Please indicate the degree of their responsibility by selecting the appropriate choice below:<\/div>\n\n<div>&nbsp;<\/div>","DataExportTag":"tut-1cf-ag1-full-Q13","QuestionID":"QID1719390350"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390351","SecondaryAttribute":"How confident are you in your response?","TertiaryAttribute":null,"Payload":{"QuestionText":"How confident are you in your response?\n","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How confident are you in your response?","Choices":{"1":{"Display":"Low confidence"},"2":{"Display":"Medium confidence"},"3":{"Display":"High confidence"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"How confident are you in your response?\n","DataExportTag":"tut-1cf-ag1-full-Q14","QuestionID":"QID1719390351"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390352","SecondaryAttribute":"Now that you have completed the tutorial, we ask you to evaluate 5 different games and report you...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: left;\">Now that you have completed the tutorial, we ask you to evaluate 5 different games and report your opinion about the players' degrees of responsibility.&nbsp;We will also ask you how confident you are in your response.&nbsp;<\/div>\n\n<div>\n<table>\n<\/table>\n<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Now that you have completed the tutorial, we ask you to evaluate 5 different games and report you...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: left;\">Now that you have completed the tutorial, we ask you to evaluate 5 different games and report your opinion about the players' degrees of responsibility.&nbsp;We will also ask you how confident you are in your response.&nbsp;<\/div>\n\n<div>\n<table>\n<\/table>\n<\/div>","DataVisibility":{"Private":false,"Hidden":false},"DataExportTag":"tut-1cf-ag1-full-Q15","QuestionID":"QID1719390352"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390353","SecondaryAttribute":"\u200b\u200b\u200b\u200b\u200bTask Description \u00a0 In this study, you will be asked a series of questions about a te","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">\u200b\u200b\u200b\u200b\u200b<u><strong>Task Description<\/strong><\/u><\/div>\n&nbsp;\n\n<div style=\"text-align: justify;\">In this study, you will be asked a series of questions about a team-based card game. Specifically, you will be asked to evaluate the <em><strong>degree of responsibility<\/strong><\/em> exhibited by each player in a team that <strong><em>lost<\/em> <\/strong>in a card game.&nbsp;<br \/>\n<br \/>\nFor this purpose, we will consider a team-based variant of the Goofspiel card game, where two teams, Team A and Team B, compete against each other. Each team consists of a human player and an AI bot.<strong><em> Alex<\/em> <em>(human)<\/em><\/strong><em> <\/em>and <strong><em>AP-5 (AI)<\/em><\/strong><em><strong> <\/strong><\/em>play in <strong><em>Team A<\/em><\/strong>, while <strong><em>Billie<\/em><\/strong> <em><strong>(human) <\/strong><\/em>and <strong><em>BB-8<\/em><\/strong> <em><strong>(AI)<\/strong><\/em> play in <strong><em>Team B<\/em><\/strong>.<br \/>\n<br \/>\nWe will first ask you to complete a <em><strong>tutorial<\/strong><\/em>. This tutorial will have three parts:<\/div>\n\n<ol>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Goofspiel<\/em>: this part explains the rules of the Goofspiel card game.<\/li>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Counterfactuals<\/em>: this part explains counterfactual reasoning in Goofspiel.&nbsp;<\/li>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Evaluation Task<\/em>: this part provides an example of evaluation tasks that you will be asked to solve.<\/li>\n<\/ol>\n\n<div style=\"text-align: justify;\"><br \/>\nAfter completing the tutorial, you will be asked to evaluate 5 games. We will show you 5 Goofspiel games <em><strong>where Team A lost<\/strong><\/em>, and your task is to evaluate to what extent Alex and AP-5 are responsible for this outcome, that is, assess whether they have <strong><em>low<\/em><\/strong>, <strong><em>medium<\/em><\/strong>, or <strong><em>high<\/em><\/strong><strong> <\/strong>responsibility for Team A losing the game.&nbsp;We will also ask you how confident you are in your response.&nbsp;<br \/>\n<br \/>\n<em>Please note that all the games that you will see are illustrative examples, and they were not played by actual human-AI teams.<\/em><\/div>\n\n<div style=\"margin-left: 40px;\"><br type=\"_moz\" \/>\n&nbsp;<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u200b\u200b\u200b\u200b\u200bTask Description \u00a0 In this study, you will be asked a series of questions about a team-based...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\">\u200b\u200b\u200b\u200b\u200b<u><strong>Task Description<\/strong><\/u><\/div>\n&nbsp;\n\n<div style=\"text-align: justify;\">In this study, you will be asked a series of questions about a team-based card game. Specifically, you will be asked to evaluate the <em><strong>degree of responsibility<\/strong><\/em> exhibited by each player in a team that <strong><em>lost<\/em> <\/strong>in a card game.&nbsp;<br \/>\n<br \/>\nFor this purpose, we will consider a team-based variant of the Goofspiel card game, where two teams, Team A and Team B, compete against each other. Each team consists of a human player and an AI bot.<strong><em> Alex<\/em> <em>(human)<\/em><\/strong><em> <\/em>and <strong><em>AP-5 (AI)<\/em><\/strong><em><strong> <\/strong><\/em>play in <strong><em>Team A<\/em><\/strong>, while <strong><em>Billie<\/em><\/strong> <em><strong>(human) <\/strong><\/em>and <strong><em>BB-8<\/em><\/strong> <em><strong>(AI)<\/strong><\/em> play in <strong><em>Team B<\/em><\/strong>.<br \/>\n<br \/>\nWe will first ask you to complete a <em><strong>tutorial<\/strong><\/em>. This tutorial will have three parts:<\/div>\n\n<ol>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Goofspiel<\/em>: this part explains the rules of the Goofspiel card game.<\/li>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Counterfactuals<\/em>: this part explains counterfactual reasoning in Goofspiel.&nbsp;<\/li>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Evaluation Task<\/em>: this part provides an example of evaluation tasks that you will be asked to solve.<\/li>\n<\/ol>\n\n<div style=\"text-align: justify;\"><br \/>\nAfter completing the tutorial, you will be asked to evaluate 5 games. We will show you 5 Goofspiel games <em><strong>where Team A lost<\/strong><\/em>, and your task is to evaluate to what extent Alex and AP-5 are responsible for this outcome, that is, assess whether they have <strong><em>low<\/em><\/strong>, <strong><em>medium<\/em><\/strong>, or <strong><em>high<\/em><\/strong><strong> <\/strong>responsibility for Team A losing the game.&nbsp;We will also ask you how confident you are in your response.&nbsp;<br \/>\n<br \/>\n<em>Please note that all the games that you will see are illustrative examples, and they were not played by actual human-AI teams.<\/em><\/div>\n\n<div style=\"margin-left: 40px;\"><br type=\"_moz\" \/>\n&nbsp;<\/div>","DataExportTag":"tut-1cf-ag1-partl-Q1","QuestionID":"QID1719390353"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390354","SecondaryAttribute":"\u200b\u200b\u200b\u200b\u200bTutorial - Goofspiel \u00a0 To solve your tasks, you need to familiarize yourself with th","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">\u200b\u200b\u200b\u200b\u200b<u><strong>Tutorial - Goofspiel<\/strong><\/u><\/div>\n&nbsp;\n\n<div style=\"text-align: justify;\">To solve your tasks, you need to familiarize yourself with the rules of the team-based version of Goofspiel. The rules are as follows:<\/div>\n\n<ul>\n\t<li style=\"text-align: justify;\">At the beginning of the game, each player receives 5 cards from the standard 52 card deck - <strong>players do not see each others&#39; cards,<\/strong> but they are aware that any given player holds cards of only one suit.<\/li>\n\t<li style=\"text-align: justify;\">Additionally, a separate deck of cards is shuffled, called prize deck. The game proceeds in <em>rounds<\/em>. In each round, one prize card is drawn from the prize deck, and upon observing&nbsp;the prize&nbsp;card,&nbsp;the&nbsp;players simultaneously select one card from their hand. The team that plays cards with a higher sum&nbsp;wins the prize card, and the&nbsp;prize is added to the team&#39;s score. If&nbsp;the teams have equal sums, the prize card is discarded and the scores remain the same.<\/li>\n\t<li style=\"text-align: justify;\">The game finishes after round #5, and the team with&nbsp;the highest score wins. If the teams have equal score, then it&#39;s a draw.&nbsp;&nbsp;<\/li>\n<\/ul>\n\n<div>\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" height=\"630\" width=\"723\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>\n\t\t\t<div style=\"text-align: justify;\"><strong>Example 1<\/strong>: We explain how games are represented using the game below.&nbsp;The&nbsp;<em>rounds <\/em>are<em> <\/em>represented as circles: the first round (round #1) is&nbsp;on the outermost circle, while the last round (round #5)&nbsp;is on the innermost circle. The cards that players played in the game are shown in the <span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">grey boxes<\/span><\/span>. The prize cards are shown in the <span style=\"color:#000000;\"><span style=\"background-color:#e6d70b;\">yellow boxes<\/span><\/span>.<\/div>\n\n\t\t\t<div>&nbsp;<\/div>\n\n\t\t\t<div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_2Bo95zy0fCWG473\" style=\"height: 438px; width: 350px;\" width=\"350\" \/><\/div>\n\n\t\t\t<div>&nbsp;<\/div>\n\n\t\t\t<div style=\"text-align: justify;\">In this example, all players initially received&nbsp;cards 3, 4, 5, 6, and 7 (round #1). Note that in general players do not have to receive the same cards. In the first round (round #1), <span style=\"text-size-adjust: 100%;\">prize card&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#e6d70b;\">3<\/span><\/span><\/strong>&nbsp;was drawn from the prize deck,&nbsp;<\/span>both Alex and AP-5 played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">3<\/span><\/span><\/strong>, Billie played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">4<\/span><\/span><\/strong>, and BB-8 <span style=\"text-size-adjust: 100%;\">played card <\/span><strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">5<\/span><\/span><\/strong><span style=\"text-size-adjust: 100%;\">.&nbsp;<\/span>Team B won the prize card&nbsp;<strong><span style=\"color:#000000;\"><span style=\"text-size-adjust: 100%;\"><span style=\"background-color:#e6d70b;\">3<\/span><\/span><\/span><\/strong>: Team A played cards whose sum is 6, and Team B played cards whose sum is 9.<br \/>\n\t\t\t<br \/>\n\t\t\tTeam A won the prize cards in round #2 and round #4, achieving the score of <strong><span style=\"color:#ffffff;\"><span style=\"background-color:#420516;\">11<\/span><\/span><\/strong>. Team B won all the other prizes, achieving the score of <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#420516;\">14<\/span><\/strong><\/span>. Hence, Team B won the game, which is depicted by the <span style=\"color:#420516;\"><strong>red scoreboard<\/strong><\/span>.<\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<\/div>\n\n<p align=\"justify\" dir=\"ltr\"><br \/>\nNow that you are familiar with the rules of Goofspiel and the game representation, we ask you to answer the questions below.&nbsp;&nbsp;<br \/>\n&nbsp;<\/p>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u200b\u200b\u200b\u200b\u200bTutorial - Goofspiel \u00a0 To solve your tasks, you need to familiarize yourself with the rules...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\">\u200b\u200b\u200b\u200b\u200b<u><strong>Tutorial - Goofspiel<\/strong><\/u><\/div>\n&nbsp;\n\n<div style=\"text-align: justify;\">To solve your tasks, you need to familiarize yourself with the rules of the team-based version of Goofspiel. The rules are as follows:<\/div>\n\n<ul>\n\t<li style=\"text-align: justify;\">At the beginning of the game, each player receives 5 cards from the standard 52 card deck - <strong>players do not see each others&#39; cards,<\/strong> but they are aware that any given player holds cards of only one suit.<\/li>\n\t<li style=\"text-align: justify;\">Additionally, a separate deck of cards is shuffled, called prize deck. The game proceeds in <em>rounds<\/em>. In each round, one prize card is drawn from the prize deck, and upon observing&nbsp;the prize&nbsp;card,&nbsp;the&nbsp;players simultaneously select one card from their hand. The team that plays cards with a higher sum&nbsp;wins the prize card, and the&nbsp;prize is added to the team&#39;s score. If&nbsp;the teams have equal sums, the prize card is discarded and the scores remain the same.<\/li>\n\t<li style=\"text-align: justify;\">The game finishes after round #5, and the team with&nbsp;the highest score wins. If the teams have equal score, then it&#39;s a draw.&nbsp;&nbsp;<\/li>\n<\/ul>\n\n<div>\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" height=\"630\" width=\"723\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>\n\t\t\t<div style=\"text-align: justify;\"><strong>Example 1<\/strong>: We explain how games are represented using the game below.&nbsp;The&nbsp;<em>rounds <\/em>are<em> <\/em>represented as circles: the first round (round #1) is&nbsp;on the outermost circle, while the last round (round #5)&nbsp;is on the innermost circle. The cards that players played in the game are shown in the <span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">grey boxes<\/span><\/span>. The prize cards are shown in the <span style=\"color:#000000;\"><span style=\"background-color:#e6d70b;\">yellow boxes<\/span><\/span>.<\/div>\n\n\t\t\t<div>&nbsp;<\/div>\n\n\t\t\t<div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_2Bo95zy0fCWG473\" style=\"height: 438px; width: 350px;\" width=\"350\" \/><\/div>\n\n\t\t\t<div>&nbsp;<\/div>\n\n\t\t\t<div style=\"text-align: justify;\">In this example, all players initially received&nbsp;cards 3, 4, 5, 6, and 7 (round #1). Note that in general players do not have to receive the same cards. In the first round (round #1), <span style=\"text-size-adjust: 100%;\">prize card&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#e6d70b;\">3<\/span><\/span><\/strong>&nbsp;was drawn from the prize deck,&nbsp;<\/span>both Alex and AP-5 played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">3<\/span><\/span><\/strong>, Billie played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">4<\/span><\/span><\/strong>, and BB-8 <span style=\"text-size-adjust: 100%;\">played card <\/span><strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">5<\/span><\/span><\/strong><span style=\"text-size-adjust: 100%;\">.&nbsp;<\/span>Team B won the prize card&nbsp;<strong><span style=\"color:#000000;\"><span style=\"text-size-adjust: 100%;\"><span style=\"background-color:#e6d70b;\">3<\/span><\/span><\/span><\/strong>: Team A played cards whose sum is 6, and Team B played cards whose sum is 9.<br \/>\n\t\t\t<br \/>\n\t\t\tTeam A won the prize cards in round #2 and round #4, achieving the score of <strong><span style=\"color:#ffffff;\"><span style=\"background-color:#420516;\">11<\/span><\/span><\/strong>. Team B won all the other prizes, achieving the score of <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#420516;\">14<\/span><\/strong><\/span>. Hence, Team B won the game, which is depicted by the <span style=\"color:#420516;\"><strong>red scoreboard<\/strong><\/span>.<\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<\/div>\n\n<p align=\"justify\" dir=\"ltr\"><br \/>\nNow that you are familiar with the rules of Goofspiel and the game representation, we ask you to answer the questions below.&nbsp;&nbsp;<br \/>\n&nbsp;<\/p>","DataExportTag":"tut-1cf-ag1-partl-Q2","QuestionID":"QID1719390354"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390355","SecondaryAttribute":"In Example 1, what card did AP-5 play in round #2?\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"In Example 1, what card did <strong>AP-5<\/strong> play in <strong>round #2<\/strong>?&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In Example 1, what card did AP-5 play in round #2?\u00a0","Choices":{"4":{"Display":"3"},"5":{"Display":"4"},"6":{"Display":"5"},"7":{"Display":"6"},"10":{"Display":"7"}},"ChoiceOrder":["4","5","6","7","10"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390355\/SelectableChoice\/10","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In Example 1, what card did AP-5 play in round #2?&nbsp;<\/span> <span class=\"LeftOpDesc\">7<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390355\/SelectableChoice\/10","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390355","QuestionIDFromLocator":"QID1719390355","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":13,"NextAnswerId":1,"QuestionText_Unsafe":"In Example 1, what card did <strong>AP-5<\/strong> play in <strong>round #2<\/strong>?&nbsp;","DataExportTag":"tut-1cf-ag1-partl-Q3","QuestionID":"QID1719390355"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390356","SecondaryAttribute":"In Example 1, what was the prize in round #3?","TertiaryAttribute":null,"Payload":{"QuestionText":"In Example 1, what was the prize in <strong>round #3<\/strong>?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In Example 1, what was the prize in round #3?","Choices":{"4":{"Display":"3"},"5":{"Display":"4"},"6":{"Display":"5"},"7":{"Display":"6"},"8":{"Display":"7"}},"ChoiceOrder":["4","5","6","7","8"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390356\/SelectableChoice\/8","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In Example 1, what was the prize in round #3?<\/span> <span class=\"LeftOpDesc\">7<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390356\/SelectableChoice\/8","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390356","QuestionIDFromLocator":"QID1719390356","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":1,"SubSelector":"TX","QuestionText_Unsafe":"In Example 1, what was the prize in <strong>round #3<\/strong>?","DataExportTag":"tut-1cf-ag1-partl-Q4","QuestionID":"QID1719390356"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390357","SecondaryAttribute":"In Example 1, which team won the prize in round #4?","TertiaryAttribute":null,"Payload":{"QuestionText":"In Example 1, which team won the prize in <strong>round #4<\/strong>?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In Example 1, which team won the prize in round #4?","Choices":{"4":{"Display":"Team A"},"5":{"Display":"Team B"}},"ChoiceOrder":["4","5"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390357\/SelectableChoice\/4","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In Example 1, which team won the prize in round #4?<\/span> <span class=\"LeftOpDesc\">Team A<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390357\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390357","QuestionIDFromLocator":"QID1719390357","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":5,"QuestionText_Unsafe":"In Example 1, which team won the prize in <strong>round #4<\/strong>?","DataExportTag":"tut-1cf-ag1-partl-Q5","QuestionID":"QID1719390357"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390358","SecondaryAttribute":"Tutorial - Counterfactuals \u00a0\u00a0 To solve your tasks, you also need to familiarize yourself with cou.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div dir=\"ltr\" style=\"display: block;>\n\n<p style=\">\n<div style=\"text-align: center; width: 875px;\"><u><strong>Tutorial - Counterfactuals<\/strong><\/u><\/div>\n\n<p>&nbsp;&nbsp;<\/p>\n\n<div style=\"text-align: justify; width: 875px;\">To solve your tasks, you also need to familiarize yourself with <em>counterfactuals<\/em>.&nbsp;In this task, <em><strong>counterfactual games<\/strong><\/em> show what would have happened had the players played their cards differently. We continue with the previous example to explain counterfactual games.<\/div>\n\n<p dir=\"ltr\">&nbsp;<\/p>\n\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n <tbody>\n  <tr>\n   <td colspan=\"2\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 1 (continued)<\/strong>: We have seen that in this example Team A lost (<em>the left figure below<\/em>). However, consider the following question:&nbsp;<span style=\"text-align: center;\"> <\/span><br>\n   &nbsp;<\/p>\n\n   <p dir=\"ltr\" style=\"text-align: center;\"><em>What would have happened had AP-5 played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong><em> in<\/em><em><strong> round #2<\/strong>?<\/em><br>\n   &nbsp;<\/p>\n\n   <p align=\"justify\" dir=\"ltr\">Clearly, nothing would have changed in <em>round #1<\/em>. However, the <strong>cards<\/strong> the players would have played in <strong>round&nbsp;#3<\/strong>, <strong>round #4<\/strong>, and <strong>round #5<\/strong>, can be <strong>different from<\/strong> those that are originally played. The <strong>right figure<\/strong> below shows a <strong>counterfactual game<\/strong>. The differences compared to the original game in the left figure are:<\/p>\n\n   <ul dir=\"ltr\">\n    <li style=\"text-align: justify;\">In <em>round #2<\/em>, we imagine that AP-5 had played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong> instead of card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">7<\/span><\/span><\/strong>.<\/li>\n    <li style=\"text-align: justify;\">In <em>round&nbsp;#3<\/em>, <em>round #4<\/em>, and <em>round&nbsp;#5<\/em>, we imagine that all the players had responded to this change and had played cards in<strong> <\/strong><span style=\"color:#000000;\"><span style=\"background-color:#ffb38a;\">light orange<\/span><\/span><strong><span style=\"color:#d55e00;\"> <\/span><\/strong>boxes<span style=\"color:#000000;\">.<\/span><strong> <\/strong><\/li>\n    <li style=\"text-align: justify;\">Team A wins the counterfactual game, which is depicted by the <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#009e73;\">green scoreboard<\/span><\/strong><\/span><span style=\"color:#000000;\">.<\/span><\/li>\n   <\/ul>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center;\">The original game in Example 1&nbsp; &nbsp;<br>\n   <br>\n   &nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_2Bo95zy0fCWG473\" style=\"height: 438px; width: 350px;\" width=\"350\"><\/td>\n   <td style=\"text-align: center;\">Counterfactual game<br>\n   (had AP-5 played <span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span> in round #2)<br>\n   &nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_dV6DprmriLkQHjO\" style=\"height: 438px; width: 350px;\" width=\"350\"><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n\n<div style=\"width: 100%; text-align: justify; width: 875px;\"><br>\nNow that you are familiar with counterfactual games, we ask you to take a look at <em>another example<\/em>, and answer the questions below.&nbsp;<br>\n&nbsp;\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n <tbody>\n  <tr>\n   <td colspan=\"2\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 2<\/strong>: Please take a look at another game below, and one of its counterfactual games. Once you understand what happened in the counterfactual game, <strong>please answer the questions below<\/strong>.<\/p>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center;\">The original game in Example 2<br>\n   <br>\n   &nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_4E76y7AKw82EDb4\" style=\"height: 438px; width: 350px;\" width=\"350\"><\/td>\n   <td style=\"text-align: center;\"><span style=\"text-align: center;\">Counterfactual game<br>\n   (had&nbsp;AP-5&nbsp;played <\/span><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><span style=\"text-align: center;\"> in round #1)<\/span><br>\n   &nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_OAVahJzEB5tNrAV\" style=\"height: 438px; width: 350px;\" width=\"350\"><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n<\/div>\n<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Tutorial - Counterfactuals \u00a0\u00a0 To solve your tasks, you also need to familiarize yourself with cou...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div dir=\"ltr\" style=\"display: block;>\n\n<p style=\">\n<div style=\"text-align: center; width: 875px;\"><u><strong>Tutorial - Counterfactuals<\/strong><\/u><\/div>\n\n<p>&nbsp;&nbsp;<\/p>\n\n<div style=\"text-align: justify; width: 875px;\">To solve your tasks, you also need to familiarize yourself with <em>counterfactuals<\/em>.&nbsp;In this task, <em><strong>counterfactual games<\/strong><\/em> show what would have happened had the players played their cards differently. We continue with the previous example to explain counterfactual games.<\/div>\n\n<p dir=\"ltr\">&nbsp;<\/p>\n\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n <tbody>\n  <tr>\n   <td colspan=\"2\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 1 (continued)<\/strong>: We have seen that in this example Team A lost (<em>the left figure below<\/em>). However, consider the following question:&nbsp;<span style=\"text-align: center;\"> <\/span><br>\n   &nbsp;<\/p>\n\n   <p dir=\"ltr\" style=\"text-align: center;\"><em>What would have happened had AP-5 played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong><em> in<\/em><em><strong> round #2<\/strong>?<\/em><br>\n   &nbsp;<\/p>\n\n   <p align=\"justify\" dir=\"ltr\">Clearly, nothing would have changed in <em>round #1<\/em>. However, the <strong>cards<\/strong> the players would have played in <strong>round&nbsp;#3<\/strong>, <strong>round #4<\/strong>, and <strong>round #5<\/strong>, can be <strong>different from<\/strong> those that are originally played. The <strong>right figure<\/strong> below shows a <strong>counterfactual game<\/strong>. The differences compared to the original game in the left figure are:<\/p>\n\n   <ul dir=\"ltr\">\n    <li style=\"text-align: justify;\">In <em>round #2<\/em>, we imagine that AP-5 had played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong> instead of card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">7<\/span><\/span><\/strong>.<\/li>\n    <li style=\"text-align: justify;\">In <em>round&nbsp;#3<\/em>, <em>round #4<\/em>, and <em>round&nbsp;#5<\/em>, we imagine that all the players had responded to this change and had played cards in<strong> <\/strong><span style=\"color:#000000;\"><span style=\"background-color:#ffb38a;\">light orange<\/span><\/span><strong><span style=\"color:#d55e00;\"> <\/span><\/strong>boxes<span style=\"color:#000000;\">.<\/span><strong> <\/strong><\/li>\n    <li style=\"text-align: justify;\">Team A wins the counterfactual game, which is depicted by the <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#009e73;\">green scoreboard<\/span><\/strong><\/span><span style=\"color:#000000;\">.<\/span><\/li>\n   <\/ul>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center;\">The original game in Example 1&nbsp; &nbsp;<br>\n   <br>\n   &nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_2Bo95zy0fCWG473\" style=\"height: 438px; width: 350px;\" width=\"350\"><\/td>\n   <td style=\"text-align: center;\">Counterfactual game<br>\n   (had AP-5 played <span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span> in round #2)<br>\n   &nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_dV6DprmriLkQHjO\" style=\"height: 438px; width: 350px;\" width=\"350\"><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n\n<div style=\"width: 100%; text-align: justify; width: 875px;\"><br>\nNow that you are familiar with counterfactual games, we ask you to take a look at <em>another example<\/em>, and answer the questions below.&nbsp;<br>\n&nbsp;\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n <tbody>\n  <tr>\n   <td colspan=\"2\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 2<\/strong>: Please take a look at another game below, and one of its counterfactual games. Once you understand what happened in the counterfactual game, <strong>please answer the questions below<\/strong>.<\/p>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center;\">The original game in Example 2<br>\n   <br>\n   &nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_4E76y7AKw82EDb4\" style=\"height: 438px; width: 350px;\" width=\"350\"><\/td>\n   <td style=\"text-align: center;\"><span style=\"text-align: center;\">Counterfactual game<br>\n   (had&nbsp;AP-5&nbsp;played <\/span><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><span style=\"text-align: center;\"> in round #1)<\/span><br>\n   &nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_OAVahJzEB5tNrAV\" style=\"height: 438px; width: 350px;\" width=\"350\"><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n<\/div>\n<\/div>","DataExportTag":"tut-1cf-ag1-partl-Q6","QuestionID":"QID1719390358"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390359","SecondaryAttribute":"In the counterfactual game\u00a0in Example 2, what card did AP-5\u00a0play in round #1?","TertiaryAttribute":null,"Payload":{"QuestionText":"In the <strong>counterfactual game<\/strong>&nbsp;in Example 2, what card did <strong>AP-5<\/strong>&nbsp;play in <strong>round #1<\/strong>?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In the counterfactual game\u00a0in Example 2, what card did AP-5\u00a0play in round #1?","Choices":{"4":{"Display":"3"},"5":{"Display":"4"},"6":{"Display":"5"},"7":{"Display":"6"},"8":{"Display":"7"}},"ChoiceOrder":["4","5","6","7","8"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390359\/SelectableChoice\/5","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In the counterfactual game&nbsp;in Example 2, what card did AP-5&nbsp;play in round #1?<\/span> <span class=\"LeftOpDesc\">4<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390359\/SelectableChoice\/5","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390359","QuestionIDFromLocator":"QID1719390359","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":3,"SubSelector":"TX","QuestionText_Unsafe":"In the <strong>counterfactual game<\/strong>&nbsp;in Example 2, what card did <strong>AP-5<\/strong>&nbsp;play in <strong>round #1<\/strong>?","DataExportTag":"tut-1cf-ag1-partl-Q7","QuestionID":"QID1719390359"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390360","SecondaryAttribute":"In the counterfactual game\u00a0in Example 2, what card did AP-5 play in round #4?","TertiaryAttribute":null,"Payload":{"QuestionText":"In the <strong>counterfactual game<\/strong>&nbsp;in Example 2, what card did <strong>AP-5<\/strong> play in <strong>round #4<\/strong>?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In the counterfactual game\u00a0in Example 2, what card did AP-5 play in round #4?","Choices":{"4":{"Display":"3"},"5":{"Display":"4"},"6":{"Display":"5"},"7":{"Display":"6"},"8":{"Display":"7"}},"ChoiceOrder":["4","5","6","7","8"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390360\/SelectableChoice\/8","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In the counterfactual game&nbsp;in Example 2, what card did AP-5 play in round #4?<\/span> <span class=\"LeftOpDesc\">7<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390360\/SelectableChoice\/8","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390360","QuestionIDFromLocator":"QID1719390360","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":3,"SubSelector":"TX","QuestionText_Unsafe":"In the <strong>counterfactual game<\/strong>&nbsp;in Example 2, what card did <strong>AP-5<\/strong> play in <strong>round #4<\/strong>?","DataExportTag":"tut-1cf-ag1-partl-Q8","QuestionID":"QID1719390360"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390361","SecondaryAttribute":"Which team won in the counterfactual game in Example 2?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which team won in the <strong>counterfactual game<\/strong> in Example 2?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Which team won in the counterfactual game in Example 2?","Choices":{"4":{"Display":"Team A"},"5":{"Display":"Team B"}},"ChoiceOrder":["4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390361\/SelectableChoice\/5","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Which team won in the counterfactual game in Example 2?<\/span> <span class=\"LeftOpDesc\">Team B<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390361\/SelectableChoice\/5","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390361","QuestionIDFromLocator":"QID1719390361","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"ConsentValidation","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_jqKs0Bmu1t5aFwh","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionText_Unsafe":"Which team won in the <strong>counterfactual game<\/strong> in Example 2?","DataExportTag":"tut-1cf-ag1-partl-Q9","QuestionID":"QID1719390361"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390362","SecondaryAttribute":"Tutorial - Counterfactuals \u00a0 Counterfactual games can be based on more complex scenarios. We cont..","TertiaryAttribute":null,"Payload":{"QuestionText":"<p dir=\"ltr\" style=\"text-align: center; width:960px;\"><u><strong>Tutorial - Counterfactuals<\/strong><\/u><\/p>\n\n<p dir=\"ltr\">&nbsp;<\/p>\n\n<p align=\"justify\" dir=\"ltr\" style=\"width:960px;\">Counterfactual games can be based on more complex scenarios. We continue with the previous example to demonstrate this.<\/p>\n\n<div style=\"text-align: center; width:960px;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<\/div>\n\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:960px;\">\n <tbody>\n  <tr>\n   <td colspan=\"3\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 2 (continued)<\/strong>:&nbsp;We have seen that in this example&nbsp;Team A would not have won had AP-5 played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong> in <strong>round 1&nbsp;<\/strong>(<em>the middle figure below<\/em>). However, we can also ask:<br \/>\n   &nbsp;<\/p>\n\n   <p dir=\"ltr\" style=\"text-align: center;\"><em>What would have happened had AP-5&nbsp;played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong><em> in <\/em><em><strong>round #1<\/strong>&nbsp;and had Alex&nbsp;played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong><em> <\/em><em>in <strong>r<\/strong><\/em><strong>ound #2<\/strong><em>?<\/em><\/p>\n\n   <p align=\"justify\" dir=\"ltr\"><br \/>\n   This yields a <strong>new counterfactual <\/strong>game depicted in the <strong>right figure<\/strong> below. The differences compared to the <em>previous&nbsp;counterfactual game<\/em> in the middle&nbsp;figure are:<\/p>\n\n   <ul dir=\"ltr\">\n    <li style=\"text-align: justify;\">In <em>round #2<\/em>, we imagine that Alex had played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong> instead of card <strong><span style=\"color:#000000;\"><span style=\"background-color:#ffb38a;\">5<\/span><\/span><\/strong>.<\/li>\n    <li style=\"text-align: justify;\">In <em>round #3<\/em>, we imagine that all the players had responded to the two changes (<strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span> <\/strong>and <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong>) and had played cards in <span style=\"color:#000000;\"><span style=\"background-color:#ff6700;\">dark orange<\/span><\/span><span style=\"color:#ff6700;\"> <\/span>boxes.&nbsp;<\/li>\n    <li style=\"text-align: justify;\">Team A wins, which is depicted by the <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#009e73;\">green scoreboard<\/span><\/strong><\/span><span style=\"color:#000000;\">.<\/span><\/li>\n   <\/ul>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center; width:32%;\">The original game in Example 2<br \/>\n   <br \/>\n   <br \/>\n   <img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_4E76y7AKw82EDb4\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n   <td style=\"text-align: center; width:32%;\">Previous counterfactual game<br \/>\n   (had AP-5&nbsp;played<strong>&nbsp;<span style=\"color:#000000;\"><span style=\"background-color:#a8e68d\">4<\/span><\/span><\/strong>&nbsp;in round #1)&nbsp;<br \/>\n   <br \/>\n   <img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_OAVahJzEB5tNrAV\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n   <td style=\"text-align: center; width:36%;\"><strong>New counterfactual game <\/strong><br \/>\n   (had AP-5 played&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong>&nbsp;in round #1&nbsp;and<br \/>\n   had Alex&nbsp;played&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong>&nbsp;in round #2) <img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_ugA9tw07DzpATlX\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Tutorial - Counterfactuals \u00a0 Counterfactual games can be based on more complex scenarios. We cont...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionText_Unsafe":"<p dir=\"ltr\" style=\"text-align: center; width:960px;\"><u><strong>Tutorial - Counterfactuals<\/strong><\/u><\/p>\n\n<p dir=\"ltr\">&nbsp;<\/p>\n\n<p align=\"justify\" dir=\"ltr\" style=\"width:960px;\">Counterfactual games can be based on more complex scenarios. We continue with the previous example to demonstrate this.<\/p>\n\n<div style=\"text-align: center; width:960px;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<\/div>\n\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:960px;\">\n <tbody>\n  <tr>\n   <td colspan=\"3\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 2 (continued)<\/strong>:&nbsp;We have seen that in this example&nbsp;Team A would not have won had AP-5 played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong> in <strong>round 1&nbsp;<\/strong>(<em>the middle figure below<\/em>). However, we can also ask:<br \/>\n   &nbsp;<\/p>\n\n   <p dir=\"ltr\" style=\"text-align: center;\"><em>What would have happened had AP-5&nbsp;played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong><em> in <\/em><em><strong>round #1<\/strong>&nbsp;and had Alex&nbsp;played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong><em> <\/em><em>in <strong>r<\/strong><\/em><strong>ound #2<\/strong><em>?<\/em><\/p>\n\n   <p align=\"justify\" dir=\"ltr\"><br \/>\n   This yields a <strong>new counterfactual <\/strong>game depicted in the <strong>right figure<\/strong> below. The differences compared to the <em>previous&nbsp;counterfactual game<\/em> in the middle&nbsp;figure are:<\/p>\n\n   <ul dir=\"ltr\">\n    <li style=\"text-align: justify;\">In <em>round #2<\/em>, we imagine that Alex had played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong> instead of card <strong><span style=\"color:#000000;\"><span style=\"background-color:#ffb38a;\">5<\/span><\/span><\/strong>.<\/li>\n    <li style=\"text-align: justify;\">In <em>round #3<\/em>, we imagine that all the players had responded to the two changes (<strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span> <\/strong>and <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong>) and had played cards in <span style=\"color:#000000;\"><span style=\"background-color:#ff6700;\">dark orange<\/span><\/span><span style=\"color:#ff6700;\"> <\/span>boxes.&nbsp;<\/li>\n    <li style=\"text-align: justify;\">Team A wins, which is depicted by the <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#009e73;\">green scoreboard<\/span><\/strong><\/span><span style=\"color:#000000;\">.<\/span><\/li>\n   <\/ul>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center; width:32%;\">The original game in Example 2<br \/>\n   <br \/>\n   <br \/>\n   <img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_4E76y7AKw82EDb4\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n   <td style=\"text-align: center; width:32%;\">Previous counterfactual game<br \/>\n   (had AP-5&nbsp;played<strong>&nbsp;<span style=\"color:#000000;\"><span style=\"background-color:#a8e68d\">4<\/span><\/span><\/strong>&nbsp;in round #1)&nbsp;<br \/>\n   <br \/>\n   <img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_OAVahJzEB5tNrAV\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n   <td style=\"text-align: center; width:36%;\"><strong>New counterfactual game <\/strong><br \/>\n   (had AP-5 played&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong>&nbsp;in round #1&nbsp;and<br \/>\n   had Alex&nbsp;played&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong>&nbsp;in round #2) <img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_ugA9tw07DzpATlX\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>","DataExportTag":"tut-1cf-ag1-partl-10","QuestionID":"QID1719390362"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390363","SecondaryAttribute":"In the new counterfactual game in Example 2, what card did AP-5 play in round #1?","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: justify; width:960px;\">In the <strong>new counterfactual game<\/strong> in Example 2, what card did <strong>AP-5<\/strong> play in <strong>round #1<\/strong>?<\/div>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In the new counterfactual game in Example 2, what card did AP-5 play in round #1?","Choices":{"10":{"Display":"3"},"11":{"Display":"4"},"12":{"Display":"5"},"13":{"Display":"6"},"14":{"Display":"7"}},"ChoiceOrder":["10","11","12","13","14"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390363\/SelectableChoice\/11","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In the new counterfactual game in Example 2, what card did AP-5 play in round #1?<\/span> <span class=\"LeftOpDesc\">4<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390363\/SelectableChoice\/11","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390363","QuestionIDFromLocator":"QID1719390363","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"SubSelector":"TX","QuestionText_Unsafe":"<div style=\"text-align: justify; width:960px;\">In the <strong>new counterfactual game<\/strong> in Example 2, what card did <strong>AP-5<\/strong> play in <strong>round #1<\/strong>?<\/div>","DataExportTag":"tut-1cf-ag1-partl-11","QuestionID":"QID1719390363"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390364","SecondaryAttribute":"In\u00a0Example 2, did Alex play the same card in\u00a0round #2\u00a0of\u00a0the new counterfactual game and as in\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: justify; width:960px;\">In&nbsp;Example 2, did <strong>Alex<\/strong> play the same card in&nbsp;<strong>round #2<\/strong>&nbsp;of&nbsp;<strong>the new counterfactual game<\/strong> and as in&nbsp;<strong>round #2<\/strong>&nbsp;of&nbsp;<strong>the original game<\/strong>?<\/div>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In\u00a0Example 2, did Alex play the same card in\u00a0round #2\u00a0of\u00a0the new counterfactual game and as in\u00a0ro...","Choices":{"7":{"Display":"Yes"},"8":{"Display":"No"}},"ChoiceOrder":["7","8"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390364\/SelectableChoice\/8","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In&nbsp;Example 2, did Alex play the same card in&nbsp;round #2&nbsp;of&nbsp;the new counterfactual game and as in&nbsp;ro...<\/span> <span class=\"LeftOpDesc\">No<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390364\/SelectableChoice\/8","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390364","QuestionIDFromLocator":"QID1719390364","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: justify; width:960px;\">In&nbsp;Example 2, did <strong>Alex<\/strong> play the same card in&nbsp;<strong>round #2<\/strong>&nbsp;of&nbsp;<strong>the new counterfactual game<\/strong> and as in&nbsp;<strong>round #2<\/strong>&nbsp;of&nbsp;<strong>the original game<\/strong>?<\/div>","DataExportTag":"tut-1cf-ag1-partl-12","QuestionID":"QID1719390364"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390365","SecondaryAttribute":"Tutorial - Evaluation Task \u00a0 Great job! You have successfully understood the rules of Goofspiel a..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center; width: 875px;\"><u><strong>Tutorial - Evaluation Task<\/strong><\/u><\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">Great job! You have successfully understood the rules of Goofspiel and counterfactuals. In the remainder of the study we will ask you to&nbsp;evaluate whether Alex and AP-5 have <em><strong>low<\/strong><\/em>, <em><strong>medium<\/strong><\/em>, or <em><strong>high<\/strong><\/em> responsibility for their team losing the game.&nbsp;We will also ask you how confident you are in your response. Below you can see an example of such questions.<\/div>\n\n<div>&nbsp;\n<table style=\"width:875px;\" cellspacing=\"1\" cellpadding=\"10\" border=\"1\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td colspan=\"2\">\n\t\t\t<div style=\"text-align: justify;\">Consider the game in the left figure where Team A lost, and the counterfactual game in the right figure which shows what would have happened had Alex played <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">2<\/span><\/span><\/strong> in <strong>round #3<\/strong>&nbsp;and had AP-5 played <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">9<\/span><\/span><\/strong> in <strong>round #4<\/strong>. Once you understand what happened in the two games, <strong>please answer the question below<\/strong>.<\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>\n\t\t\t<div style=\"text-align: center;\">Original game<\/div>\n\n\t\t\t<div style=\"text-align: center;\"><img width=\"350\" style=\"width: 350px; height: 438px;\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_Wik43pdVtcefyDB\" height=\"438\">&nbsp;<\/div>\n\t\t\t<\/td>\n\t\t\t<td>\n\t\t\t<div style=\"text-align: center;\">Counterfactual game<\/div>\n\n\t\t\t<div style=\"text-align: center;\">&nbsp;&nbsp;<img width=\"350\" style=\"width: 350px; height: 438px;\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_XImDAZ9HI0rK81X\" height=\"438\"><\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\" colspan=\"2\"><br>\n\t\t\tRemember, while we can see all the cards, <strong>the players can't see each others' cards<\/strong>.<br>\n\t\t\t&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">To what extent do you think Alex and AP-5 are responsible for their team losing the game? Please indicate the degree of their responsibility by selecting the appropriate choice below:<\/div>\n\n<div>&nbsp;<\/div>","DefaultChoices":false,"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"ChoiceColumnWidthPixels":61,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Tutorial - Evaluation Task \u00a0 Great job! You have successfully understood the rules of Goofspiel a...","Choices":{"2":{"Display":"Alex"},"3":{"Display":"AP-5"}},"ChoiceOrder":["2","3"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":4,"Answers":{"1":{"Display":"Low Responsibility"},"2":{"Display":"Medium Responsibility"},"3":{"Display":"High Responsibility"}},"AnswerOrder":[1,"2","3"],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div style=\"text-align: center; width: 875px;\"><u><strong>Tutorial - Evaluation Task<\/strong><\/u><\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">Great job! You have successfully understood the rules of Goofspiel and counterfactuals. In the remainder of the study we will ask you to&nbsp;evaluate whether Alex and AP-5 have <em><strong>low<\/strong><\/em>, <em><strong>medium<\/strong><\/em>, or <em><strong>high<\/strong><\/em> responsibility for their team losing the game.&nbsp;We will also ask you how confident you are in your response. Below you can see an example of such questions.<\/div>\n\n<div>&nbsp;\n<table style=\"width:875px;\" cellspacing=\"1\" cellpadding=\"10\" border=\"1\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td colspan=\"2\">\n\t\t\t<div style=\"text-align: justify;\">Consider the game in the left figure where Team A lost, and the counterfactual game in the right figure which shows what would have happened had Alex played <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">2<\/span><\/span><\/strong> in <strong>round #3<\/strong>&nbsp;and had AP-5 played <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">9<\/span><\/span><\/strong> in <strong>round #4<\/strong>. Once you understand what happened in the two games, <strong>please answer the question below<\/strong>.<\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>\n\t\t\t<div style=\"text-align: center;\">Original game<\/div>\n\n\t\t\t<div style=\"text-align: center;\"><img width=\"350\" style=\"width: 350px; height: 438px;\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_Wik43pdVtcefyDB\" height=\"438\">&nbsp;<\/div>\n\t\t\t<\/td>\n\t\t\t<td>\n\t\t\t<div style=\"text-align: center;\">Counterfactual game<\/div>\n\n\t\t\t<div style=\"text-align: center;\">&nbsp;&nbsp;<img width=\"350\" style=\"width: 350px; height: 438px;\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_XImDAZ9HI0rK81X\" height=\"438\"><\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\" colspan=\"2\"><br>\n\t\t\tRemember, while we can see all the cards, <strong>the players can't see each others' cards<\/strong>.<br>\n\t\t\t&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">To what extent do you think Alex and AP-5 are responsible for their team losing the game? Please indicate the degree of their responsibility by selecting the appropriate choice below:<\/div>\n\n<div>&nbsp;<\/div>","DataExportTag":"Q13","QuestionID":"QID1719390365"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390366","SecondaryAttribute":"How confident are you in your response?","TertiaryAttribute":null,"Payload":{"QuestionText":"How confident are you in your response?\n","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How confident are you in your response?","Choices":{"1":{"Display":"Low confidence"},"2":{"Display":"Medium confidence"},"3":{"Display":"High confidence"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"How confident are you in your response?\n","DataExportTag":"Q14","QuestionID":"QID1719390366"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390367","SecondaryAttribute":"Now that you have completed the tutorial, we ask you to evaluate 5 different games and report you...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: left;\">Now that you have completed the tutorial, we ask you to evaluate 5 different games and report your opinion about the players' degrees of responsibility.&nbsp;We will also ask you how confident you are in your response.&nbsp;<\/div>\n\n<div>\n<table>\n<\/table>\n<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Now that you have completed the tutorial, we ask you to evaluate 5 different games and report you...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: left;\">Now that you have completed the tutorial, we ask you to evaluate 5 different games and report your opinion about the players' degrees of responsibility.&nbsp;We will also ask you how confident you are in your response.&nbsp;<\/div>\n\n<div>\n<table>\n<\/table>\n<\/div>","DataVisibility":{"Private":false,"Hidden":false},"DataExportTag":"tut-1cf-ag1-partl-15","QuestionID":"QID1719390367"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390368","SecondaryAttribute":"\u200b\u200b\u200b\u200b\u200b Task Description \u00a0 In this study, you will be asked a series of questions about a t","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">\u200b\u200b\u200b\u200b\u200b<\/div>\n\n<div style=\"text-align: center;\"><b><u>Task Description<\/u><\/b><\/div>\n&nbsp;\n\n<div style=\"text-align: justify;\">In this study, you will be asked a series of questions about a team-based card game. Specifically, you will be asked to evaluate the <em><strong>degree of responsibility<\/strong><\/em> exhibited by each player in a team that <strong><em>lost<\/em> <\/strong>in a card game.&nbsp;<br \/>\n<br \/>\nFor this purpose, we will consider a team-based variant of the Goofspiel card game, where two teams, Team A and Team B, compete against each other. Each team consists of a human player and an AI bot.<strong><em> Alex<\/em> <em>(human)<\/em><\/strong><em> <\/em>and <strong><em>AP-5 (AI)<\/em><\/strong><em><strong> <\/strong><\/em>play in <strong><em>Team A<\/em><\/strong>, while <strong><em>Billie<\/em><\/strong> <em><strong>(human) <\/strong><\/em>and <strong><em>BB-8<\/em><\/strong> <em><strong>(AI)<\/strong><\/em> play in <strong><em>Team B<\/em><\/strong>.<br \/>\n<br \/>\nWe will first ask you to complete a <em><strong>tutorial<\/strong><\/em>. This tutorial will have three parts:<\/div>\n\n<ol>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Goofspiel<\/em>: this part explains the rules of the Goofspiel card game.<\/li>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Counterfactuals<\/em>: this part explains counterfactual reasoning in Goofspiel.&nbsp;<\/li>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Evaluation Task<\/em>: this part provides an example of evaluation tasks that you will be asked to solve.<\/li>\n<\/ol>\n\n<div style=\"text-align: justify;\"><br \/>\nAfter completing the tutorial, you will be asked to evaluate 5 games. We will show you 5 Goofspiel games <em><strong>where Team A lost<\/strong><\/em>, and your task is to evaluate to what extent Alex and AP-5 are responsible for this outcome, that is, assess whether they have <strong><em>low<\/em><\/strong>, <strong><em>medium<\/em><\/strong>, or <strong><em>high<\/em><\/strong><strong> <\/strong>responsibility for Team A losing the game.&nbsp;We will also ask you how confident you are in your response.&nbsp;<br \/>\n<br \/>\n<em>Please note that all the games that you will see are illustrative examples, and they were not played by actual human-AI teams.<\/em><\/div>\n\n<div style=\"margin-left: 40px;\"><br type=\"_moz\" \/>\n&nbsp;<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u200b\u200b\u200b\u200b\u200b Task Description \u00a0 In this study, you will be asked a series of questions about a team-base...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\">\u200b\u200b\u200b\u200b\u200b<\/div>\n\n<div style=\"text-align: center;\"><b><u>Task Description<\/u><\/b><\/div>\n&nbsp;\n\n<div style=\"text-align: justify;\">In this study, you will be asked a series of questions about a team-based card game. Specifically, you will be asked to evaluate the <em><strong>degree of responsibility<\/strong><\/em> exhibited by each player in a team that <strong><em>lost<\/em> <\/strong>in a card game.&nbsp;<br \/>\n<br \/>\nFor this purpose, we will consider a team-based variant of the Goofspiel card game, where two teams, Team A and Team B, compete against each other. Each team consists of a human player and an AI bot.<strong><em> Alex<\/em> <em>(human)<\/em><\/strong><em> <\/em>and <strong><em>AP-5 (AI)<\/em><\/strong><em><strong> <\/strong><\/em>play in <strong><em>Team A<\/em><\/strong>, while <strong><em>Billie<\/em><\/strong> <em><strong>(human) <\/strong><\/em>and <strong><em>BB-8<\/em><\/strong> <em><strong>(AI)<\/strong><\/em> play in <strong><em>Team B<\/em><\/strong>.<br \/>\n<br \/>\nWe will first ask you to complete a <em><strong>tutorial<\/strong><\/em>. This tutorial will have three parts:<\/div>\n\n<ol>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Goofspiel<\/em>: this part explains the rules of the Goofspiel card game.<\/li>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Counterfactuals<\/em>: this part explains counterfactual reasoning in Goofspiel.&nbsp;<\/li>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Evaluation Task<\/em>: this part provides an example of evaluation tasks that you will be asked to solve.<\/li>\n<\/ol>\n\n<div style=\"text-align: justify;\"><br \/>\nAfter completing the tutorial, you will be asked to evaluate 5 games. We will show you 5 Goofspiel games <em><strong>where Team A lost<\/strong><\/em>, and your task is to evaluate to what extent Alex and AP-5 are responsible for this outcome, that is, assess whether they have <strong><em>low<\/em><\/strong>, <strong><em>medium<\/em><\/strong>, or <strong><em>high<\/em><\/strong><strong> <\/strong>responsibility for Team A losing the game.&nbsp;We will also ask you how confident you are in your response.&nbsp;<br \/>\n<br \/>\n<em>Please note that all the games that you will see are illustrative examples, and they were not played by actual human-AI teams.<\/em><\/div>\n\n<div style=\"margin-left: 40px;\"><br type=\"_moz\" \/>\n&nbsp;<\/div>","DataExportTag":"tut-2cfs-full-Q1","QuestionID":"QID1719390368"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390369","SecondaryAttribute":"\u200b\u200b\u200b\u200b\u200bTutorial - Goofspiel \u00a0 To solve your tasks, you need to familiarize yourself with th","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">\u200b\u200b\u200b\u200b\u200b<u><strong>Tutorial - Goofspiel<\/strong><\/u><\/div>\n&nbsp;\n\n<div style=\"text-align: justify;\">To solve your tasks, you need to familiarize yourself with the rules of the team-based version of Goofspiel. The rules are as follows:<\/div>\n\n<ul>\n <li style=\"text-align: justify;\">At the beginning of the game, each player receives 5 cards from the standard 52 card deck&nbsp; - <strong>players see each others&#39; cards<\/strong>. Additionally, a separate deck of cards is shuffled, called <em>prize deck<\/em>.&nbsp;<\/li>\n <li style=\"text-align: justify;\">The game proceeds in <em>rounds<\/em>. In each round, one prize card is drawn from the prize deck, and upon observing&nbsp;the prize&nbsp;card,&nbsp;the&nbsp;players simultaneously select one card from their hand. The team that plays cards with a higher sum&nbsp;wins the prize card, and the&nbsp;prize is added to the team&#39;s score. If&nbsp;the teams have equal sums, the prize card is discarded and the scores remain the same.<\/li>\n <li style=\"text-align: justify;\">The game finishes after round #5, and the team with&nbsp;the highest score wins. If the teams have equal score, then it&#39;s a draw.&nbsp;&nbsp; &nbsp;<\/li>\n<\/ul>\n\n<div>\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" height=\"630\" width=\"723\">\n <tbody>\n  <tr>\n   <td>\n   <div style=\"text-align: justify;\"><strong>Example 1<\/strong>: We explain how games are represented using the game below.&nbsp;The&nbsp;<em>rounds <\/em>are<em> <\/em>represented as circles: the first round (round #1) is&nbsp;on the outermost circle, while the last round (round #5)&nbsp;is on the innermost circle. The cards that players played in the game are shown in the <span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">grey boxes<\/span><\/span>. The prize cards are shown in the <span style=\"color:#000000;\"><span style=\"background-color:#e6d70b;\">yellow boxes<\/span><\/span>.<\/div>\n\n   <div>&nbsp;<\/div>\n\n   <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_V09hm8sOXyz2ztT\" style=\"height: 438px; width: 350px;\" width=\"350\" \/><\/div>\n\n   <div>&nbsp;<\/div>\n\n   <div style=\"text-align: justify;\">In this example, all players initially received&nbsp;cards 3, 4, 5, 6, and 7 (round #1). Note that in general players do not have to receive the same cards. In the first round (round #1), <span style=\"text-size-adjust: 100%;\">prize card&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#e6d70b;\">3<\/span><\/span><\/strong>&nbsp;was drawn from the prize deck,&nbsp;<\/span>both Alex and AP-5 played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">3<\/span><\/span><\/strong>, Billie played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">4<\/span><\/span><\/strong>, and BB-8 <span style=\"text-size-adjust: 100%;\">played card <\/span><strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">5<\/span><\/span><\/strong><span style=\"text-size-adjust: 100%;\">.&nbsp;<\/span>Team B won the prize card&nbsp;<strong><span style=\"color:#000000;\"><span style=\"text-size-adjust: 100%;\"><span style=\"background-color:#e6d70b;\">3<\/span><\/span><\/span><\/strong>: Team A played cards whose sum is 6, and Team B played cards whose sum is 9.<br \/>\n   <br \/>\n   Team A won the prize cards in round #2 and round #4, achieving the score of <strong><span style=\"color:#ffffff;\"><span style=\"background-color:#990033;\">11<\/span><\/span><\/strong>. Team B won all the other prizes, achieving the score of <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#990033;\">14<\/span><\/strong><\/span>. Hence, Team B won the game, which is depicted by the <span style=\"color:#990033;\"><strong>red scoreboard<\/strong><\/span>.<\/div>\n   <\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n<\/div>\n\n<p align=\"justify\" dir=\"ltr\"><br \/>\nNow that you are familiar with the rules of Goofspiel and the game representation, we ask you to answer the questions below.&nbsp;&nbsp;<br \/>\n&nbsp;<\/p>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u200b\u200b\u200b\u200b\u200bTutorial - Goofspiel \u00a0 To solve your tasks, you need to familiarize yourself with the rules...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\">\u200b\u200b\u200b\u200b\u200b<u><strong>Tutorial - Goofspiel<\/strong><\/u><\/div>\n&nbsp;\n\n<div style=\"text-align: justify;\">To solve your tasks, you need to familiarize yourself with the rules of the team-based version of Goofspiel. The rules are as follows:<\/div>\n\n<ul>\n <li style=\"text-align: justify;\">At the beginning of the game, each player receives 5 cards from the standard 52 card deck&nbsp; - <strong>players see each others&#39; cards<\/strong>. Additionally, a separate deck of cards is shuffled, called <em>prize deck<\/em>.&nbsp;<\/li>\n <li style=\"text-align: justify;\">The game proceeds in <em>rounds<\/em>. In each round, one prize card is drawn from the prize deck, and upon observing&nbsp;the prize&nbsp;card,&nbsp;the&nbsp;players simultaneously select one card from their hand. The team that plays cards with a higher sum&nbsp;wins the prize card, and the&nbsp;prize is added to the team&#39;s score. If&nbsp;the teams have equal sums, the prize card is discarded and the scores remain the same.<\/li>\n <li style=\"text-align: justify;\">The game finishes after round #5, and the team with&nbsp;the highest score wins. If the teams have equal score, then it&#39;s a draw.&nbsp;&nbsp; &nbsp;<\/li>\n<\/ul>\n\n<div>\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" height=\"630\" width=\"723\">\n <tbody>\n  <tr>\n   <td>\n   <div style=\"text-align: justify;\"><strong>Example 1<\/strong>: We explain how games are represented using the game below.&nbsp;The&nbsp;<em>rounds <\/em>are<em> <\/em>represented as circles: the first round (round #1) is&nbsp;on the outermost circle, while the last round (round #5)&nbsp;is on the innermost circle. The cards that players played in the game are shown in the <span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">grey boxes<\/span><\/span>. The prize cards are shown in the <span style=\"color:#000000;\"><span style=\"background-color:#e6d70b;\">yellow boxes<\/span><\/span>.<\/div>\n\n   <div>&nbsp;<\/div>\n\n   <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_V09hm8sOXyz2ztT\" style=\"height: 438px; width: 350px;\" width=\"350\" \/><\/div>\n\n   <div>&nbsp;<\/div>\n\n   <div style=\"text-align: justify;\">In this example, all players initially received&nbsp;cards 3, 4, 5, 6, and 7 (round #1). Note that in general players do not have to receive the same cards. In the first round (round #1), <span style=\"text-size-adjust: 100%;\">prize card&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#e6d70b;\">3<\/span><\/span><\/strong>&nbsp;was drawn from the prize deck,&nbsp;<\/span>both Alex and AP-5 played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">3<\/span><\/span><\/strong>, Billie played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">4<\/span><\/span><\/strong>, and BB-8 <span style=\"text-size-adjust: 100%;\">played card <\/span><strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">5<\/span><\/span><\/strong><span style=\"text-size-adjust: 100%;\">.&nbsp;<\/span>Team B won the prize card&nbsp;<strong><span style=\"color:#000000;\"><span style=\"text-size-adjust: 100%;\"><span style=\"background-color:#e6d70b;\">3<\/span><\/span><\/span><\/strong>: Team A played cards whose sum is 6, and Team B played cards whose sum is 9.<br \/>\n   <br \/>\n   Team A won the prize cards in round #2 and round #4, achieving the score of <strong><span style=\"color:#ffffff;\"><span style=\"background-color:#990033;\">11<\/span><\/span><\/strong>. Team B won all the other prizes, achieving the score of <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#990033;\">14<\/span><\/strong><\/span>. Hence, Team B won the game, which is depicted by the <span style=\"color:#990033;\"><strong>red scoreboard<\/strong><\/span>.<\/div>\n   <\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n<\/div>\n\n<p align=\"justify\" dir=\"ltr\"><br \/>\nNow that you are familiar with the rules of Goofspiel and the game representation, we ask you to answer the questions below.&nbsp;&nbsp;<br \/>\n&nbsp;<\/p>","DataExportTag":"tut-2cfs-full-Q2","QuestionID":"QID1719390369"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390370","SecondaryAttribute":"In Example 1, what card did AP-5 play in round #2?\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"In Example 1, what card did <strong>AP-5<\/strong> play in <strong>round #2<\/strong>?&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In Example 1, what card did AP-5 play in round #2?\u00a0","Choices":{"4":{"Display":"3"},"5":{"Display":"4"},"6":{"Display":"5"},"7":{"Display":"6"},"10":{"Display":"7"}},"ChoiceOrder":["4","5","6","7","10"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390370\/SelectableChoice\/10","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In Example 1, what card did AP-5 play in round #2?&nbsp;<\/span> <span class=\"LeftOpDesc\">7<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390370\/SelectableChoice\/10","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390370","QuestionIDFromLocator":"QID1719390370","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":13,"NextAnswerId":1,"SubSelector":"TX","QuestionText_Unsafe":"In Example 1, what card did <strong>AP-5<\/strong> play in <strong>round #2<\/strong>?&nbsp;","DataExportTag":"tut-2cfs-full-Q3","QuestionID":"QID1719390370"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390371","SecondaryAttribute":"In Example 1, what was the prize in round #3?","TertiaryAttribute":null,"Payload":{"QuestionText":"In Example 1, what was the prize in <strong>round #3<\/strong>?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In Example 1, what was the prize in round #3?","Choices":{"4":{"Display":"3"},"5":{"Display":"4"},"6":{"Display":"5"},"7":{"Display":"6"},"8":{"Display":"7"}},"ChoiceOrder":["4","5","6","7","8"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390371\/SelectableChoice\/8","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In Example 1, what was the prize in round #3?<\/span> <span class=\"LeftOpDesc\">7<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390371\/SelectableChoice\/8","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390371","QuestionIDFromLocator":"QID1719390371","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":1,"QuestionText_Unsafe":"In Example 1, what was the prize in <strong>round #3<\/strong>?","DataExportTag":"tut-2cfs-full-Q4","QuestionID":"QID1719390371"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390372","SecondaryAttribute":"In Example 1, which team won the prize in round #4?","TertiaryAttribute":null,"Payload":{"QuestionText":"In Example 1, which team won the prize in <strong>round #4<\/strong>?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In Example 1, which team won the prize in round #4?","Choices":{"4":{"Display":"Team A"},"5":{"Display":"Team B"}},"ChoiceOrder":["4","5"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390372\/SelectableChoice\/4","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In Example 1, which team won the prize in round #4?<\/span> <span class=\"LeftOpDesc\">Team A<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390372\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390372","QuestionIDFromLocator":"QID1719390372","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":5,"QuestionText_Unsafe":"In Example 1, which team won the prize in <strong>round #4<\/strong>?","DataExportTag":"tut-2cfs-full-Q5","QuestionID":"QID1719390372"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390373","SecondaryAttribute":"Tutorial - Counterfactuals \u00a0\u00a0 To solve your tasks, you also need to familiarize yourself with cou.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div dir=\"ltr\" style=\"display: block;>\n\n<p style=\">\n<div style=\"text-align: center; width:875px;\"><u><strong>Tutorial - Counterfactuals<\/strong><\/u><\/div>\n\n<p>&nbsp;&nbsp;<\/p>\n\n<div style=\"text-align: justify; width:875px;\">To solve your tasks, you also need to familiarize yourself with <em>counterfactuals<\/em>.&nbsp;In this task, <em><strong>counterfactual games<\/strong><\/em> show what would have happened had the players played their cards differently. We continue with the previous example to explain counterfactual games.<\/div>\n\n<p dir=\"ltr\">&nbsp;<\/p>\n\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n <tbody>\n  <tr>\n   <td colspan=\"2\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 1 (continued)<\/strong>: We have seen that in this example Team A lost (<em>the left figure below<\/em>). However, consider the following question:&nbsp;<br>\n   &nbsp;<\/p>\n\n   <p dir=\"ltr\" style=\"text-align: center;\"><em>What would have happened had AP-5 played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong><em> in<\/em><em><strong> round #2<\/strong>?<\/em><br>\n   &nbsp;<\/p>\n\n   <p align=\"justify\" dir=\"ltr\">Clearly, nothing would have changed in <em>round #1<\/em>. However, the <strong>cards<\/strong> the players would have played in <strong>round&nbsp;#3<\/strong>, <strong>round #4<\/strong>, and <strong>round #5<\/strong>, can be <strong>different from<\/strong> those that are originally played. The <strong>right figure<\/strong> below shows a <strong>counterfactual game<\/strong>. The differences compared to the original game in the left figure are:<\/p>\n\n   <ul dir=\"ltr\">\n    <li style=\"text-align: justify;\">In <em>round #2<\/em>, we imagine that AP-5 had played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong> instead of card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">7<\/span><\/span><\/strong>.<\/li>\n    <li style=\"text-align: justify;\">In <em>round&nbsp;#3<\/em>, <em>round #4<\/em>, and <em>round&nbsp;#5<\/em>, we imagine that all the players had responded to this change and had played cards in<strong> <\/strong><span style=\"color:#000000;\"><span style=\"background-color:#ffb38a;\">light orange<\/span><\/span><strong><span style=\"color:#d55e00;\"> <\/span><\/strong>boxes<span style=\"color:#000000;\">.<\/span><strong> <\/strong><\/li>\n    <li style=\"text-align: justify;\">Team A wins the counterfactual game, which is depicted by the <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#009e73;\">green scoreboard<\/span><\/strong><\/span><span style=\"color:#000000;\">.<\/span><\/li>\n   <\/ul>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center;\">The original game in Example 1<br>\n   &nbsp; &nbsp;<br>\n   &nbsp;<img height=\"438\" width=\"350\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_V09hm8sOXyz2ztT\" style=\"height: 438px; width: 350px;\"><\/td>\n   <td style=\"text-align: center;\">Counterfactual game<br>\n   (had AP-5 played <span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span> in round #2)<br>\n   &nbsp;<img height=\"438\" width=\"350\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_dV6DprmriLkQHjO\" style=\"height: 438px; width: 350px;\"><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n\n<div style=\"width: 100%; text-align: justify; width:875px;\"><br>\nNow that you are familiar with counterfactual games, we ask you to take a look at <em>another example<\/em>, and answer the questions below.&nbsp;<br>\n&nbsp;\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n <tbody>\n  <tr>\n   <td colspan=\"2\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 2<\/strong>: Please take a look at another game below, and one of its counterfactual games. Once you understand what happened in the counterfactual game, <strong>please answer the questions below<\/strong>.<\/p>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center;\">The original game in Example 2<br>\n   <br>\n   &nbsp;<img height=\"438\" width=\"350\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_a2dMvQ2XadjTSjP\" style=\"height: 438px; width: 350px;\"><\/td>\n   <td style=\"text-align: center;\"><span style=\"text-align: center;\">Counterfactual game<br>\n   (had&nbsp;AP-5&nbsp;played <\/span><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><span style=\"text-align: center;\"> in round #1)<\/span><br>\n   &nbsp;<img height=\"438\" width=\"350\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_EPbO6FaRLMnfwWn\" style=\"height: 438px; width: 350px;\"><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n<\/div>\n<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Tutorial - Counterfactuals \u00a0\u00a0 To solve your tasks, you also need to familiarize yourself with cou...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div dir=\"ltr\" style=\"display: block;>\n\n<p style=\">\n<div style=\"text-align: center; width:875px;\"><u><strong>Tutorial - Counterfactuals<\/strong><\/u><\/div>\n\n<p>&nbsp;&nbsp;<\/p>\n\n<div style=\"text-align: justify; width:875px;\">To solve your tasks, you also need to familiarize yourself with <em>counterfactuals<\/em>.&nbsp;In this task, <em><strong>counterfactual games<\/strong><\/em> show what would have happened had the players played their cards differently. We continue with the previous example to explain counterfactual games.<\/div>\n\n<p dir=\"ltr\">&nbsp;<\/p>\n\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n <tbody>\n  <tr>\n   <td colspan=\"2\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 1 (continued)<\/strong>: We have seen that in this example Team A lost (<em>the left figure below<\/em>). However, consider the following question:&nbsp;<br>\n   &nbsp;<\/p>\n\n   <p dir=\"ltr\" style=\"text-align: center;\"><em>What would have happened had AP-5 played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong><em> in<\/em><em><strong> round #2<\/strong>?<\/em><br>\n   &nbsp;<\/p>\n\n   <p align=\"justify\" dir=\"ltr\">Clearly, nothing would have changed in <em>round #1<\/em>. However, the <strong>cards<\/strong> the players would have played in <strong>round&nbsp;#3<\/strong>, <strong>round #4<\/strong>, and <strong>round #5<\/strong>, can be <strong>different from<\/strong> those that are originally played. The <strong>right figure<\/strong> below shows a <strong>counterfactual game<\/strong>. The differences compared to the original game in the left figure are:<\/p>\n\n   <ul dir=\"ltr\">\n    <li style=\"text-align: justify;\">In <em>round #2<\/em>, we imagine that AP-5 had played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong> instead of card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">7<\/span><\/span><\/strong>.<\/li>\n    <li style=\"text-align: justify;\">In <em>round&nbsp;#3<\/em>, <em>round #4<\/em>, and <em>round&nbsp;#5<\/em>, we imagine that all the players had responded to this change and had played cards in<strong> <\/strong><span style=\"color:#000000;\"><span style=\"background-color:#ffb38a;\">light orange<\/span><\/span><strong><span style=\"color:#d55e00;\"> <\/span><\/strong>boxes<span style=\"color:#000000;\">.<\/span><strong> <\/strong><\/li>\n    <li style=\"text-align: justify;\">Team A wins the counterfactual game, which is depicted by the <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#009e73;\">green scoreboard<\/span><\/strong><\/span><span style=\"color:#000000;\">.<\/span><\/li>\n   <\/ul>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center;\">The original game in Example 1<br>\n   &nbsp; &nbsp;<br>\n   &nbsp;<img height=\"438\" width=\"350\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_V09hm8sOXyz2ztT\" style=\"height: 438px; width: 350px;\"><\/td>\n   <td style=\"text-align: center;\">Counterfactual game<br>\n   (had AP-5 played <span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span> in round #2)<br>\n   &nbsp;<img height=\"438\" width=\"350\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_dV6DprmriLkQHjO\" style=\"height: 438px; width: 350px;\"><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n\n<div style=\"width: 100%; text-align: justify; width:875px;\"><br>\nNow that you are familiar with counterfactual games, we ask you to take a look at <em>another example<\/em>, and answer the questions below.&nbsp;<br>\n&nbsp;\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n <tbody>\n  <tr>\n   <td colspan=\"2\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 2<\/strong>: Please take a look at another game below, and one of its counterfactual games. Once you understand what happened in the counterfactual game, <strong>please answer the questions below<\/strong>.<\/p>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center;\">The original game in Example 2<br>\n   <br>\n   &nbsp;<img height=\"438\" width=\"350\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_a2dMvQ2XadjTSjP\" style=\"height: 438px; width: 350px;\"><\/td>\n   <td style=\"text-align: center;\"><span style=\"text-align: center;\">Counterfactual game<br>\n   (had&nbsp;AP-5&nbsp;played <\/span><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><span style=\"text-align: center;\"> in round #1)<\/span><br>\n   &nbsp;<img height=\"438\" width=\"350\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_EPbO6FaRLMnfwWn\" style=\"height: 438px; width: 350px;\"><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n<\/div>\n<\/div>","DataExportTag":"tut-2cfs-full-Q6","QuestionID":"QID1719390373"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390374","SecondaryAttribute":"In the counterfactual game\u00a0in Example 2, what card did AP-5\u00a0play in round #1?","TertiaryAttribute":null,"Payload":{"QuestionText":"In the <strong>counterfactual game<\/strong>&nbsp;in Example 2, what card did <strong>AP-5<\/strong>&nbsp;play in <strong>round #1<\/strong>?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In the counterfactual game\u00a0in Example 2, what card did AP-5\u00a0play in round #1?","Choices":{"4":{"Display":"3"},"5":{"Display":"4"},"6":{"Display":"5"},"7":{"Display":"6"},"8":{"Display":"7"}},"ChoiceOrder":["4","5","6","7","8"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390374\/SelectableChoice\/5","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In the counterfactual game&nbsp;in Example 2, what card did AP-5&nbsp;play in round #1?<\/span> <span class=\"LeftOpDesc\">4<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390374\/SelectableChoice\/5","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390374","QuestionIDF