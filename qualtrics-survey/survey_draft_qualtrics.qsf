a"},"12":{"Display":"Hawaii"},"13":{"Display":"Idaho"},"14":{"Display":"Illinois"},"15":{"Display":"Indiana"},"16":{"Display":"Iowa"},"17":{"Display":"Kansas"},"18":{"Display":"Kentucky"},"19":{"Display":"Louisiana"},"2":{"Display":"Alaska"},"20":{"Display":"Maine"},"21":{"Display":"Maryland"},"22":{"Display":"Massachusetts"},"23":{"Display":"Michigan"},"24":{"Display":"Minnesota"},"25":{"Display":"Mississippi"},"26":{"Display":"Missouri"},"27":{"Display":"Montana"},"28":{"Display":"Nebraska"},"29":{"Display":"Nevada"},"3":{"Display":"Arizona"},"30":{"Display":"New Hampshire"},"31":{"Display":"New Jersey"},"32":{"Display":"New Mexico"},"33":{"Display":"New York"},"34":{"Display":"North Carolina"},"35":{"Display":"North Dakota"},"36":{"Display":"Ohio"},"37":{"Display":"Oklahoma"},"38":{"Display":"Oregon"},"39":{"Display":"Pennsylvania"},"4":{"Display":"Arkansas"},"40":{"Display":"Puerto Rico"},"41":{"Display":"Rhode Island"},"42":{"Display":"South Carolina"},"43":{"Display":"South Dakota"},"44":{"Display":"Tennessee"},"45":{"Display":"Texas"},"46":{"Display":"Utah"},"47":{"Display":"Vermont"},"48":{"Display":"Virginia"},"49":{"Display":"Washington"},"5":{"Display":"California"},"50":{"Display":"West Virginia"},"51":{"Display":"Wisconsin"},"52":{"Display":"Wyoming"},"53":{"Display":"I do not reside in the United States"},"6":{"Display":"Colorado"},"7":{"Display":"Connecticut"},"8":{"Display":"Delaware"},"9":{"Display":"District of Columbia"}},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"DataExportTag":"Q1","Language":[],"QuestionDescription":"50 States, D.C. and Puerto Rico","QuestionID":"QID1116","QuestionText":"<p>In which state do you currently reside?<\/p>","QuestionText_Unsafe":"<p>In which state do you currently reside?<\/p>","QuestionType":"MC","Selector":"DL","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}}}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1117","SecondaryAttribute":"In what type of community do you live? (Check all that apply):","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[1,2,3,4],"Choices":{"1":{"Display":"City or urban community"},"2":{"Display":"Suburban community"},"3":{"Display":"Rural community"},"4":{"Display":"Other (please specify):","TextEntry":"true"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q15","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":5,"QuestionDescription":"In what type of community do you live? (Check all that apply):","QuestionID":"QID1117","QuestionText":"In what type of community do you live? (Check all that apply):","QuestionText_Unsafe":"In what type of community do you live? (Check all that apply):","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"RequestResponse","ForceResponseType":"RequestResponse","Type":"None"}}}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1118","SecondaryAttribute":"Which religion do you practice?","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["1","2","3","4","5","6","7","8","9"],"Choices":{"1":{"Display":"Protestantism"},"2":{"Display":"Catholicism"},"3":{"Display":"Other Christian denomination"},"4":{"Display":"Judaism"},"5":{"Display":"Hinduism"},"6":{"Display":"Islam"},"7":{"Display":"Buddhism"},"8":{"Display":"Some other religion (please specify):","TextEntry":"true"},"9":{"Display":"No religion"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"religion","DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":10,"QuestionDescription":"Which religion do you practice?","QuestionID":"QID1118","QuestionText":"Which religion do you practice?","QuestionText_Unsafe":"Which religion do you practice?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}}}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID112","SecondaryAttribute":"Evaluation Task \u00a0 Your task is to evaluate whether Alex and AP-5 have low, medium, or high respon..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center; width: 875px;\"><u><strong>Evaluation Task<\/strong><\/u><\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">Your task is to evaluate whether Alex and AP-5 have <em><strong>low<\/strong><\/em>, <em><strong>medium<\/strong><\/em>, or <em><strong>high<\/strong><\/em> responsibility for their team losing the game.<\/div>\n\n<div>&nbsp;\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n<tbody>\n<tr>\n<td colspan=\"2\">\n<div style=\"text-align: justify;\">Consider the game in the left figure where Team A lost, and the counterfactual game in the right figure which shows what would have happened had Alex played <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">5<\/span><\/span><\/strong> in <strong>round #3<\/strong>. Once you understand what happened in the two games, <strong>please answer the question below<\/strong>.<\/div>\n<\/td>\n<\/tr>\n<tr>\n<td>\n<div style=\"text-align: center;\">Original game<\/div>\n\n<div style=\"text-align: center;\"><img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_hI1TmKs3h8TPw9w\" style=\"width: 350px; height: 438px;\" width=\"350\" \/>&nbsp;<\/div>\n<\/td>\n<td>\n<div style=\"text-align: center;\">Counterfactual game<\/div>\n\n<div style=\"text-align: center;\">&nbsp;&nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_BqgovLPjNL7YLAg\" style=\"width: 350px; height: 438px;\" width=\"350\" \/><\/div>\n<\/td>\n<\/tr>\n<tr>\n<td colspan=\"2\" style=\"text-align: center;\"><br \/>\nRemember,&nbsp;<strong>the players see each others&#39; cards<\/strong>.<br \/>\n&nbsp;<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">To what extent do you think Alex and AP-5 are responsible for their team losing the game? Please indicate the degree of their responsibility by selecting the appropriate choice below:<\/div>\n\n<div>&nbsp;<\/div>\n\n","DataExportTag":"CF-A0-F-BN-TRxCH-294","QuestionID":"QID112","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","QuestionDescription":"Evaluation Task \u00a0 Your task is to evaluate whether Alex and AP-5 have low, medium, or high respon...","Choices":{"1":{"Display":"Alex"},"2":{"Display":"AP-5"}},"ChoiceOrder":["1","2"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"Answers":{"1":{"Display":"Low Responsibility"},"2":{"Display":"Medium Responsibility"},"3":{"Display":"High Responsibility"}},"AnswerOrder":["1","2","3"],"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"NextChoiceId":3,"NextAnswerId":4,"ChoiceDataExportTags":false}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID113","SecondaryAttribute":"Evaluation Task \u00a0 Your task is to evaluate whether Alex and AP-5 have low, medium, or high respon..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center; width: 875px;\"><u><strong>Evaluation Task<\/strong><\/u><\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">Your task is to evaluate whether Alex and AP-5 have <em><strong>low<\/strong><\/em>, <em><strong>medium<\/strong><\/em>, or <em><strong>high<\/strong><\/em> responsibility for their team losing the game.<\/div>\n\n<div>&nbsp;\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n<tbody>\n<tr>\n<td colspan=\"2\">\n<div style=\"text-align: justify;\">Consider the game in the left figure where Team A lost, and the counterfactual game in the right figure which shows what would have happened had Alex played <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">7<\/span><\/span><\/strong> in <strong>round #1<\/strong>. Once you understand what happened in the two games, <strong>please answer the question below<\/strong>.<\/div>\n<\/td>\n<\/tr>\n<tr>\n<td>\n<div style=\"text-align: center;\">Original game<\/div>\n\n<div style=\"text-align: center;\"><img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_AITI51brAMYSUwZ\" style=\"width: 350px; height: 438px;\" width=\"350\" \/>&nbsp;<\/div>\n<\/td>\n<td>\n<div style=\"text-align: center;\">Counterfactual game<\/div>\n\n<div style=\"text-align: center;\">&nbsp;&nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_WGEKwReCzk90iPM\" style=\"width: 350px; height: 438px;\" width=\"350\" \/><\/div>\n<\/td>\n<\/tr>\n<tr>\n<td colspan=\"2\" style=\"text-align: center;\"><br \/>\nRemember,&nbsp;<strong>the players see each others&#39; cards<\/strong>.<br \/>\n&nbsp;<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">To what extent do you think Alex and AP-5 are responsible for their team losing the game? Please indicate the degree of their responsibility by selecting the appropriate choice below:<\/div>\n\n<div>&nbsp;<\/div>\n\n","DataExportTag":"CF-A0-F-BN-TRxCH-589","QuestionID":"QID113","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","QuestionDescription":"Evaluation Task \u00a0 Your task is to evaluate whether Alex and AP-5 have low, medium, or high respon...","Choices":{"1":{"Display":"Alex"},"2":{"Display":"AP-5"}},"ChoiceOrder":["1","2"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"Answers":{"1":{"Display":"Low Responsibility"},"2":{"Display":"Medium Responsibility"},"3":{"Display":"High Responsibility"}},"AnswerOrder":["1","2","3"],"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"NextChoiceId":3,"NextAnswerId":4,"ChoiceDataExportTags":false}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID114","SecondaryAttribute":"Evaluation Task \u00a0 Your task is to evaluate whether Alex and AP-5 have low, medium, or high respon..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center; width: 875px;\"><u><strong>Evaluation Task<\/strong><\/u><\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">Your task is to evaluate whether Alex and AP-5 have <em><strong>low<\/strong><\/em>, <em><strong>medium<\/strong><\/em>, or <em><strong>high<\/strong><\/em> responsibility for their team losing the game.<\/div>\n\n<div>&nbsp;\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n<tbody>\n<tr>\n<td colspan=\"2\">\n<div style=\"text-align: justify;\">Consider the game in the left figure where Team A lost, and the counterfactual game in the right figure which shows what would have happened had Alex played <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">3<\/span><\/span><\/strong> in <strong>round #1<\/strong>. Once you understand what happened in the two games, <strong>please answer the question below<\/strong>.<\/div>\n<\/td>\n<\/tr>\n<tr>\n<td>\n<div style=\"text-align: center;\">Original game<\/div>\n\n<div style=\"text-align: center;\"><img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_qAz9Tv8u5FzhWLD\" style=\"width: 350px; height: 438px;\" width=\"350\" \/>&nbsp;<\/div>\n<\/td>\n<td>\n<div style=\"text-align: center;\">Counterfactual game<\/div>\n\n<div style=\"text-align: center;\">&nbsp;&nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_D9pyna2OaIPA4Q9\" style=\"width: 350px; height: 438px;\" width=\"350\" \/><\/div>\n<\/td>\n<\/tr>\n<tr>\n<td colspan=\"2\" style=\"text-align: center;\"><br \/>\nRemember,&nbsp;<strong>the players see each others&#39; cards<\/strong>.<br \/>\n&nbsp;<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">To what extent do you think Alex and AP-5 are responsible for their team losing the game? Please indicate the degree of their responsibility by selecting the appropriate choice below:<\/div>\n\n<div>&nbsp;<\/div>\n\n","DataExportTag":"CF-A0-F-BN-TRxCH-734","QuestionID":"QID114","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","QuestionDescription":"Evaluation Task \u00a0 Your task is to evaluate whether Alex and AP-5 have low, medium, or high respon...","Choices":{"1":{"Display":"Alex"},"2":{"Display":"AP-5"}},"ChoiceOrder":["1","2"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"Answers":{"1":{"Display":"Low Responsibility"},"2":{"Display":"Medium Responsibility"},"3":{"Display":"High Responsibility"}},"AnswerOrder":["1","2","3"],"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"NextChoiceId":3,"NextAnswerId":4,"ChoiceDataExportTags":false}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1147","SecondaryAttribute":"\u200b\u200b\u200b\u200b\u200bTask Description \u00a0 In this study, you will be asked a series of questions about a te","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">\u200b\u200b\u200b\u200b\u200b<u><strong>Task Description<\/strong><\/u><\/div>\n&nbsp;\n\n<div style=\"text-align: justify;\">In this study, you will be asked a series of questions about a team-based card game. Specifically, you will be asked to evaluate the <em><strong>degree of responsibility<\/strong><\/em> exhibited by each player in a team that <strong><em>lost<\/em> <\/strong>in a card game.&nbsp;<br \/>\n<br \/>\nFor this purpose, we will consider a team-based variant of the Goofspiel card game, where two teams, Team A and Team B, compete against each other. Each team consists of a human player and an AI bot.<strong><em> Alex<\/em> <em>(human)<\/em><\/strong><em> <\/em>and <strong><em>AP-5 (AI)<\/em><\/strong><em><strong> <\/strong><\/em>play in <strong><em>Team A<\/em><\/strong>, while <strong><em>Billie<\/em><\/strong> <em><strong>(human) <\/strong><\/em>and <strong><em>BB-8<\/em><\/strong> <em><strong>(AI)<\/strong><\/em> play in <strong><em>Team B<\/em><\/strong>.<br \/>\n<br \/>\nWe will first ask you to complete a <em><strong>tutorial<\/strong><\/em>. This tutorial will have three parts:<\/div>\n\n<ol>\n <li style=\"text-align: justify;\"><em>Tutorial - Goofspiel<\/em>: this part explains the rules of the Goofspiel card game.<\/li>\n <li style=\"text-align: justify;\"><em>Tutorial - Counterfactuals<\/em>: this part explains counterfactual reasoning in Goofspiel.&nbsp;<\/li>\n <li style=\"text-align: justify;\"><em>Tutorial - Evaluation Task<\/em>: this part provides an example of evaluation tasks that you will be asked to solve.<\/li>\n<\/ol>\n\n<div style=\"text-align: justify;\"><br \/>\nAfter completing the tutorial, you will be asked to evaluate 5 games. We will show you 5 Goofspiel games <em><strong>where Team A lost<\/strong><\/em>, and your task is to evaluate to what extent Alex and AP-5 are responsible for this outcome, that is, assess whether they have <strong><em>low<\/em><\/strong>, <strong><em>medium<\/em><\/strong>, or <strong><em>high<\/em><\/strong><strong> <\/strong>responsibility for Team A losing the game.<br \/>\n<br \/>\n<em>Please note that all the games that you will see are illustrative examples, and they were not played by actual human-AI teams.<\/em><\/div>\n\n<div style=\"margin-left: 40px;\"><br type=\"_moz\" \/>\n&nbsp;<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u200b\u200b\u200b\u200b\u200bTask Description \u00a0 In this study, you will be asked a series of questions about a team-based...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\">\u200b\u200b\u200b\u200b\u200b<u><strong>Task Description<\/strong><\/u><\/div>\n&nbsp;\n\n<div style=\"text-align: justify;\">In this study, you will be asked a series of questions about a team-based card game. Specifically, you will be asked to evaluate the <em><strong>degree of responsibility<\/strong><\/em> exhibited by each player in a team that <strong><em>lost<\/em> <\/strong>in a card game.&nbsp;<br \/>\n<br \/>\nFor this purpose, we will consider a team-based variant of the Goofspiel card game, where two teams, Team A and Team B, compete against each other. Each team consists of a human player and an AI bot.<strong><em> Alex<\/em> <em>(human)<\/em><\/strong><em> <\/em>and <strong><em>AP-5 (AI)<\/em><\/strong><em><strong> <\/strong><\/em>play in <strong><em>Team A<\/em><\/strong>, while <strong><em>Billie<\/em><\/strong> <em><strong>(human) <\/strong><\/em>and <strong><em>BB-8<\/em><\/strong> <em><strong>(AI)<\/strong><\/em> play in <strong><em>Team B<\/em><\/strong>.<br \/>\n<br \/>\nWe will first ask you to complete a <em><strong>tutorial<\/strong><\/em>. This tutorial will have three parts:<\/div>\n\n<ol>\n <li style=\"text-align: justify;\"><em>Tutorial - Goofspiel<\/em>: this part explains the rules of the Goofspiel card game.<\/li>\n <li style=\"text-align: justify;\"><em>Tutorial - Counterfactuals<\/em>: this part explains counterfactual reasoning in Goofspiel.&nbsp;<\/li>\n <li style=\"text-align: justify;\"><em>Tutorial - Evaluation Task<\/em>: this part provides an example of evaluation tasks that you will be asked to solve.<\/li>\n<\/ol>\n\n<div style=\"text-align: justify;\"><br \/>\nAfter completing the tutorial, you will be asked to evaluate 5 games. We will show you 5 Goofspiel games <em><strong>where Team A lost<\/strong><\/em>, and your task is to evaluate to what extent Alex and AP-5 are responsible for this outcome, that is, assess whether they have <strong><em>low<\/em><\/strong>, <strong><em>medium<\/em><\/strong>, or <strong><em>high<\/em><\/strong><strong> <\/strong>responsibility for Team A losing the game.<br \/>\n<br \/>\n<em>Please note that all the games that you will see are illustrative examples, and they were not played by actual human-AI teams.<\/em><\/div>\n\n<div style=\"margin-left: 40px;\"><br type=\"_moz\" \/>\n&nbsp;<\/div>","DataExportTag":"Q1147","QuestionID":"QID1147"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1148","SecondaryAttribute":"\u200b\u200b\u200b\u200b\u200bTutorial - Goofspiel \u00a0 To solve your tasks, you need to familiarize yourself with th","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">\u200b\u200b\u200b\u200b\u200b<u><strong>Tutorial - Goofspiel<\/strong><\/u><\/div>\n&nbsp;\n\n<div style=\"text-align: justify;\">To solve your tasks, you need to familiarize yourself with the rules of the team-based version of Goofspiel. The rules are as follows:<\/div>\n\n<ul>\n <li style=\"text-align: justify;\">At the beginning of the game, each player receives 5 cards from the standard 52 card deck - <strong>players see each others&#39; cards<\/strong>. Additionally, a separate deck of cards is shuffled, called <em>prize deck<\/em>.&nbsp;<\/li>\n <li style=\"text-align: justify;\">The game proceeds in <em>rounds<\/em>. In each round, one prize card is drawn from the prize deck, and upon observing&nbsp;the prize&nbsp;card,&nbsp;the&nbsp;players simultaneously select one card from their hand. The team that plays cards with a higher sum&nbsp;wins the prize card, and the&nbsp;prize is added to the team&#39;s score. If&nbsp;the teams have equal sums, the prize card is discarded and the scores remain the same.<\/li>\n <li style=\"text-align: justify;\">The game finishes after round #5, and the team with&nbsp;the highest score wins. If the teams have equal score, then it&#39;s a draw.&nbsp;&nbsp;<\/li>\n<\/ul>\n\n<div>\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" height=\"630\" width=\"723\">\n <tbody>\n  <tr>\n   <td>\n   <div style=\"text-align: justify;\"><strong>Example 1<\/strong>: We explain how games are represented using the game below.&nbsp;The&nbsp;<em>rounds <\/em>are<em> <\/em>represented as circles: the first round (round #1) is&nbsp;on the outermost circle, while the last round (round #5)&nbsp;is on the innermost circle. The cards that players played in the game are shown in the <span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">grey boxes<\/span><\/span>. The prize cards are shown in the <span style=\"color:#000000;\"><span style=\"background-color:#e6d70b;\">yellow boxes<\/span><\/span>.<\/div>\n\n   <div>&nbsp;<\/div>\n\n   <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_2Bo95zy0fCWG473\" style=\"height: 438px; width: 350px;\" width=\"350\" \/><\/div>\n\n   <div>&nbsp;<\/div>\n\n   <div style=\"text-align: justify;\">In this example, all players initially received&nbsp;cards 3, 4, 5, 6, and 7 (round #1). Note that in general players do not have to receive the same cards. In the first round (round #1), <span style=\"text-size-adjust: 100%;\">prize card&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#e6d70b;\">3<\/span><\/span><\/strong>&nbsp;was drawn from the prize deck,&nbsp;<\/span>both Alex and AP-5 played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">3<\/span><\/span><\/strong>, Billie played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">4<\/span><\/span><\/strong>, and BB-8 <span style=\"text-size-adjust: 100%;\">played card <\/span><strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">5<\/span><\/span><\/strong><span style=\"text-size-adjust: 100%;\">.&nbsp;<\/span>Team B won the prize card&nbsp;<strong><span style=\"color:#000000;\"><span style=\"text-size-adjust: 100%;\"><span style=\"background-color:#e6d70b;\">3<\/span><\/span><\/span><\/strong>: Team A played cards whose sum is 6, and Team B played cards whose sum is 9.<br \/>\n   <br \/>\n   Team A won the prize cards in round #2 and round #4, achieving the score of <strong><span style=\"color:#ffffff;\"><span style=\"background-color:#420516;\">11<\/span><\/span><\/strong>. Team B won all the other prizes, achieving the score of <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#420516;\">14<\/span><\/strong><\/span>. Hence, Team B won the game, which is depicted by the <span style=\"color:#420516;\"><strong>red scoreboard<\/strong><\/span>.<\/div>\n   <\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n<\/div>\n\n<p align=\"justify\" dir=\"ltr\"><br \/>\nNow that you are familiar with the rules of Goofspiel and the game representation, we ask you to answer the questions below.&nbsp;&nbsp;<br \/>\n&nbsp;<\/p>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u200b\u200b\u200b\u200b\u200bTutorial - Goofspiel \u00a0 To solve your tasks, you need to familiarize yourself with the rules...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\">\u200b\u200b\u200b\u200b\u200b<u><strong>Tutorial - Goofspiel<\/strong><\/u><\/div>\n&nbsp;\n\n<div style=\"text-align: justify;\">To solve your tasks, you need to familiarize yourself with the rules of the team-based version of Goofspiel. The rules are as follows:<\/div>\n\n<ul>\n <li style=\"text-align: justify;\">At the beginning of the game, each player receives 5 cards from the standard 52 card deck - <strong>players see each others&#39; cards<\/strong>. Additionally, a separate deck of cards is shuffled, called <em>prize deck<\/em>.&nbsp;<\/li>\n <li style=\"text-align: justify;\">The game proceeds in <em>rounds<\/em>. In each round, one prize card is drawn from the prize deck, and upon observing&nbsp;the prize&nbsp;card,&nbsp;the&nbsp;players simultaneously select one card from their hand. The team that plays cards with a higher sum&nbsp;wins the prize card, and the&nbsp;prize is added to the team&#39;s score. If&nbsp;the teams have equal sums, the prize card is discarded and the scores remain the same.<\/li>\n <li style=\"text-align: justify;\">The game finishes after round #5, and the team with&nbsp;the highest score wins. If the teams have equal score, then it&#39;s a draw.&nbsp;&nbsp;<\/li>\n<\/ul>\n\n<div>\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" height=\"630\" width=\"723\">\n <tbody>\n  <tr>\n   <td>\n   <div style=\"text-align: justify;\"><strong>Example 1<\/strong>: We explain how games are represented using the game below.&nbsp;The&nbsp;<em>rounds <\/em>are<em> <\/em>represented as circles: the first round (round #1) is&nbsp;on the outermost circle, while the last round (round #5)&nbsp;is on the innermost circle. The cards that players played in the game are shown in the <span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">grey boxes<\/span><\/span>. The prize cards are shown in the <span style=\"color:#000000;\"><span style=\"background-color:#e6d70b;\">yellow boxes<\/span><\/span>.<\/div>\n\n   <div>&nbsp;<\/div>\n\n   <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_2Bo95zy0fCWG473\" style=\"height: 438px; width: 350px;\" width=\"350\" \/><\/div>\n\n   <div>&nbsp;<\/div>\n\n   <div style=\"text-align: justify;\">In this example, all players initially received&nbsp;cards 3, 4, 5, 6, and 7 (round #1). Note that in general players do not have to receive the same cards. In the first round (round #1), <span style=\"text-size-adjust: 100%;\">prize card&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#e6d70b;\">3<\/span><\/span><\/strong>&nbsp;was drawn from the prize deck,&nbsp;<\/span>both Alex and AP-5 played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">3<\/span><\/span><\/strong>, Billie played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">4<\/span><\/span><\/strong>, and BB-8 <span style=\"text-size-adjust: 100%;\">played card <\/span><strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">5<\/span><\/span><\/strong><span style=\"text-size-adjust: 100%;\">.&nbsp;<\/span>Team B won the prize card&nbsp;<strong><span style=\"color:#000000;\"><span style=\"text-size-adjust: 100%;\"><span style=\"background-color:#e6d70b;\">3<\/span><\/span><\/span><\/strong>: Team A played cards whose sum is 6, and Team B played cards whose sum is 9.<br \/>\n   <br \/>\n   Team A won the prize cards in round #2 and round #4, achieving the score of <strong><span style=\"color:#ffffff;\"><span style=\"background-color:#420516;\">11<\/span><\/span><\/strong>. Team B won all the other prizes, achieving the score of <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#420516;\">14<\/span><\/strong><\/span>. Hence, Team B won the game, which is depicted by the <span style=\"color:#420516;\"><strong>red scoreboard<\/strong><\/span>.<\/div>\n   <\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n<\/div>\n\n<p align=\"justify\" dir=\"ltr\"><br \/>\nNow that you are familiar with the rules of Goofspiel and the game representation, we ask you to answer the questions below.&nbsp;&nbsp;<br \/>\n&nbsp;<\/p>","DataExportTag":"Q1148","QuestionID":"QID1148"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1149","SecondaryAttribute":"In Example 1, what card did AP-5 play in round #2?\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"In Example 1, what card did <strong>AP-5<\/strong> play in <strong>round #2<\/strong>?&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In Example 1, what card did AP-5 play in round #2?\u00a0","Choices":{"4":{"Display":"3"},"5":{"Display":"4"},"6":{"Display":"5"},"7":{"Display":"6"},"10":{"Display":"7"}},"ChoiceOrder":["4","5","6","7","10"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1149\/SelectableChoice\/10","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In Example 1, what card did AP-5 play in round #2?&nbsp;<\/span> <span class=\"LeftOpDesc\">7<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1149\/SelectableChoice\/10","LogicType":"Question","Operator":"Selected","QuestionID":"QID1149","QuestionIDFromLocator":"QID1149","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Incorrect answer","libraryID":"UR_eFIbmxnJAeQdsIl","messageID":"MS_5AR8L0zcn4hZGWW","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":13,"NextAnswerId":1,"QuestionText_Unsafe":"In Example 1, what card did <strong>AP-5<\/strong> play in <strong>round #2<\/strong>?&nbsp;","DataExportTag":"Q1149","QuestionID":"QID1149"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID115","SecondaryAttribute":"How confident are you in your response?","TertiaryAttribute":null,"Payload":{"QuestionText":"How confident are you in your response?\n","QuestionID":"QID115","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","QuestionDescription":"How confident are you in your response?","Choices":{"1":{"Display":"Low confidence"},"2":{"Display":"Medium confidence"},"3":{"Display":"High confidence"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"DataExportTag":"CF-A0-F-BN-TRxCH-CON","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1150","SecondaryAttribute":"In Example 1, what was the prize in round #3?","TertiaryAttribute":null,"Payload":{"QuestionText":"In Example 1, what was the prize in <strong>round #3<\/strong>?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In Example 1, what was the prize in round #3?","Choices":{"4":{"Display":"3"},"5":{"Display":"4"},"6":{"Display":"5"},"7":{"Display":"6"},"8":{"Display":"7"}},"ChoiceOrder":["4","5","6","7","8"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1150\/SelectableChoice\/8","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In Example 1, what was the prize in round #3?<\/span> <span class=\"LeftOpDesc\">7<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1150\/SelectableChoice\/8","LogicType":"Question","Operator":"Selected","QuestionID":"QID1150","QuestionIDFromLocator":"QID1150","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Incorrect answer","libraryID":"UR_eFIbmxnJAeQdsIl","messageID":"MS_5AR8L0zcn4hZGWW","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":1,"SubSelector":"TX","QuestionText_Unsafe":"In Example 1, what was the prize in <strong>round #3<\/strong>?","DataExportTag":"Q1150","QuestionID":"QID1150"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1151","SecondaryAttribute":"In Example 1, which team won the prize in round #4?","TertiaryAttribute":null,"Payload":{"QuestionText":"In Example 1, which team won the prize in <strong>round #4<\/strong>?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In Example 1, which team won the prize in round #4?","Choices":{"4":{"Display":"Team A"},"5":{"Display":"Team B"}},"ChoiceOrder":["4","5"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1151\/SelectableChoice\/4","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In Example 1, which team won the prize in round #4?<\/span> <span class=\"LeftOpDesc\">Team A<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1151\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID1151","QuestionIDFromLocator":"QID1151","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Incorrect answer","libraryID":"UR_eFIbmxnJAeQdsIl","messageID":"MS_5AR8L0zcn4hZGWW","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":5,"QuestionText_Unsafe":"In Example 1, which team won the prize in <strong>round #4<\/strong>?","DataExportTag":"Q1151","QuestionID":"QID1151"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1152","SecondaryAttribute":"Tutorial - Counterfactuals \u00a0\u00a0 To solve your tasks, you also need to familiarize yourself with cou.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div dir=\"ltr\" style=\"display: block;&gt;\n\n&lt;p style=\">\n<div style=\"text-align: center; width: 875px;\"><u><strong>Tutorial - Counterfactuals<\/strong><\/u><\/div>\n\n<p>&nbsp;&nbsp;<\/p>\n\n<div style=\"text-align: justify; width: 875px;\">To solve your tasks, you also need to familiarize yourself with <em>counterfactuals<\/em>.&nbsp;In this task, <em><strong>counterfactual games<\/strong><\/em> show what would have happened had the players played their cards differently. We continue with the previous example to explain counterfactual games.<\/div>\n\n<p dir=\"ltr\">&nbsp;<\/p>\n\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n <tbody>\n  <tr>\n   <td colspan=\"2\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 1 (continued)<\/strong>: We have seen that in this example Team A lost (<em>the left figure below<\/em>). However, consider the following question:&nbsp;<span style=\"text-align: center;\"> <\/span><br \/>\n   &nbsp;<\/p>\n\n   <p dir=\"ltr\" style=\"text-align: center;\"><em>What would have happened had AP-5 played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong><em> in<\/em><em><strong> round #2<\/strong>?<\/em><br \/>\n   &nbsp;<\/p>\n\n   <p align=\"justify\" dir=\"ltr\">Clearly, nothing would have changed in <em>round #1<\/em>. However, the <strong>cards<\/strong> the players would have played in <strong>round&nbsp;#3<\/strong>, <strong>round #4<\/strong>, and <strong>round #5<\/strong>, can be <strong>different from<\/strong> those that are originally played. The <strong>right figure<\/strong> below shows the <strong>counterfactual game<\/strong>. The differences compared to the original game in the left figure are:<\/p>\n\n   <ul dir=\"ltr\">\n    <li style=\"text-align: justify;\">In <em>round #2<\/em>, we imagine that AP-5 had played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong> instead of card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">7<\/span><\/span><\/strong>.<\/li>\n    <li style=\"text-align: justify;\">In <em>round&nbsp;#3<\/em>, <em>round #4<\/em>, and <em>round&nbsp;#5<\/em>, we imagine that all the players had responded to this change and had played cards in<strong> <\/strong><span style=\"color:#000000;\"><span style=\"background-color:#ffb38a;\">light orange<\/span><\/span><strong><span style=\"color:#d55e00;\"> <\/span><\/strong>boxes<span style=\"color:#000000;\">.<\/span><strong> <\/strong><\/li>\n    <li style=\"text-align: justify;\">Team A wins the counterfactual game, which is depicted by the <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#009e73;\">green scoreboard<\/span><\/strong><\/span><span style=\"color:#000000;\">.<\/span><\/li>\n   <\/ul>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center;\">The original game in Example 1&nbsp; &nbsp;<br \/>\n   <br \/>\n   &nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_2Bo95zy0fCWG473\" style=\"height: 438px; width: 350px;\" width=\"350\" \/><\/td>\n   <td style=\"text-align: center;\">Counterfactual game<br \/>\n   (had AP-5 played <span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span> in round #2)<br \/>\n   &nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_dV6DprmriLkQHjO\" style=\"height: 438px; width: 350px;\" width=\"350\" \/><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n\n<div style=\"width: 100%; text-align: justify; width: 875px;\"><br \/>\nNow that you are familiar with counterfactuals games, we ask you to take a look at <em>another example<\/em>, and answer the questions below.&nbsp;<br \/>\n&nbsp;\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n <tbody>\n  <tr>\n   <td colspan=\"2\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 2<\/strong>: Please take a look at another game below, and one of its counterfactual games. Once you understand what happened in the counterfactual game, <strong>please answer the questions below<\/strong>.<\/p>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center;\">The original game in Example 2<br \/>\n   <br \/>\n   &nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_4E76y7AKw82EDb4\" style=\"height: 438px; width: 350px;\" width=\"350\" \/><\/td>\n   <td style=\"text-align: center;\"><span style=\"text-align: center;\">Counterfactual game<br \/>\n   (had&nbsp;AP-5&nbsp;played <\/span><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><span style=\"text-align: center;\"> in round #1)<\/span><br \/>\n   &nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_OAVahJzEB5tNrAV\" style=\"height: 438px; width: 350px;\" width=\"350\" \/><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n<\/div>\n<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Tutorial - Counterfactuals \u00a0\u00a0 To solve your tasks, you also need to familiarize yourself with cou...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div dir=\"ltr\" style=\"display: block;&gt;\n\n&lt;p style=\">\n<div style=\"text-align: center; width: 875px;\"><u><strong>Tutorial - Counterfactuals<\/strong><\/u><\/div>\n\n<p>&nbsp;&nbsp;<\/p>\n\n<div style=\"text-align: justify; width: 875px;\">To solve your tasks, you also need to familiarize yourself with <em>counterfactuals<\/em>.&nbsp;In this task, <em><strong>counterfactual games<\/strong><\/em> show what would have happened had the players played their cards differently. We continue with the previous example to explain counterfactual games.<\/div>\n\n<p dir=\"ltr\">&nbsp;<\/p>\n\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n <tbody>\n  <tr>\n   <td colspan=\"2\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 1 (continued)<\/strong>: We have seen that in this example Team A lost (<em>the left figure below<\/em>). However, consider the following question:&nbsp;<span style=\"text-align: center;\"> <\/span><br \/>\n   &nbsp;<\/p>\n\n   <p dir=\"ltr\" style=\"text-align: center;\"><em>What would have happened had AP-5 played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong><em> in<\/em><em><strong> round #2<\/strong>?<\/em><br \/>\n   &nbsp;<\/p>\n\n   <p align=\"justify\" dir=\"ltr\">Clearly, nothing would have changed in <em>round #1<\/em>. However, the <strong>cards<\/strong> the players would have played in <strong>round&nbsp;#3<\/strong>, <strong>round #4<\/strong>, and <strong>round #5<\/strong>, can be <strong>different from<\/strong> those that are originally played. The <strong>right figure<\/strong> below shows the <strong>counterfactual game<\/strong>. The differences compared to the original game in the left figure are:<\/p>\n\n   <ul dir=\"ltr\">\n    <li style=\"text-align: justify;\">In <em>round #2<\/em>, we imagine that AP-5 had played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong> instead of card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">7<\/span><\/span><\/strong>.<\/li>\n    <li style=\"text-align: justify;\">In <em>round&nbsp;#3<\/em>, <em>round #4<\/em>, and <em>round&nbsp;#5<\/em>, we imagine that all the players had responded to this change and had played cards in<strong> <\/strong><span style=\"color:#000000;\"><span style=\"background-color:#ffb38a;\">light orange<\/span><\/span><strong><span style=\"color:#d55e00;\"> <\/span><\/strong>boxes<span style=\"color:#000000;\">.<\/span><strong> <\/strong><\/li>\n    <li style=\"text-align: justify;\">Team A wins the counterfactual game, which is depicted by the <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#009e73;\">green scoreboard<\/span><\/strong><\/span><span style=\"color:#000000;\">.<\/span><\/li>\n   <\/ul>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center;\">The original game in Example 1&nbsp; &nbsp;<br \/>\n   <br \/>\n   &nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_2Bo95zy0fCWG473\" style=\"height: 438px; width: 350px;\" width=\"350\" \/><\/td>\n   <td style=\"text-align: center;\">Counterfactual game<br \/>\n   (had AP-5 played <span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span> in round #2)<br \/>\n   &nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_dV6DprmriLkQHjO\" style=\"height: 438px; width: 350px;\" width=\"350\" \/><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n\n<div style=\"width: 100%; text-align: justify; width: 875px;\"><br \/>\nNow that you are familiar with counterfactuals games, we ask you to take a look at <em>another example<\/em>, and answer the questions below.&nbsp;<br \/>\n&nbsp;\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n <tbody>\n  <tr>\n   <td colspan=\"2\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 2<\/strong>: Please take a look at another game below, and one of its counterfactual games. Once you understand what happened in the counterfactual game, <strong>please answer the questions below<\/strong>.<\/p>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center;\">The original game in Example 2<br \/>\n   <br \/>\n   &nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_4E76y7AKw82EDb4\" style=\"height: 438px; width: 350px;\" width=\"350\" \/><\/td>\n   <td style=\"text-align: center;\"><span style=\"text-align: center;\">Counterfactual game<br \/>\n   (had&nbsp;AP-5&nbsp;played <\/span><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><span style=\"text-align: center;\"> in round #1)<\/span><br \/>\n   &nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_OAVahJzEB5tNrAV\" style=\"height: 438px; width: 350px;\" width=\"350\" \/><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n<\/div>\n<\/div>","DataExportTag":"Q1152","QuestionID":"QID1152"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1153","SecondaryAttribute":"In the counterfactual game\u00a0in Example 2, what card did AP-5\u00a0play in round #1?","TertiaryAttribute":null,"Payload":{"QuestionText":"In the <strong>counterfactual game<\/strong>&nbsp;in Example 2, what card did <strong>AP-5<\/strong>&nbsp;play in <strong>round #1<\/strong>?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In the counterfactual game\u00a0in Example 2, what card did AP-5\u00a0play in round #1?","Choices":{"4":{"Display":"3"},"5":{"Display":"4"},"6":{"Display":"5"},"7":{"Display":"6"},"8":{"Display":"7"}},"ChoiceOrder":["4","5","6","7","8"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1153\/SelectableChoice\/5","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In the counterfactual game&amp;nbsp;in Example 2, what card did AP-5&amp;nbsp;play in round #1?<\/span> <span class=\"LeftOpDesc\">4<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1153\/SelectableChoice\/5","LogicType":"Question","Operator":"Selected","QuestionID":"QID1153","QuestionIDFromLocator":"QID1153","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Incorrect answer","libraryID":"UR_eFIbmxnJAeQdsIl","messageID":"MS_5AR8L0zcn4hZGWW","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":3,"SubSelector":"TX","QuestionText_Unsafe":"In the <strong>counterfactual game<\/strong>&nbsp;in Example 2, what card did <strong>AP-5<\/strong>&nbsp;play in <strong>round #1<\/strong>?","DataExportTag":"Q1153","QuestionID":"QID1153"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1154","SecondaryAttribute":"In the counterfactual game\u00a0in Example 2, what card did AP-5 play in round #4?","TertiaryAttribute":null,"Payload":{"QuestionText":"In the <strong>counterfactual game<\/strong>&nbsp;in Example 2, what card did <strong>AP-5<\/strong> play in <strong>round #4<\/strong>?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In the counterfactual game\u00a0in Example 2, what card did AP-5 play in round #4?","Choices":{"4":{"Display":"3"},"5":{"Display":"4"},"6":{"Display":"5"},"7":{"Display":"6"},"8":{"Display":"7"}},"ChoiceOrder":["4","5","6","7","8"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1154\/SelectableChoice\/8","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In the counterfactual game&amp;nbsp;in Example 2, what card did AP-5 play in round #4?<\/span> <span class=\"LeftOpDesc\">7<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1154\/SelectableChoice\/8","LogicType":"Question","Operator":"Selected","QuestionID":"QID1154","QuestionIDFromLocator":"QID1154","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Incorrect answer","libraryID":"UR_eFIbmxnJAeQdsIl","messageID":"MS_5AR8L0zcn4hZGWW","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":3,"SubSelector":"TX","QuestionText_Unsafe":"In the <strong>counterfactual game<\/strong>&nbsp;in Example 2, what card did <strong>AP-5<\/strong> play in <strong>round #4<\/strong>?","DataExportTag":"Q1154","QuestionID":"QID1154"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1155","SecondaryAttribute":"Which team won in the counterfactual game in Example 2?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which team won in the <strong>counterfactual game<\/strong> in Example 2?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Which team won in the counterfactual game in Example 2?","Choices":{"4":{"Display":"Team A"},"5":{"Display":"Team B"}},"ChoiceOrder":["4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1155\/SelectableChoice\/5","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Which team won in the counterfactual game in Example 2?<\/span> <span class=\"LeftOpDesc\">Team B<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1155\/SelectableChoice\/5","LogicType":"Question","Operator":"Selected","QuestionID":"QID1155","QuestionIDFromLocator":"QID1155","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Incorrect answer","libraryID":"UR_eFIbmxnJAeQdsIl","messageID":"MS_5AR8L0zcn4hZGWW","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionText_Unsafe":"Which team won in the <strong>counterfactual game<\/strong> in Example 2?","DataExportTag":"Q1155","QuestionID":"QID1155"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1156","SecondaryAttribute":"Tutorial - Counterfactuals \u00a0 Counterfactual games can be based on more complex scenarios. We cont..","TertiaryAttribute":null,"Payload":{"QuestionText":"<p dir=\"ltr\" style=\"text-align: center; width:960px;\"><u><strong>Tutorial - Counterfactuals<\/strong><\/u><\/p>\n\n<p dir=\"ltr\">&nbsp;<\/p>\n\n<p align=\"justify\" dir=\"ltr\" style=\"width:960px;\">Counterfactual games can be based on more complex scenarios. We continue with the previous example to demonstrate this.<\/p>\n\n<div style=\"text-align: center; width:960px;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<\/div>\n\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:960px;\">\n <tbody>\n  <tr>\n   <td colspan=\"3\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 2 (continued)<\/strong>:&nbsp;We have seen that in this example&nbsp;Team A would not have won had AP-5 played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong> in <strong>round 1&nbsp;<\/strong>(<em>the middle figure below<\/em>). However, we can also ask:<br \/>\n   &nbsp;<\/p>\n\n   <p dir=\"ltr\" style=\"text-align: center;\"><em>What would have happened had AP-5&nbsp;played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong><em> in <\/em><em><strong>round #1<\/strong>&nbsp;and had Alex&nbsp;played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong><em> <\/em><em>in <strong>r<\/strong><\/em><strong>ound #2<\/strong><em>?<\/em><\/p>\n\n   <p align=\"justify\" dir=\"ltr\"><br \/>\n   This yields a <strong>new counterfactual <\/strong>game depicted in the <strong>right figure<\/strong> below. The differences compared to the <em>previous&nbsp;counterfactual game<\/em> in the middle&nbsp;figure are:<\/p>\n\n   <ul dir=\"ltr\">\n    <li style=\"text-align: justify;\">In <em>round #2<\/em>, we imagine that Alex had played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong> instead of card <strong><span style=\"color:#000000;\"><span style=\"background-color:#ffb38a;\">5<\/span><\/span><\/strong>.<\/li>\n    <li style=\"text-align: justify;\">In <em>round #3<\/em>, we imagine that all the players had responded to the two changes (<strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span> <\/strong>and <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong>) and had played cards in <span style=\"color:#000000;\"><span style=\"background-color:#ff6700;\">dark orange<\/span><\/span><span style=\"color:#ff6700;\"> <\/span>boxes.&nbsp;<\/li>\n    <li style=\"text-align: justify;\">Team A wins, which is depicted by the <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#009e73;\">green scoreboard<\/span><\/strong><\/span><span style=\"color:#000000;\">.<\/span><\/li>\n   <\/ul>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center; width:32%;\">The original game in Example 2<br \/>\n   <br \/>\n   <br \/>\n   <img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_4E76y7AKw82EDb4\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n   <td style=\"text-align: center; width:32%;\">Previous counterfactual game<br \/>\n   (had AP-5&nbsp;played<strong>&nbsp;<span style=\"color:#000000;\"><span style=\"background-color:#a8e68d\">4<\/span><\/span><\/strong>&nbsp;in round #1)&nbsp;<br \/>\n   <br \/>\n   <img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_OAVahJzEB5tNrAV\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n   <td style=\"text-align: center; width:36%;\"><strong>New counterfactual game <\/strong><br \/>\n   (had AP-5 played&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong>&nbsp;in round #1&nbsp;and<br \/>\n   had Alex&nbsp;played&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong>&nbsp;in round #2) <img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_ugA9tw07DzpATlX\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Tutorial - Counterfactuals \u00a0 Counterfactual games can be based on more complex scenarios. We cont...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionText_Unsafe":"<p dir=\"ltr\" style=\"text-align: center; width:960px;\"><u><strong>Tutorial - Counterfactuals<\/strong><\/u><\/p>\n\n<p dir=\"ltr\">&nbsp;<\/p>\n\n<p align=\"justify\" dir=\"ltr\" style=\"width:960px;\">Counterfactual games can be based on more complex scenarios. We continue with the previous example to demonstrate this.<\/p>\n\n<div style=\"text-align: center; width:960px;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<\/div>\n\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:960px;\">\n <tbody>\n  <tr>\n   <td colspan=\"3\">\n   <p align=\"justify\" dir=\"ltr\"><strong>Example 2 (continued)<\/strong>:&nbsp;We have seen that in this example&nbsp;Team A would not have won had AP-5 played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong> in <strong>round 1&nbsp;<\/strong>(<em>the middle figure below<\/em>). However, we can also ask:<br \/>\n   &nbsp;<\/p>\n\n   <p dir=\"ltr\" style=\"text-align: center;\"><em>What would have happened had AP-5&nbsp;played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong><em> in <\/em><em><strong>round #1<\/strong>&nbsp;and had Alex&nbsp;played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong><em> <\/em><em>in <strong>r<\/strong><\/em><strong>ound #2<\/strong><em>?<\/em><\/p>\n\n   <p align=\"justify\" dir=\"ltr\"><br \/>\n   This yields a <strong>new counterfactual <\/strong>game depicted in the <strong>right figure<\/strong> below. The differences compared to the <em>previous&nbsp;counterfactual game<\/em> in the middle&nbsp;figure are:<\/p>\n\n   <ul dir=\"ltr\">\n    <li style=\"text-align: justify;\">In <em>round #2<\/em>, we imagine that Alex had played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong> instead of card <strong><span style=\"color:#000000;\"><span style=\"background-color:#ffb38a;\">5<\/span><\/span><\/strong>.<\/li>\n    <li style=\"text-align: justify;\">In <em>round #3<\/em>, we imagine that all the players had responded to the two changes (<strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span> <\/strong>and <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong>) and had played cards in <span style=\"color:#000000;\"><span style=\"background-color:#ff6700;\">dark orange<\/span><\/span><span style=\"color:#ff6700;\"> <\/span>boxes.&nbsp;<\/li>\n    <li style=\"text-align: justify;\">Team A wins, which is depicted by the <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#009e73;\">green scoreboard<\/span><\/strong><\/span><span style=\"color:#000000;\">.<\/span><\/li>\n   <\/ul>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center; width:32%;\">The original game in Example 2<br \/>\n   <br \/>\n   <br \/>\n   <img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_4E76y7AKw82EDb4\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n   <td style=\"text-align: center; width:32%;\">Previous counterfactual game<br \/>\n   (had AP-5&nbsp;played<strong>&nbsp;<span style=\"color:#000000;\"><span style=\"background-color:#a8e68d\">4<\/span><\/span><\/strong>&nbsp;in round #1)&nbsp;<br \/>\n   <br \/>\n   <img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_OAVahJzEB5tNrAV\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n   <td style=\"text-align: center; width:36%;\"><strong>New counterfactual game <\/strong><br \/>\n   (had AP-5 played&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong>&nbsp;in round #1&nbsp;and<br \/>\n   had Alex&nbsp;played&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong>&nbsp;in round #2) <img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_ugA9tw07DzpATlX\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>","DataExportTag":"Q1156","QuestionID":"QID1156"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1157","SecondaryAttribute":"In the new counterfactual game in Example 2, what card did AP-5 play in round #1?","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: justify; width:960px;\">In the <strong>new counterfactual game<\/strong> in Example 2, what card did <strong>AP-5<\/strong> play in <strong>round #1<\/strong>?<\/div>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In the new counterfactual game in Example 2, what card did AP-5 play in round #1?","Choices":{"10":{"Display":"3"},"11":{"Display":"4"},"12":{"Display":"5"},"13":{"Display":"6"},"14":{"Display":"7"}},"ChoiceOrder":["10","11","12","13","14"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1157\/SelectableChoice\/11","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In the new counterfactual game in Example 2, what card did AP-5 play in round #1?<\/span> <span class=\"LeftOpDesc\">4<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1157\/SelectableChoice\/11","LogicType":"Question","Operator":"Selected","QuestionID":"QID1157","QuestionIDFromLocator":"QID1157","QuestionIsInLoop"