00px;\" width=\"300\" \/><\/td>\n\t\t\t<td style=\"text-align: center;\">Second counterfactual game<br \/>\n\t\t\t&nbsp;<img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_MGJOrxCjtRR1quU\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td colspan=\"3\">\n\t\t\t<div style=\"text-align: center;\"><br \/>\n\t\t\tRemember,&nbsp;<strong>the players see each others&#39; cards<\/strong>.<\/div>\n\n\t\t\t<div style=\"text-align: center;\">&nbsp;<\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<\/div>\n\n<div style=\"text-align: left;\"><br \/>\n&nbsp;<\/div>\n<\/div>\n<\/div>\n\n<div style=\"text-align: justify; width: 960px;\">To what extent do you think Alex and AP-5 are responsible for their team losing the game? Please indicate the degree of their responsibility by selecting the appropriate choice below:<\/div>\n\n<div>&nbsp;<\/div>","DataExportTag":"2CF-FUL-BB-BFxCH-711","QuestionID":"QID546","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","QuestionDescription":"Evaluation Task \u00a0\u00a0 Your task is to evaluate whether Alex and AP-5 have low, medium, or high respo...","Choices":{"1":{"Display":"Alex"},"2":{"Display":"AP-5"}},"ChoiceOrder":["1","2"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"Answers":{"1":{"Display":"Low Responsibility"},"2":{"Display":"Medium Responsibility"},"3":{"Display":"High Responsibility"}},"AnswerOrder":["1","2","3"],"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"NextChoiceId":3,"NextAnswerId":4,"ChoiceDataExportTags":false}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID547","SecondaryAttribute":"How confident are you in your response?","Tert