or":"Selected","QuestionID":"QID1719390375","QuestionIDFromLocator":"QID1719390375","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":3,"QuestionText_Unsafe":"<div style=\"text-align: justify; width:875px;\">In the <strong>counterfactual game<\/strong>&nbsp;in Example 2, what card did <strong>AP-5<\/strong> play in <strong>round #4<\/strong>?<\/div>","DataExportTag":"tut-2cfs-full-Q8","QuestionID":"QID1719390375"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390376","SecondaryAttribute":"Which team won in the counterfactual game in Example 2?","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: justify; width:875px;\">Which team won in the <strong>counterfactual game<\/strong> in Example 2?<\/div>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Which team won in the counterfactual game in Example 2?","Choices":{"4":{"Display":"Team A"},"5":{"Display":"Team B"}},"ChoiceOrder":["4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390376\/SelectableChoice\/5","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Which team won in the counterfactual game in Example 2?<\/span> <span class=\"LeftOpDesc\">Team B<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390376\/SelectableChoice\/5","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390376","QuestionIDFromLocator":"QID1719390376","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: justify; width:875px;\">Which team won in the <strong>counterfactual game<\/strong> in Example 2?<\/div>","DataExportTag":"tut-2cfs-full-Q9","QuestionID":"QID1719390376"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390377","SecondaryAttribute":"Tutorial - Counterfactuals \u00a0 Counterfactual games can be based on more complex scenarios. We cont..","TertiaryAttribute":null,"Payload":{"QuestionText":"<p dir=\"ltr\" style=\"text-align: center; width:950px;\"><u><strong>Tutorial - Counterfactuals<\/strong><\/u><\/p>\n\n<p dir=\"ltr\">&nbsp;<\/p>\n\n<div style=\"text-align: justify; width:950px;\">Counterfactual games can be based on more complex scenarios. We continue with the previous example to demonstrate this.<\/div>\n\n<div style=\"text-align: center;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<\/div>\n\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:950px;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td colspan=\"3\">\n\t\t\t<p align=\"justify\" dir=\"ltr\"><strong>Example 2 (continued)<\/strong>:&nbsp;We have seen that in this example&nbsp;Team A would not have won had AP-5 played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong> in <strong>round 1&nbsp;<\/strong>(<em>the middle figure below<\/em>). However, we can also ask:<br \/>\n\t\t\t&nbsp;<\/p>\n\n\t\t\t<p dir=\"ltr\" style=\"text-align: center;\"><em>What would have happened had AP-5&nbsp;played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong><em> in <\/em><em><strong>round #1<\/strong>&nbsp;and had Alex&nbsp;played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong><em> <\/em><em>in <strong>r<\/strong><\/em><strong>ound #2<\/strong><em>?<\/em><br \/>\n\t\t\t&nbsp;<\/p>\n\n\t\t\t<p align=\"justify\" dir=\"ltr\">This yields a <strong>new counterfactual <\/strong>game depicted in the <strong>right figure<\/strong> below. The differences compared to the <em>previous&nbsp;counterfactual game<\/em> in the middle&nbsp;figure are:<\/p>\n\n\t\t\t<ul dir=\"ltr\">\n\t\t\t\t<li style=\"text-align: justify;\">In <em>round #2<\/em>, we imagine that Alex had played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong> instead of card <strong><span style=\"color:#000000;\"><span style=\"background-color:#ffb38a;\">5<\/span><\/span><\/strong>.<\/li>\n\t\t\t\t<li style=\"text-align: justify;\">In <em>round #3<\/em>, we imagine that all the players had responded to the two changes (<strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span> <\/strong>and <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong>) and had played cards in <span style=\"color:#000000;\"><span style=\"background-color:#ff6700;\">dark orange<\/span><\/span><span style=\"color:#ff6700;\"> <\/span>boxes.&nbsp;<\/li>\n\t\t\t\t<li style=\"text-align: justify;\">Team A wins, which is depicted by the <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#009e73;\">green scoreboard<\/span><\/strong><\/span><span style=\"color:#000000;\">.<\/span><\/li>\n\t\t\t<\/ul>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center; width:32%;\">&nbsp;The original game in Example 2<br \/>\n\t\t\t<br \/>\n\t\t\t&nbsp;<br \/>\n\t\t\t<img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_a2dMvQ2XadjTSjP\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n\t\t\t<td style=\"text-align: center; width:32%;\">Previous counterfactual game<br \/>\n\t\t\t(had AP-5&nbsp;played<strong>&nbsp;<span style=\"color:#000000;\"><span style=\"background-color:#a8e68d\">4<\/span><\/span><\/strong>&nbsp;in round #1)&nbsp;<br \/>\n\t\t\t&nbsp;<img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_EPbO6FaRLMnfwWn\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n\t\t\t<td style=\"text-align: center; width:36%;\"><strong>New counterfactual game <\/strong><br \/>\n\t\t\t(had AP-5 played&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong>&nbsp;in round #1&nbsp;and<br \/>\n\t\t\thad Alex&nbsp;played&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong>&nbsp;in round #2)<br \/>\n\t\t\t<img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_xWDfCZrPRzqCNLl\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n\n<p dir=\"ltr\">&nbsp;<\/p>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Tutorial - Counterfactuals \u00a0 Counterfactual games can be based on more complex scenarios. We cont...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionText_Unsafe":"<p dir=\"ltr\" style=\"text-align: center; width:950px;\"><u><strong>Tutorial - Counterfactuals<\/strong><\/u><\/p>\n\n<p dir=\"ltr\">&nbsp;<\/p>\n\n<div style=\"text-align: justify; width:950px;\">Counterfactual games can be based on more complex scenarios. We continue with the previous example to demonstrate this.<\/div>\n\n<div style=\"text-align: center;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<\/div>\n\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:950px;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td colspan=\"3\">\n\t\t\t<p align=\"justify\" dir=\"ltr\"><strong>Example 2 (continued)<\/strong>:&nbsp;We have seen that in this example&nbsp;Team A would not have won had AP-5 played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong> in <strong>round 1&nbsp;<\/strong>(<em>the middle figure below<\/em>). However, we can also ask:<br \/>\n\t\t\t&nbsp;<\/p>\n\n\t\t\t<p dir=\"ltr\" style=\"text-align: center;\"><em>What would have happened had AP-5&nbsp;played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong><em> in <\/em><em><strong>round #1<\/strong>&nbsp;and had Alex&nbsp;played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong><em> <\/em><em>in <strong>r<\/strong><\/em><strong>ound #2<\/strong><em>?<\/em><br \/>\n\t\t\t&nbsp;<\/p>\n\n\t\t\t<p align=\"justify\" dir=\"ltr\">This yields a <strong>new counterfactual <\/strong>game depicted in the <strong>right figure<\/strong> below. The differences compared to the <em>previous&nbsp;counterfactual game<\/em> in the middle&nbsp;figure are:<\/p>\n\n\t\t\t<ul dir=\"ltr\">\n\t\t\t\t<li style=\"text-align: justify;\">In <em>round #2<\/em>, we imagine that Alex had played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong> instead of card <strong><span style=\"color:#000000;\"><span style=\"background-color:#ffb38a;\">5<\/span><\/span><\/strong>.<\/li>\n\t\t\t\t<li style=\"text-align: justify;\">In <em>round #3<\/em>, we imagine that all the players had responded to the two changes (<strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span> <\/strong>and <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong>) and had played cards in <span style=\"color:#000000;\"><span style=\"background-color:#ff6700;\">dark orange<\/span><\/span><span style=\"color:#ff6700;\"> <\/span>boxes.&nbsp;<\/li>\n\t\t\t\t<li style=\"text-align: justify;\">Team A wins, which is depicted by the <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#009e73;\">green scoreboard<\/span><\/strong><\/span><span style=\"color:#000000;\">.<\/span><\/li>\n\t\t\t<\/ul>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center; width:32%;\">&nbsp;The original game in Example 2<br \/>\n\t\t\t<br \/>\n\t\t\t&nbsp;<br \/>\n\t\t\t<img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_a2dMvQ2XadjTSjP\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n\t\t\t<td style=\"text-align: center; width:32%;\">Previous counterfactual game<br \/>\n\t\t\t(had AP-5&nbsp;played<strong>&nbsp;<span style=\"color:#000000;\"><span style=\"background-color:#a8e68d\">4<\/span><\/span><\/strong>&nbsp;in round #1)&nbsp;<br \/>\n\t\t\t&nbsp;<img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_EPbO6FaRLMnfwWn\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n\t\t\t<td style=\"text-align: center; width:36%;\"><strong>New counterfactual game <\/strong><br \/>\n\t\t\t(had AP-5 played&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong>&nbsp;in round #1&nbsp;and<br \/>\n\t\t\thad Alex&nbsp;played&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">4<\/span><\/span><\/strong>&nbsp;in round #2)<br \/>\n\t\t\t<img height=\"375\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_xWDfCZrPRzqCNLl\" style=\"height: 375px; width: 300px;\" width=\"300\" \/><\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n\n<p dir=\"ltr\">&nbsp;<\/p>","DataExportTag":"tut-2cfs-full-Q10","QuestionID":"QID1719390377"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390378","SecondaryAttribute":"In the new counterfactual game in Example 2, what card did AP-5 play in round #1?","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: justify; width:950px;\">In the <strong>new counterfactual game<\/strong> in Example 2, what card did <strong>AP-5<\/strong> play in <strong>round #1<\/strong>?<\/div>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In the new counterfactual game in Example 2, what card did AP-5 play in round #1?","Choices":{"10":{"Display":"3"},"11":{"Display":"4"},"12":{"Display":"5"},"13":{"Display":"6"},"14":{"Display":"7"}},"ChoiceOrder":["10","11","12","13","14"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390378\/SelectableChoice\/11","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In the new counterfactual game in Example 2, what card did AP-5 play in round #1?<\/span> <span class=\"LeftOpDesc\">4<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390378\/SelectableChoice\/11","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390378","QuestionIDFromLocator":"QID1719390378","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":15,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: justify; width:950px;\">In the <strong>new counterfactual game<\/strong> in Example 2, what card did <strong>AP-5<\/strong> play in <strong>round #1<\/strong>?<\/div>","DataExportTag":"tut-2cfs-full-Q11","QuestionID":"QID1719390378"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390379","SecondaryAttribute":"In\u00a0Example 2, did Alex play the same card in\u00a0round #5 of\u00a0the new counterfactual game and as in\u00a0r","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: justify; width:950px;\">In&nbsp;Example 2, did <strong>Alex<\/strong> play the same card in&nbsp;<strong>round #5<\/strong> of&nbsp;<strong>the new counterfactual game<\/strong> and as in&nbsp;<strong>round #5<\/strong> of&nbsp;<strong>the original game<\/strong>?<\/div>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In\u00a0Example 2, did Alex play the same card in\u00a0round #5 of\u00a0the new counterfactual game and as in\u00a0ro...","Choices":{"7":{"Display":"Yes"},"8":{"Display":"No"}},"ChoiceOrder":["7","8"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390379\/SelectableChoice\/8","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In&nbsp;Example 2, did Alex play the same card in&nbsp;round #5 of&nbsp;the new counterfactual game and as in&nbsp;ro...<\/span> <span class=\"LeftOpDesc\">No<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390379\/SelectableChoice\/8","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390379","QuestionIDFromLocator":"QID1719390379","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: justify; width:950px;\">In&nbsp;Example 2, did <strong>Alex<\/strong> play the same card in&nbsp;<strong>round #5<\/strong> of&nbsp;<strong>the new counterfactual game<\/strong> and as in&nbsp;<strong>round #5<\/strong> of&nbsp;<strong>the original game<\/strong>?<\/div>","DataExportTag":"tut-2cfs-full-Q12","QuestionID":"QID1719390379"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390380","SecondaryAttribute":"Tutorial - Evaluation Task \u00a0\u00a0 Great job! You have successfully understood the rules of Goofspiel..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">\n<div style=\"text-align: center; width:950px;\"><u><strong>Tutorial - Evaluation Task<\/strong><\/u><\/div>\n\n<div>&nbsp;&nbsp;<\/div>\n\n<div>\n<div style=\"text-align: justify; width:950px;\">Great job! You have successfully understood the rules of Goofspiel and counterfactuals. In the remainder of the study we will ask you to&nbsp;evaluate whether Alex and AP-5 have <em><strong>low<\/strong><\/em>, <em><strong>medium<\/strong><\/em>, or <em><strong>high<\/strong><\/em> responsibility for their team losing the game.&nbsp;We will also ask you how confident you are in your response. Below you can see an example of such questions.<\/div>\n\n<div style=\"text-align: left;\">&nbsp;<\/div>\n\n<div style=\"text-align: left;\">\n<table style=\"width:950px;\" cellspacing=\"1\" cellpadding=\"10\" border=\"1\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"text-align: left;\" colspan=\"3\">\n\t\t\t<div>Consider the game in the <strong>middle<\/strong> figure where Team A lost, and two different counterfactual games in the figures next to it:<\/div>\n\n\t\t\t<ol>\n\t\t\t\t<li style=\"text-align: justify;\">the <strong>first <\/strong>counterfactual game shows what would have happened had Alex played <span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\"><strong>9<\/strong><\/span><\/span> in <strong>round #1<\/strong> and had Alex&nbsp;played <span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\"><strong>8<\/strong><\/span><\/span> in <strong>round #3<\/strong>.<\/li>\n\t\t\t\t<li style=\"text-align: justify;\">the <strong>second <\/strong>counterfactual game shows what would have happened had AP-5 played <span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\"><strong>1<\/strong><\/span><\/span> in <strong>round #2&nbsp;<\/strong>and had Alex played <span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\"><strong>8<\/strong><\/span><\/span> in <strong>round #3<\/strong>.<\/li>\n\t\t\t<\/ol>\n\n\t\t\t<div style=\"text-align: justify;\">Once you understand what happened in the three games, <strong>please answer the question below<\/strong>.<\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center; width:33%;\">First counterfactual game<br>\n\t\t\t&nbsp; <img width=\"300\" style=\"height: 375px; width: 300px;\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_wYlzNNyXtHaSaMU\" height=\"375\"><\/td>\n\t\t\t<td style=\"text-align: center; width:33%;\">Original game<br>\n\t\t\t&nbsp;<img width=\"300\" style=\"height: 375px; width: 300px;\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_YaC0U1nOAGev6Bz\" height=\"375\"><\/td>\n\t\t\t<td style=\"text-align: center; width:33%;\">Second counterfactual game<br>\n\t\t\t&nbsp;<img width=\"300\" style=\"height: 375px; width: 300px;\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_ni1516rdV9amBDS\" height=\"375\"><\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td colspan=\"3\">\n\t\t\t<div style=\"text-align: center;\"><br>\n\t\t\tRemember,&nbsp;<strong>the players see each others' cards<\/strong>.<\/div>\n\n\t\t\t<div style=\"text-align: center;\">&nbsp;<\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<\/div>\n\n<div style=\"text-align: left;\"><br>\n&nbsp;<\/div>\n<\/div>\n<\/div>\n\n<div style=\"text-align: justify; width:950px;\">To what extent do you think Alex and AP-5 are responsible for their team losing the game? Please indicate the degree of their responsibility by selecting the appropriate choice below:<\/div>\n\n<div>&nbsp;<\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"ChoiceColumnWidthPixels":54,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Tutorial - Evaluation Task \u00a0\u00a0 Great job! You have successfully understood the rules of Goofspiel...","Choices":{"2":{"Display":"Alex"},"3":{"Display":"AP-5"}},"ChoiceOrder":["2","3"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":5,"Answers":{"1":{"Display":"Low Responsibility"},"3":{"Display":"Medium Responsibility"},"4":{"Display":"High Responsibility"}},"AnswerOrder":["1","3","4"],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div style=\"text-align: center;\">\n<div style=\"text-align: center; width:950px;\"><u><strong>Tutorial - Evaluation Task<\/strong><\/u><\/div>\n\n<div>&nbsp;&nbsp;<\/div>\n\n<div>\n<div style=\"text-align: justify; width:950px;\">Great job! You have successfully understood the rules of Goofspiel and counterfactuals. In the remainder of the study we will ask you to&nbsp;evaluate whether Alex and AP-5 have <em><strong>low<\/strong><\/em>, <em><strong>medium<\/strong><\/em>, or <em><strong>high<\/strong><\/em> responsibility for their team losing the game.&nbsp;We will also ask you how confident you are in your response. Below you can see an example of such questions.<\/div>\n\n<div style=\"text-align: left;\">&nbsp;<\/div>\n\n<div style=\"text-align: left;\">\n<table style=\"width:950px;\" cellspacing=\"1\" cellpadding=\"10\" border=\"1\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"text-align: left;\" colspan=\"3\">\n\t\t\t<div>Consider the game in the <strong>middle<\/strong> figure where Team A lost, and two different counterfactual games in the figures next to it:<\/div>\n\n\t\t\t<ol>\n\t\t\t\t<li style=\"text-align: justify;\">the <strong>first <\/strong>counterfactual game shows what would have happened had Alex played <span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\"><strong>9<\/strong><\/span><\/span> in <strong>round #1<\/strong> and had Alex&nbsp;played <span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\"><strong>8<\/strong><\/span><\/span> in <strong>round #3<\/strong>.<\/li>\n\t\t\t\t<li style=\"text-align: justify;\">the <strong>second <\/strong>counterfactual game shows what would have happened had AP-5 played <span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\"><strong>1<\/strong><\/span><\/span> in <strong>round #2&nbsp;<\/strong>and had Alex played <span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\"><strong>8<\/strong><\/span><\/span> in <strong>round #3<\/strong>.<\/li>\n\t\t\t<\/ol>\n\n\t\t\t<div style=\"text-align: justify;\">Once you understand what happened in the three games, <strong>please answer the question below<\/strong>.<\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center; width:33%;\">First counterfactual game<br>\n\t\t\t&nbsp; <img width=\"300\" style=\"height: 375px; width: 300px;\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_wYlzNNyXtHaSaMU\" height=\"375\"><\/td>\n\t\t\t<td style=\"text-align: center; width:33%;\">Original game<br>\n\t\t\t&nbsp;<img width=\"300\" style=\"height: 375px; width: 300px;\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_YaC0U1nOAGev6Bz\" height=\"375\"><\/td>\n\t\t\t<td style=\"text-align: center; width:33%;\">Second counterfactual game<br>\n\t\t\t&nbsp;<img width=\"300\" style=\"height: 375px; width: 300px;\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_ni1516rdV9amBDS\" height=\"375\"><\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td colspan=\"3\">\n\t\t\t<div style=\"text-align: center;\"><br>\n\t\t\tRemember,&nbsp;<strong>the players see each others' cards<\/strong>.<\/div>\n\n\t\t\t<div style=\"text-align: center;\">&nbsp;<\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<\/div>\n\n<div style=\"text-align: left;\"><br>\n&nbsp;<\/div>\n<\/div>\n<\/div>\n\n<div style=\"text-align: justify; width:950px;\">To what extent do you think Alex and AP-5 are responsible for their team losing the game? Please indicate the degree of their responsibility by selecting the appropriate choice below:<\/div>\n\n<div>&nbsp;<\/div>","DataExportTag":"tut-2cfs-full-Q13","QuestionID":"QID1719390380"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390381","SecondaryAttribute":"How confident are you in your response?","TertiaryAttribute":null,"Payload":{"QuestionText":"How confident are you in your response?\n","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How confident are you in your response?","Choices":{"1":{"Display":"Low confidence"},"2":{"Display":"Medium confidence"},"3":{"Display":"High confidence"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"How confident are you in your response?\n","DataExportTag":"tut-2cfs-full-Q14","QuestionID":"QID1719390381"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390382","SecondaryAttribute":"Now that you have completed the tutorial, we ask you to evaluate 5 different games and report you...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: left;\">Now that you have completed the tutorial, we ask you to evaluate 5 different games and report your opinion about the players' degrees of responsibility.&nbsp;We will also ask you how confident you are in your response.&nbsp;<\/div>\n\n<div>\n<table>\n<\/table>\n<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Now that you have completed the tutorial, we ask you to evaluate 5 different games and report you...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: left;\">Now that you have completed the tutorial, we ask you to evaluate 5 different games and report your opinion about the players' degrees of responsibility.&nbsp;We will also ask you how confident you are in your response.&nbsp;<\/div>\n\n<div>\n<table>\n<\/table>\n<\/div>","DataVisibility":{"Private":false,"Hidden":false},"DataExportTag":"tut-2cfs-full-Q15","QuestionID":"QID1719390382"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390383","SecondaryAttribute":"\u200b\u200b\u200b\u200b\u200b Task Description \u00a0 In this study, you will be asked a series of questions about a t","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">\u200b\u200b\u200b\u200b\u200b<\/div>\n\n<div style=\"text-align: center;\"><b><u>Task Description<\/u><\/b><\/div>\n&nbsp;\n\n<div style=\"text-align: justify;\">In this study, you will be asked a series of questions about a team-based card game. Specifically, you will be asked to evaluate the <em><strong>degree of responsibility<\/strong><\/em> exhibited by each player in a team that <strong><em>lost<\/em> <\/strong>in a card game.&nbsp;<br \/>\n<br \/>\nFor this purpose, we will consider a team-based variant of the Goofspiel card game, where two teams, Team A and Team B, compete against each other. Each team consists of a human player and an AI bot.<strong><em> Alex<\/em> <em>(human)<\/em><\/strong><em> <\/em>and <strong><em>AP-5 (AI)<\/em><\/strong><em><strong> <\/strong><\/em>play in <strong><em>Team A<\/em><\/strong>, while <strong><em>Billie<\/em><\/strong> <em><strong>(human) <\/strong><\/em>and <strong><em>BB-8<\/em><\/strong> <em><strong>(AI)<\/strong><\/em> play in <strong><em>Team B<\/em><\/strong>.<br \/>\n<br \/>\nWe will first ask you to complete a <em><strong>tutorial<\/strong><\/em>. This tutorial will have three parts:<\/div>\n\n<ol>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Goofspiel<\/em>: this part explains the rules of the Goofspiel card game.<\/li>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Counterfactuals<\/em>: this part explains counterfactual reasoning in Goofspiel.&nbsp;<\/li>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Evaluation Task<\/em>: this part provides an example of evaluation tasks that you will be asked to solve.<\/li>\n<\/ol>\n\n<div style=\"text-align: justify;\"><br \/>\nAfter completing the tutorial, you will be asked to evaluate 5 games. We will show you 5 Goofspiel games <em><strong>where Team A lost<\/strong><\/em>, and your task is to evaluate to what extent Alex and AP-5 are responsible for this outcome, that is, assess whether they have <strong><em>low<\/em><\/strong>, <strong><em>medium<\/em><\/strong>, or <strong><em>high<\/em><\/strong><strong> <\/strong>responsibility for Team A losing the game.&nbsp;We will also ask you how confident you are in your response.&nbsp;<br \/>\n<br \/>\n<em>Please note that all the games that you will see are illustrative examples, and they were not played by actual human-AI teams.<\/em><\/div>\n\n<div style=\"margin-left: 40px;\"><br type=\"_moz\" \/>\n&nbsp;<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u200b\u200b\u200b\u200b\u200b Task Description \u00a0 In this study, you will be asked a series of questions about a team-base...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\">\u200b\u200b\u200b\u200b\u200b<\/div>\n\n<div style=\"text-align: center;\"><b><u>Task Description<\/u><\/b><\/div>\n&nbsp;\n\n<div style=\"text-align: justify;\">In this study, you will be asked a series of questions about a team-based card game. Specifically, you will be asked to evaluate the <em><strong>degree of responsibility<\/strong><\/em> exhibited by each player in a team that <strong><em>lost<\/em> <\/strong>in a card game.&nbsp;<br \/>\n<br \/>\nFor this purpose, we will consider a team-based variant of the Goofspiel card game, where two teams, Team A and Team B, compete against each other. Each team consists of a human player and an AI bot.<strong><em> Alex<\/em> <em>(human)<\/em><\/strong><em> <\/em>and <strong><em>AP-5 (AI)<\/em><\/strong><em><strong> <\/strong><\/em>play in <strong><em>Team A<\/em><\/strong>, while <strong><em>Billie<\/em><\/strong> <em><strong>(human) <\/strong><\/em>and <strong><em>BB-8<\/em><\/strong> <em><strong>(AI)<\/strong><\/em> play in <strong><em>Team B<\/em><\/strong>.<br \/>\n<br \/>\nWe will first ask you to complete a <em><strong>tutorial<\/strong><\/em>. This tutorial will have three parts:<\/div>\n\n<ol>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Goofspiel<\/em>: this part explains the rules of the Goofspiel card game.<\/li>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Counterfactuals<\/em>: this part explains counterfactual reasoning in Goofspiel.&nbsp;<\/li>\n\t<li style=\"text-align: justify;\"><em>Tutorial - Evaluation Task<\/em>: this part provides an example of evaluation tasks that you will be asked to solve.<\/li>\n<\/ol>\n\n<div style=\"text-align: justify;\"><br \/>\nAfter completing the tutorial, you will be asked to evaluate 5 games. We will show you 5 Goofspiel games <em><strong>where Team A lost<\/strong><\/em>, and your task is to evaluate to what extent Alex and AP-5 are responsible for this outcome, that is, assess whether they have <strong><em>low<\/em><\/strong>, <strong><em>medium<\/em><\/strong>, or <strong><em>high<\/em><\/strong><strong> <\/strong>responsibility for Team A losing the game.&nbsp;We will also ask you how confident you are in your response.&nbsp;<br \/>\n<br \/>\n<em>Please note that all the games that you will see are illustrative examples, and they were not played by actual human-AI teams.<\/em><\/div>\n\n<div style=\"margin-left: 40px;\"><br type=\"_moz\" \/>\n&nbsp;<\/div>","DataExportTag":"tut-2cfs-partial-Q1","QuestionID":"QID1719390383"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390384","SecondaryAttribute":"\u200b\u200b\u200b\u200b\u200bTutorial - Goofspiel \u00a0 To solve your tasks, you need to familiarize yourself with th","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">\u200b\u200b\u200b\u200b\u200b<u><strong>Tutorial - Goofspiel<\/strong><\/u><\/div>\n&nbsp;\n\n<div style=\"text-align: justify;\">To solve your tasks, you need to familiarize yourself with the rules of the team-based version of Goofspiel. The rules are as follows:<\/div>\n\n<ul>\n\t<li style=\"text-align: justify;\">At the beginning of the game, each player receives 5 cards from the standard 52 card deck&nbsp;-&nbsp;<strong>players do not see each others&#39; cards<\/strong>, but they are aware that any given player holds cards of only one suit. Additionally, a separate deck of cards is shuffled, called <em>prize deck<\/em>.&nbsp;<\/li>\n\t<li style=\"text-align: justify;\">The game proceeds in <em>rounds<\/em>. In each round, one prize card is drawn from the prize deck, and upon observing&nbsp;the prize&nbsp;card,&nbsp;the&nbsp;players simultaneously select one card from their hand. The team that plays cards with a higher sum&nbsp;wins the prize card, and the&nbsp;prize is added to the team&#39;s score. If&nbsp;the teams have equal sums, the prize card is discarded and the scores remain the same.<\/li>\n\t<li style=\"text-align: justify;\">The game finishes after round #5, and the team with&nbsp;the highest score wins. If the teams have equal score, then it&#39;s a draw.&nbsp;&nbsp; &nbsp;<\/li>\n<\/ul>\n\n<div>\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" height=\"630\" width=\"723\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>\n\t\t\t<div style=\"text-align: justify;\"><strong>Example 1<\/strong>: We explain how games are represented using the game below.&nbsp;The&nbsp;<em>rounds <\/em>are<em> <\/em>represented as circles: the first round (round #1) is&nbsp;on the outermost circle, while the last round (round #5)&nbsp;is on the innermost circle. The cards that players played in the game are shown in the <span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">grey boxes<\/span><\/span>. The prize cards are shown in the <span style=\"color:#000000;\"><span style=\"background-color:#e6d70b;\">yellow boxes<\/span><\/span>.<\/div>\n\n\t\t\t<div>&nbsp;<\/div>\n\n\t\t\t<div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_V09hm8sOXyz2ztT\" style=\"height: 438px; width: 350px;\" width=\"350\" \/><\/div>\n\n\t\t\t<div>&nbsp;<\/div>\n\n\t\t\t<div style=\"text-align: justify;\">In this example, all players initially received&nbsp;cards 3, 4, 5, 6, and 7 (round #1). Note that in general players do not have to receive the same cards. In the first round (round #1), <span style=\"text-size-adjust: 100%;\">prize card&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#e6d70b;\">3<\/span><\/span><\/strong>&nbsp;was drawn from the prize deck,&nbsp;<\/span>both Alex and AP-5 played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">3<\/span><\/span><\/strong>, Billie played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">4<\/span><\/span><\/strong>, and BB-8 <span style=\"text-size-adjust: 100%;\">played card <\/span><strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">5<\/span><\/span><\/strong><span style=\"text-size-adjust: 100%;\">.&nbsp;<\/span>Team B won the prize card&nbsp;<strong><span style=\"color:#000000;\"><span style=\"text-size-adjust: 100%;\"><span style=\"background-color:#e6d70b;\">3<\/span><\/span><\/span><\/strong>: Team A played cards whose sum is 6, and Team B played cards whose sum is 9.<br \/>\n\t\t\t<br \/>\n\t\t\tTeam A won the prize cards in round #2 and round #4, achieving the score of <strong><span style=\"color:#ffffff;\"><span style=\"background-color:#990033;\">11<\/span><\/span><\/strong>. Team B won all the other prizes, achieving the score of <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#990033;\">14<\/span><\/strong><\/span>. Hence, Team B won the game, which is depicted by the <span style=\"color:#990033;\"><strong>red scoreboard<\/strong><\/span>.<\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<\/div>\n\n<p align=\"justify\" dir=\"ltr\"><br \/>\nNow that you are familiar with the rules of Goofspiel and the game representation, we ask you to answer the questions below.&nbsp;&nbsp;<br \/>\n&nbsp;<\/p>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u200b\u200b\u200b\u200b\u200bTutorial - Goofspiel \u00a0 To solve your tasks, you need to familiarize yourself with the rules...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\">\u200b\u200b\u200b\u200b\u200b<u><strong>Tutorial - Goofspiel<\/strong><\/u><\/div>\n&nbsp;\n\n<div style=\"text-align: justify;\">To solve your tasks, you need to familiarize yourself with the rules of the team-based version of Goofspiel. The rules are as follows:<\/div>\n\n<ul>\n\t<li style=\"text-align: justify;\">At the beginning of the game, each player receives 5 cards from the standard 52 card deck&nbsp;-&nbsp;<strong>players do not see each others&#39; cards<\/strong>, but they are aware that any given player holds cards of only one suit. Additionally, a separate deck of cards is shuffled, called <em>prize deck<\/em>.&nbsp;<\/li>\n\t<li style=\"text-align: justify;\">The game proceeds in <em>rounds<\/em>. In each round, one prize card is drawn from the prize deck, and upon observing&nbsp;the prize&nbsp;card,&nbsp;the&nbsp;players simultaneously select one card from their hand. The team that plays cards with a higher sum&nbsp;wins the prize card, and the&nbsp;prize is added to the team&#39;s score. If&nbsp;the teams have equal sums, the prize card is discarded and the scores remain the same.<\/li>\n\t<li style=\"text-align: justify;\">The game finishes after round #5, and the team with&nbsp;the highest score wins. If the teams have equal score, then it&#39;s a draw.&nbsp;&nbsp; &nbsp;<\/li>\n<\/ul>\n\n<div>\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" height=\"630\" width=\"723\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>\n\t\t\t<div style=\"text-align: justify;\"><strong>Example 1<\/strong>: We explain how games are represented using the game below.&nbsp;The&nbsp;<em>rounds <\/em>are<em> <\/em>represented as circles: the first round (round #1) is&nbsp;on the outermost circle, while the last round (round #5)&nbsp;is on the innermost circle. The cards that players played in the game are shown in the <span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">grey boxes<\/span><\/span>. The prize cards are shown in the <span style=\"color:#000000;\"><span style=\"background-color:#e6d70b;\">yellow boxes<\/span><\/span>.<\/div>\n\n\t\t\t<div>&nbsp;<\/div>\n\n\t\t\t<div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_V09hm8sOXyz2ztT\" style=\"height: 438px; width: 350px;\" width=\"350\" \/><\/div>\n\n\t\t\t<div>&nbsp;<\/div>\n\n\t\t\t<div style=\"text-align: justify;\">In this example, all players initially received&nbsp;cards 3, 4, 5, 6, and 7 (round #1). Note that in general players do not have to receive the same cards. In the first round (round #1), <span style=\"text-size-adjust: 100%;\">prize card&nbsp;<strong><span style=\"color:#000000;\"><span style=\"background-color:#e6d70b;\">3<\/span><\/span><\/strong>&nbsp;was drawn from the prize deck,&nbsp;<\/span>both Alex and AP-5 played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">3<\/span><\/span><\/strong>, Billie played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">4<\/span><\/span><\/strong>, and BB-8 <span style=\"text-size-adjust: 100%;\">played card <\/span><strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">5<\/span><\/span><\/strong><span style=\"text-size-adjust: 100%;\">.&nbsp;<\/span>Team B won the prize card&nbsp;<strong><span style=\"color:#000000;\"><span style=\"text-size-adjust: 100%;\"><span style=\"background-color:#e6d70b;\">3<\/span><\/span><\/span><\/strong>: Team A played cards whose sum is 6, and Team B played cards whose sum is 9.<br \/>\n\t\t\t<br \/>\n\t\t\tTeam A won the prize cards in round #2 and round #4, achieving the score of <strong><span style=\"color:#ffffff;\"><span style=\"background-color:#990033;\">11<\/span><\/span><\/strong>. Team B won all the other prizes, achieving the score of <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#990033;\">14<\/span><\/strong><\/span>. Hence, Team B won the game, which is depicted by the <span style=\"color:#990033;\"><strong>red scoreboard<\/strong><\/span>.<\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<\/div>\n\n<p align=\"justify\" dir=\"ltr\"><br \/>\nNow that you are familiar with the rules of Goofspiel and the game representation, we ask you to answer the questions below.&nbsp;&nbsp;<br \/>\n&nbsp;<\/p>","DataExportTag":"tut-2cfs-partial-Q2 ","QuestionID":"QID1719390384"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390385","SecondaryAttribute":"In Example 1, what card did AP-5 play in round #2?\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"In Example 1, what card did <strong>AP-5<\/strong> play in <strong>round #2<\/strong>?&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In Example 1, what card did AP-5 play in round #2?\u00a0","Choices":{"4":{"Display":"3"},"5":{"Display":"4"},"6":{"Display":"5"},"7":{"Display":"6"},"10":{"Display":"7"}},"ChoiceOrder":["4","5","6","7","10"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390385\/SelectableChoice\/10","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In Example 1, what card did AP-5 play in round #2?&nbsp;<\/span> <span class=\"LeftOpDesc\">7<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390385\/SelectableChoice\/10","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390385","QuestionIDFromLocator":"QID1719390385","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":13,"NextAnswerId":1,"SubSelector":"TX","QuestionText_Unsafe":"In Example 1, what card did <strong>AP-5<\/strong> play in <strong>round #2<\/strong>?&nbsp;","DataExportTag":"tut-2cfs-partial-Q3 ","QuestionID":"QID1719390385"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390386","SecondaryAttribute":"In Example 1, what was the prize in round #3?","TertiaryAttribute":null,"Payload":{"QuestionText":"In Example 1, what was the prize in <strong>round #3<\/strong>?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In Example 1, what was the prize in round #3?","Choices":{"4":{"Display":"3"},"5":{"Display":"4"},"6":{"Display":"5"},"7":{"Display":"6"},"8":{"Display":"7"}},"ChoiceOrder":["4","5","6","7","8"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390386\/SelectableChoice\/8","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In Example 1, what was the prize in round #3?<\/span> <span class=\"LeftOpDesc\">7<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390386\/SelectableChoice\/8","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390386","QuestionIDFromLocator":"QID1719390386","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":1,"QuestionText_Unsafe":"In Example 1, what was the prize in <strong>round #3<\/strong>?","DataExportTag":"tut-2cfs-partial-Q4 ","QuestionID":"QID1719390386"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390387","SecondaryAttribute":"In Example 1, which team won the prize in round #4?","TertiaryAttribute":null,"Payload":{"QuestionText":"In Example 1, which team won the prize in <strong>round #4<\/strong>?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In Example 1, which team won the prize in round #4?","Choices":{"4":{"Display":"Team A"},"5":{"Display":"Team B"}},"ChoiceOrder":["4","5"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390387\/SelectableChoice\/4","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In Example 1, which team won the prize in round #4?<\/span> <span class=\"LeftOpDesc\">Team A<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390387\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390387","QuestionIDFromLocator":"QID1719390387","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":5,"QuestionText_Unsafe":"In Example 1, which team won the prize in <strong>round #4<\/strong>?","DataExportTag":"tut-2cfs-partial-Q5 ","QuestionID":"QID1719390387"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390388","SecondaryAttribute":"Tutorial - Counterfactuals \u00a0\u00a0 To solve your tasks, you also need to familiarize yourself with cou.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"display: block;>\n\n<p style=\" dir=\"ltr\">\n<div style=\"text-align: center; width:875px;\"><u><strong>Tutorial - Counterfactuals<\/strong><\/u><\/div>\n\n<p>&nbsp;&nbsp;<\/p>\n\n<p style=\"width:875px;\" dir=\"ltr\" align=\"justify\">To solve your tasks, you also need to familiarize yourself with <em>counterfactuals<\/em>.&nbsp;In this task, <em><strong>counterfactual games<\/strong><\/em> show what would have happened had the players played their cards differently. We continue with the previous example to explain counterfactual games.<\/p>\n\n<p dir=\"ltr\">&nbsp;<\/p>\n\n<table style=\"width:875px;\" cellspacing=\"1\" cellpadding=\"10\" border=\"1\">\n <tbody>\n  <tr>\n   <td colspan=\"2\">\n   <p dir=\"ltr\" align=\"justify\"><strong>Example 1 (continued)<\/strong>: We have seen that in this example Team A lost (<em>the left figure below<\/em>). However, consider the following question:&nbsp;<br>\n   &nbsp;<\/p>\n\n   <p style=\"text-align: center;\" dir=\"ltr\"><em>What would have happened had AP-5 played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong><em> in<\/em><em><strong> round #2<\/strong>?<\/em><br>\n   &nbsp;<\/p>\n\n   <p dir=\"ltr\" align=\"justify\">Clearly, nothing would have changed in <em>round #1<\/em>. However, the <strong>cards<\/strong> the players would have played in <strong>round&nbsp;#3<\/strong>, <strong>round #4<\/strong>, and <strong>round #5<\/strong>, can be <strong>different from<\/strong> those that are originally played. The <strong>right figure<\/strong> below shows a <strong>counterfactual game<\/strong>. The differences compared to the original game in the left figure are:<\/p>\n\n   <ul dir=\"ltr\">\n    <li style=\"text-align: justify;\">In <em>round #2<\/em>, we imagine that AP-5 had played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong> instead of card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">7<\/span><\/span><\/strong>.<\/li>\n    <li style=\"text-align: justify;\">In <em>round&nbsp;#3<\/em>, <em>round #4<\/em>, and <em>round&nbsp;#5<\/em>, we imagine that all the players had responded to this change and had played cards in<strong> <\/strong><span style=\"color:#000000;\"><span style=\"background-color:#ffb38a;\">light orange<\/span><\/span><strong><span style=\"color:#d55e00;\"> <\/span><\/strong>boxes<span style=\"color:#000000;\">.<\/span><strong> <\/strong><\/li>\n    <li style=\"text-align: justify;\">Team A wins the counterfactual game, which is depicted by the <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#009e73;\">green scoreboard<\/span><\/strong><\/span><span style=\"color:#000000;\">.<\/span><\/li>\n   <\/ul>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center;\">The original game in Example 1<br>\n   &nbsp; &nbsp;<br>\n   &nbsp;<img width=\"350\" style=\"height: 438px; width: 350px;\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_V09hm8sOXyz2ztT\" height=\"438\"><\/td>\n   <td style=\"text-align: center;\">Counterfactual game<br>\n   (had AP-5 played <span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span> in round #2)<br>\n   &nbsp;<img width=\"350\" style=\"height: 438px; width: 350px;\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_dV6DprmriLkQHjO\" height=\"438\"><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n\n<div style=\"width: 100%; text-align: justify; width:875px;\"><br>\nNow that you are familiar with counterfactual games, we ask you to take a look at <em>another example<\/em>, and answer the questions below.&nbsp;<br>\n&nbsp;\n<table style=\"width:875px;\" cellspacing=\"1\" cellpadding=\"10\" border=\"1\">\n <tbody>\n  <tr>\n   <td colspan=\"2\">\n   <p dir=\"ltr\" align=\"justify\"><strong>Example 2<\/strong>: Please take a look at another game below, and one of its counterfactual games. Once you understand what happened in the counterfactual game, <strong>please answer the questions below<\/strong>.<\/p>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center;\">The original game in Example 2<br>\n   <br>\n   &nbsp;<img width=\"350\" style=\"height: 438px; width: 350px;\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_a2dMvQ2XadjTSjP\" height=\"438\"><\/td>\n   <td style=\"text-align: center;\"><span style=\"text-align: center;\">Counterfactual game<br>\n   (had&nbsp;AP-5&nbsp;played <\/span><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><span style=\"text-align: center;\"> in round #1)<\/span><br>\n   &nbsp;<img width=\"350\" style=\"height: 438px; width: 350px;\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_EPbO6FaRLMnfwWn\" height=\"438\"><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n<\/div>\n<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Tutorial - Counterfactuals \u00a0\u00a0 To solve your tasks, you also need to familiarize yourself with cou...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"display: block;>\n\n<p style=\" dir=\"ltr\">\n<div style=\"text-align: center; width:875px;\"><u><strong>Tutorial - Counterfactuals<\/strong><\/u><\/div>\n\n<p>&nbsp;&nbsp;<\/p>\n\n<p style=\"width:875px;\" dir=\"ltr\" align=\"justify\">To solve your tasks, you also need to familiarize yourself with <em>counterfactuals<\/em>.&nbsp;In this task, <em><strong>counterfactual games<\/strong><\/em> show what would have happened had the players played their cards differently. We continue with the previous example to explain counterfactual games.<\/p>\n\n<p dir=\"ltr\">&nbsp;<\/p>\n\n<table style=\"width:875px;\" cellspacing=\"1\" cellpadding=\"10\" border=\"1\">\n <tbody>\n  <tr>\n   <td colspan=\"2\">\n   <p dir=\"ltr\" align=\"justify\"><strong>Example 1 (continued)<\/strong>: We have seen that in this example Team A lost (<em>the left figure below<\/em>). However, consider the following question:&nbsp;<br>\n   &nbsp;<\/p>\n\n   <p style=\"text-align: center;\" dir=\"ltr\"><em>What would have happened had AP-5 played card <\/em><strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong><em> in<\/em><em><strong> round #2<\/strong>?<\/em><br>\n   &nbsp;<\/p>\n\n   <p dir=\"ltr\" align=\"justify\">Clearly, nothing would have changed in <em>round #1<\/em>. However, the <strong>cards<\/strong> the players would have played in <strong>round&nbsp;#3<\/strong>, <strong>round #4<\/strong>, and <strong>round #5<\/strong>, can be <strong>different from<\/strong> those that are originally played. The <strong>right figure<\/strong> below shows a <strong>counterfactual game<\/strong>. The differences compared to the original game in the left figure are:<\/p>\n\n   <ul dir=\"ltr\">\n    <li style=\"text-align: justify;\">In <em>round #2<\/em>, we imagine that AP-5 had played card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong> instead of card <strong><span style=\"color:#000000;\"><span style=\"background-color:#a6a6a6;\">7<\/span><\/span><\/strong>.<\/li>\n    <li style=\"text-align: justify;\">In <em>round&nbsp;#3<\/em>, <em>round #4<\/em>, and <em>round&nbsp;#5<\/em>, we imagine that all the players had responded to this change and had played cards in<strong> <\/strong><span style=\"color:#000000;\"><span style=\"background-color:#ffb38a;\">light orange<\/span><\/span><strong><span style=\"color:#d55e00;\"> <\/span><\/strong>boxes<span style=\"color:#000000;\">.<\/span><strong> <\/strong><\/li>\n    <li style=\"text-align: justify;\">Team A wins the counterfactual game, which is depicted by the <span style=\"color:#ffffff;\"><strong><span style=\"background-color:#009e73;\">green scoreboard<\/span><\/strong><\/span><span style=\"color:#000000;\">.<\/span><\/li>\n   <\/ul>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center;\">The original game in Example 1<br>\n   &nbsp; &nbsp;<br>\n   &nbsp;<img width=\"350\" style=\"height: 438px; width: 350px;\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_V09hm8sOXyz2ztT\" height=\"438\"><\/td>\n   <td style=\"text-align: center;\">Counterfactual game<br>\n   (had AP-5 played <span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span> in round #2)<br>\n   &nbsp;<img width=\"350\" style=\"height: 438px; width: 350px;\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_dV6DprmriLkQHjO\" height=\"438\"><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n\n<div style=\"width: 100%; text-align: justify; width:875px;\"><br>\nNow that you are familiar with counterfactual games, we ask you to take a look at <em>another example<\/em>, and answer the questions below.&nbsp;<br>\n&nbsp;\n<table style=\"width:875px;\" cellspacing=\"1\" cellpadding=\"10\" border=\"1\">\n <tbody>\n  <tr>\n   <td colspan=\"2\">\n   <p dir=\"ltr\" align=\"justify\"><strong>Example 2<\/strong>: Please take a look at another game below, and one of its counterfactual games. Once you understand what happened in the counterfactual game, <strong>please answer the questions below<\/strong>.<\/p>\n   <\/td>\n  <\/tr>\n  <tr>\n   <td style=\"text-align: center;\">The original game in Example 2<br>\n   <br>\n   &nbsp;<img width=\"350\" style=\"height: 438px; width: 350px;\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_a2dMvQ2XadjTSjP\" height=\"438\"><\/td>\n   <td style=\"text-align: center;\"><span style=\"text-align: center;\">Counterfactual game<br>\n   (had&nbsp;AP-5&nbsp;played <\/span><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><span style=\"text-align: center;\"> in round #1)<\/span><br>\n   &nbsp;<img width=\"350\" style=\"height: 438px; width: 350px;\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_EPbO6FaRLMnfwWn\" height=\"438\"><\/td>\n  <\/tr>\n <\/tbody>\n<\/table>\n<\/div>\n<\/div>","DataExportTag":"tut-2cfs-partial-Q6 ","QuestionID":"QID1719390388"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390389","SecondaryAttribute":"In the counterfactual game\u00a0in Example 2, what card did AP-5\u00a0play in round #1?","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: justify; width:875px;\">In the <strong>counterfactual game<\/strong>&nbsp;in Example 2, what card did <strong>AP-5<\/strong>&nbsp;play in <strong>round #1<\/strong>?<\/div>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In the counterfactual game\u00a0in Example 2, what card did AP-5\u00a0play in round #1?","Choices":{"4":{"Display":"3"},"5":{"Display":"4"},"6":{"Display":"5"},"7":{"Display":"6"},"8":{"Display":"7"}},"ChoiceOrder":["4","5","6","7","8"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390389\/