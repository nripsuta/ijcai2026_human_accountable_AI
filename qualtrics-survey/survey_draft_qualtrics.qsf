 prize in round #4?","TertiaryAttribute":null,"Payload":{"QuestionText":"In Example 1, which team won the prize in <strong>round #4<\/strong>?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In Example 1, which team won the prize in round #4?","Choices":{"4":{"Display":"Team A"},"5":{"Display":"Team B"}},"ChoiceOrder":["4","5"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1719390418\/SelectableChoice\/4","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">In Example 1, which team won the prize in round #4?<\/span> <span class=\"LeftOpDesc\">Team A<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1719390418\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID1719390418","QuestionIDFromLocator":"QID1719390418","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"IncorrectAnswer","libraryID":"UR_RlLMb9WtlAwpgoj","messageID":"MS_ykqhm1wj3arSHtE","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":5,"QuestionText_Unsafe":"In Example 1, which team won the prize in <strong>round #4<\/strong>?","DataExportTag":"tut-fact-partial-Q5","QuestionID":"QID1719390418"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390419","SecondaryAttribute":"Tutorial - Evaluation Task \u00a0 Great job! You have successfully understood the rules of Goofspiel....","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center; width:850px;\"><u><strong>Tutorial - Evaluation Task<\/strong><\/u><\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width:850px;\">Great job! You have successfully understood the rules of Goofspiel. In the remainder of the study, we will ask you to evaluate whether Alex and AP-5 have low, medium, or high responsibility for their team losing the game, and how confident you are in your response. Below you can see an example of such questions.<\/div>\n\n<div style=\"text-align: justify; width:850px;\">&nbsp;<\/div>\n\n<div>\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:850px;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>\n\t\t\t<div style=\"text-align: justify;\">Consider the following game where <strong>Team A lost<\/strong>. Once you understand what happened in the game, <strong>please answer the question below<\/strong>.<br \/>\n\t\t\t&nbsp; &nbsp; &nbsp;<\/div>\n\n\t\t\t<div style=\"text-align: center;\"><img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_qxdWFRM4vAALojh\" style=\"height: 438px; width: 350px;\" width=\"350\" \/><\/div>\n\n\t\t\t<div style=\"text-align: center;\">&nbsp;<\/div>\n\n\t\t\t<div style=\"text-align: center;\">Remember, while we can see all the cards,&nbsp;<strong>the players can&#39;t see each others&#39; cards<\/strong>.<\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width:850px;\">To what extent do you think Alex and AP-5 are responsible for their team losing the game? Please indicate the&nbsp;degree of their responsibility by selecting the appropriate choice below:<span style=\"text-align: center;\"> <\/span><\/div>\n\n<div>&nbsp;<\/div>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function ()\n{\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"ChoiceColumnWidthPixels":52,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Tutorial - Evaluation Task \u00a0 Great job! You have successfully understood the rules of Goofspiel....","Choices":{"7":{"Display":"Alex"},"8":{"Display":"AP-5"}},"ChoiceOrder":["7","8"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":5,"Answers":{"1":{"Display":"Low Responsibility"},"3":{"Display":"Medium Responsibility"},"4":{"Display":"High Responsibility"}},"AnswerOrder":["1","3","4"],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div style=\"text-align: center; width:850px;\"><u><strong>Tutorial - Evaluation Task<\/strong><\/u><\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width:850px;\">Great job! You have successfully understood the rules of Goofspiel. In the remainder of the study, we will ask you to evaluate whether Alex and AP-5 have low, medium, or high responsibility for their team losing the game, and how confident you are in your response. Below you can see an example of such questions.<\/div>\n\n<div style=\"text-align: justify; width:850px;\">&nbsp;<\/div>\n\n<div>\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:850px;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>\n\t\t\t<div style=\"text-align: justify;\">Consider the following game where <strong>Team A lost<\/strong>. Once you understand what happened in the game, <strong>please answer the question below<\/strong>.<br \/>\n\t\t\t&nbsp; &nbsp; &nbsp;<\/div>\n\n\t\t\t<div style=\"text-align: center;\"><img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_qxdWFRM4vAALojh\" style=\"height: 438px; width: 350px;\" width=\"350\" \/><\/div>\n\n\t\t\t<div style=\"text-align: center;\">&nbsp;<\/div>\n\n\t\t\t<div style=\"text-align: center;\">Remember, while we can see all the cards,&nbsp;<strong>the players can&#39;t see each others&#39; cards<\/strong>.<\/div>\n\t\t\t<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width:850px;\">To what extent do you think Alex and AP-5 are responsible for their team losing the game? Please indicate the&nbsp;degree of their responsibility by selecting the appropriate choice below:<span style=\"text-align: center;\"> <\/span><\/div>\n\n<div>&nbsp;<\/div>","DataExportTag":"tut-fact-partial-Q6","QuestionID":"QID1719390419"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390420","SecondaryAttribute":"How confident are you in your response?","TertiaryAttribute":null,"Payload":{"QuestionText":"How confident are you in your response?\n","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How confident are you in your response?","Choices":{"1":{"Display":"Low confidence"},"2":{"Display":"Medium confidence"},"3":{"Display":"High confidence"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"How confident are you in your response?\n","DataExportTag":"tut-fact-partial-Q7","QuestionID":"QID1719390420"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1719390421","SecondaryAttribute":"Now that you have completed the tutorial, we ask you to evaluate 5 different games and report you...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: justify;  width:850px;\">Now that you have completed the tutorial, we ask you to evaluate 5 different games and report your opinion about the players' degrees of responsibility.&nbsp;We will also ask you how confident you are in your response. \n<\/div>\n\n<div>\n<table>\n<\/table>\n<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Now that you have completed the tutorial, we ask you to evaluate 5 different games and report you...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: justify;  width:850px;\">Now that you have completed the tutorial, we ask you to evaluate 5 different games and report your opinion about the players' degrees of responsibility.&nbsp;We will also ask you how confident you are in your response. \n<\/div>\n\n<div>\n<table>\n<\/table>\n<\/div>","DataVisibility":{"Private":false,"Hidden":false},"DataExportTag":"tut-fact-partial-Q8","QuestionID":"QID1719390421"}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID172","SecondaryAttribute":"Evaluation Task \u00a0 Your task is to evaluate whether Alex and AP-5 have low, medium, or high respon..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center; width: 875px;\"><u><strong>Evaluation Task<\/strong><\/u><\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">Your task is to evaluate whether Alex and AP-5 have <em><strong>low<\/strong><\/em>, <em><strong>medium<\/strong><\/em>, or <em><strong>high<\/strong><\/em> responsibility for their team losing the game.<\/div>\n\n<div>&nbsp;\n<table border=\"1\" cellpadding=\"10\" cellspacing=\"1\" style=\"width:875px;\">\n<tbody>\n<tr>\n<td colspan=\"2\">\n<div style=\"text-align: justify;\">Consider the game in the left figure where Team A lost, and the counterfactual game in the right figure which shows what would have happened had Alex played <strong><span style=\"color:#000000;\"><span style=\"background-color:#a8e68d;\">4<\/span><\/span><\/strong> in <strong>round #3<\/strong>&nbsp;and had AP-5 played <strong><span style=\"color:#000000;\"><span style=\"background-color:#0fa65e;\">2<\/span><\/span><\/strong> in <strong>round #4<\/strong>. Once you understand what happened in the two games, <strong>please answer the question below<\/strong>.<\/div>\n<\/td>\n<\/tr>\n<tr>\n<td>\n<div style=\"text-align: center;\">Original game<\/div>\n\n<div style=\"text-align: center;\"><img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_VZ7nfuBdMP7ItLs\" style=\"width: 350px; height: 438px;\" width=\"350\" \/>&nbsp;<\/div>\n<\/td>\n<td>\n<div style=\"text-align: center;\">Counterfactual game<\/div>\n\n<div style=\"text-align: center;\">&nbsp;&nbsp;<img height=\"438\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_zuNSA5BxGSXcs4M\" style=\"width: 350px; height: 438px;\" width=\"350\" \/><\/div>\n<\/td>\n<\/tr>\n<tr>\n<td colspan=\"2\" style=\"text-align: center;\"><br \/>\nRemember, while we can see all the cards,&nbsp;<strong>the players do not see each others&#39; cards<\/strong>.<br \/>\n&nbsp;<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: justify; width: 875px;\">To what extent do you think Alex and AP-5 are responsible for their team losing the game? Please indicate the degree of their responsibility by selecting the appropriate choice below:<\/div>\n\n<div>&nbsp;<\/div>\n\n","DataExportTag":"CF-A0-P-B1-TRxCH-292","QuestionID":"QID172","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","QuestionDescription":"Evaluation Task \u00a0 Your task is to evaluate whether Alex and AP-5 have low, medium, or high respon...","Choices":{"1":{"Display":"Alex"},"2":{"Display":"AP-5"}},"ChoiceOrder":["1","2"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"Answers":{"1":{"Display":"Low Responsibility"},"2":{"Display":"Medium Responsibility"},"3":{"Display":"High Responsibility"}},"AnswerOrder":["1","2","3"],"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"NextChoiceId":3,"NextAnswerId":4,"ChoiceDataExportTags":false}},{"SurveyID":"SV_7PBUtX8e4Bhl1DU","Element":"SQ","PrimaryAttribute":"QID1720","SecondaryAttribute":"Evaluation Task Your task is to evaluate whether Alex and AP-5 have low, medium, or high responsi...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center; width: 875px;\"><u><strong>Evaluation Task<\/strong><\/u><\/div>\n\n<div style=\"text-align: justify; width: 875px;\"><br>\nYour task is to evaluate whether Alex and AP-5 have <strong><em>low<\/em><\/strong>, <em><strong>medium<\/strong><\/em>, or <em><strong>high<\/strong><\/em> responsibility for their team losing the game.&nbsp;FFUL-bias0-TRxCH-1<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>\n<div style=\"text-align: justify; width: 875px;\">Consider the following game where <strong>Team A lost<\/strong>. Once you understand what happened in the game, <strong>please answer the question below<\/strong>.&nbsp;<\/div>\n\n<div style=\"text-align: left;\">&nbsp;<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"text-align: center; width: 875px;\">&nbsp;<img width=\"350\" style=\"height: 438px; width: 350px;\" src=\"https:\/\/usc.qualtrics.com\/CP\/Graphic.php?IM=IM_JZQbmkYOdvdfNwT\" height=\"438\"><\/div>\n\n<div style=\"text-align: center; width: 875px;\">&nbsp;<\/div>\n\n<div style=\"text-align: center; width: 875px;\">Remember,&nbsp;<strong>the players see each others' cards<\/strong>.<\/div>\n\n<div style=\"text-align: center; width: 875px;\">&nbsp;<\/d